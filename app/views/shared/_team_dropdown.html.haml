- company = organization.root_company || organization
- teams = company ? Team.for_company(company).active.includes(:department).ordered.to_a : []
- exclude_ids = exclude_ids || []
- teams = teams.reject { |team| exclude_ids.include?(team.id) }
- default_selected_id = selected_team_id || ""
- team_help_text = local_assigns[:help_text]
- team_help_text = "The primary team this seat will live on should live within the same department as the title" if team_help_text.nil?
.mb-3
  = form.label field_name, label_text, class: "form-label"
  = form.select field_name,
                teams_grouped_options_for_select(teams, default_selected_id),
                include_blank ? { include_blank: "No Team" } : {},
                { class: "form-select" }
  - if team_help_text.present?
    %small.form-text.text-muted= team_help_text
