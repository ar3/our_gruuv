-# locals: stats (Hash), variant (:compact for Start Here, :full for Goals Health page)
- variant = local_assigns.fetch(:variant, :compact).to_sym
- full = variant == :full
- wrapper_class = full ? "goals-health-spotlight-compact goals-health-spotlight-full" : "goals-health-spotlight-compact"
%div{class: wrapper_class}
  - if full
    .row.text-center.align-items-end.g-3
      .col-6.col-md-3
        .h3.text-primary.mb-0= stats[:total_employees]
        %small.text-muted Total Active Employees
      .col-6.col-md-3
        .h3.text-success.mb-0= stats[:healthy_count]
        %small.text-muted Healthy
      .col-6.col-md-3
        .h3.text-warning.mb-0= stats[:ok_count]
        %small.text-muted Warning
      .col-6.col-md-3
        .h3.text-danger.mb-0= stats[:concerning_count]
        %small.text-muted Needs Attention
  - else
    .row.text-center.g-1.gx-0
      .col-12
        .fw-semibold.text-primary.small.lh-sm= stats[:total_employees]
        %div.text-muted{style: "font-size: 0.65rem; line-height: 1.15;"} Total Active Employees
    .row.text-center.g-1.gx-0.mt-1
      .col-4
        .fw-semibold.text-success.small.lh-sm= stats[:healthy_count]
        %div.text-muted{style: "font-size: 0.65rem; line-height: 1.15;"} Healthy
      .col-4
        .fw-semibold.text-warning.small.lh-sm= stats[:ok_count]
        %div.text-muted{style: "font-size: 0.65rem; line-height: 1.15;"} Warning
      .col-4
        .fw-semibold.text-danger.small.lh-sm= stats[:concerning_count]
        %div.text-muted{style: "font-size: 0.65rem; line-height: 1.15;"} Needs Attention
