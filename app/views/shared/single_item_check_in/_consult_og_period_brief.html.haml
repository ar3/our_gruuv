-# Locals: organization, teammate, check_in, check_in_kind ("assignment"|"aspiration"|"position"), consult (optional)
-# Lives in the perspective callout above the check-in form (not inside the form).
- organization = local_assigns.fetch(:organization)
- teammate = local_assigns.fetch(:teammate)
- check_in = local_assigns.fetch(:check_in)
- check_in_kind = local_assigns.fetch(:check_in_kind)
- consult = local_assigns[:consult]
- has_consult = consult.present?
- in_flight = consult&.in_flight?
- completed = consult&.status == "completed"
- failed = consult&.status == "failed"
- result = consult&.result if consult&.result.is_a?(CheckInPeriodBriefResult)
- open = in_flight || completed || failed || params[:period_brief].present?
- create_path = organization_teammate_check_in_period_brief_consult_path(organization, teammate)
- status_path = organization_teammate_check_in_period_brief_consult_path(organization, teammate, check_in_kind: check_in_kind, check_in_id: check_in.id, format: :json)
- summarize_link_label = check_in_period_brief_summarize_link_label(teammate: teammate, check_in: check_in, check_in_kind: check_in_kind)
- link_label = has_consult ? "Consult OG again" : summarize_link_label
- csrf_token = form_authenticity_token
- completed_at_display = completed ? format_time_in_user_timezone(consult.completed_at || consult.created_at, format: "%B %-d, %Y %-l:%M %p") : nil

.mt-3.pt-3.border-top{ data: { controller: "check-in-period-brief-consult", check_in_period_brief_consult_open_value: open, check_in_period_brief_consult_has_consult_value: has_consult, check_in_period_brief_consult_summarize_label_value: summarize_link_label, check_in_period_brief_consult_create_url_value: create_path, check_in_period_brief_consult_status_url_value: status_path, check_in_period_brief_consult_check_in_kind_value: check_in_kind, check_in_period_brief_consult_check_in_id_value: check_in.id, check_in_period_brief_consult_csrf_token_value: csrf_token, check_in_period_brief_consult_auto_poll_value: in_flight } }
  .d-flex.align-items-baseline.justify-content-end
    %a.small.text-decoration-none.text-end{ href: "#", data: { action: "check-in-period-brief-consult#linkClick", check_in_period_brief_consult_target: "link" } }
      %i.bi.bi-stars.me-1
      %span{ data: { check_in_period_brief_consult_target: "linkLabel" } }
        = link_label

  .mt-2.border.rounded.p-3.bg-light{ class: ("d-none" unless open), data: { check_in_period_brief_consult_target: "panel" } }
    %p.small.text-muted.mb-2
      OG summarizes viewer-visible context for this check-in period into a brief you can copy into Notes.
      OG recommends copying and pasting the content into the notes area. OG never recommends a rating.

    .alert.alert-secondary.mb-2{ class: ("d-none" unless in_flight), data: { check_in_period_brief_consult_target: "waiting" } }
      %i.bi.bi-hourglass-split.me-2
      %span{ data: { check_in_period_brief_consult_target: "waitingText" } }
        Period brief is #{consult&.status || "pending"}…
      %span.ms-1.text-muted{ data: { check_in_period_brief_consult_target: "elapsed" } }

    .alert.alert-danger.py-2.small.mb-2{ class: ("d-none" unless failed), data: { check_in_period_brief_consult_target: "error" } }
      %span{ data: { check_in_period_brief_consult_target: "errorText" } }
        - if failed
          Consultation failed#{consult.error_message.present? ? ": #{consult.error_message}" : "."}

    .mb-0{ class: ("d-none" unless completed && result), data: { check_in_period_brief_consult_target: "results" } }
      %p.small.text-muted.mb-1
        Brief run
        %span{ data: { check_in_period_brief_consult_target: "completedAt" } }= completed_at_display
      .border.rounded.p-2.bg-white.small.mb-2{ data: { check_in_period_brief_consult_target: "copySource" }, style: "white-space: pre-wrap;" }
        - if completed && result
          = result.copy_text

    .d-flex.align-items-center.justify-content-between.gap-2.flex-wrap{ class: ("d-none" unless completed || failed), data: { check_in_period_brief_consult_target: "actions" } }
      .d-flex.align-items-center.gap-2{ class: ("d-none" unless completed && result), data: { check_in_period_brief_consult_target: "copyActions" } }
        %button.btn.btn-sm.btn-outline-secondary{ type: "button", data: { action: "check-in-period-brief-consult#copy", check_in_period_brief_consult_target: "copyButton" } }
          %i.bi.bi-clipboard.me-1
          Copy brief
        %span.small.text-success.d-none{ data: { check_in_period_brief_consult_target: "copyFeedback" } } Copied
      %button.btn.btn-sm.btn-outline-primary.ms-auto{ type: "button", data: { action: "check-in-period-brief-consult#rerun", check_in_period_brief_consult_target: "rerunButton" } }
        Re-Run Consultation
