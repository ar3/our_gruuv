- chart_title_period = local_assigns.fetch(:chart_title_period)
- goals_chart_data = local_assigns.fetch(:goals_chart_data)
- second_chart_data = local_assigns[:second_chart_data] || { categories: [], series: [] }
- first_chart_dom_id = local_assigns.fetch(:first_chart_dom_id)
- second_chart_dom_id = local_assigns.fetch(:second_chart_dom_id)
- second_card_heading = local_assigns[:second_card_heading] || ''
- second_y_axis_title = local_assigns[:second_y_axis_title] || 'Count'
- second_highcharts_title = local_assigns[:second_highcharts_title] || ''
- wrap_class = local_assigns[:wrap_class] || 'container-fluid'
- second_header_icon = local_assigns[:second_header_icon] || 'bi-bullseye'
- hide_second_chart = local_assigns[:hide_second_chart] || false
- charts_after_first = local_assigns[:charts_after_first] || []
- charts_after_second = local_assigns[:charts_after_second] || []
- goals_for_network_graph = local_assigns[:goals_for_network_graph]
- goal_links_for_network_graph = local_assigns[:goal_links_for_network_graph]
- goals_summary = local_assigns[:goals_summary]
- goals_summary_timespan_label = local_assigns[:goals_summary_timespan_label]
- goals_org = local_assigns[:organization]
- after_network = local_assigns[:after_network]
- network_chart_id_prefix = local_assigns[:network_chart_id_prefix] || first_chart_dom_id.to_s.sub(/-by-week-chart.*\z/, '')
- network_chart_id_prefix = 'goals-network' if network_chart_id_prefix.blank?
- collapse_network_by_default = local_assigns.fetch(:collapse_network_by_default, false)
- hide_network = local_assigns.fetch(:hide_network, false)
- hide_weekly_charts = local_assigns.fetch(:hide_weekly_charts, false)
- network_card_title = local_assigns.fetch(:network_card_title, 'Goals Network')
- network_collapse_id = "#{network_chart_id_prefix}-network-collapse"
- network_goal_count = goals_for_network_graph.respond_to?(:size) ? goals_for_network_graph.size : 0
- network_goal_possessive = network_goal_count == 1 ? "goal's" : "goals'"
- network_expand_label = "Expand to see your #{network_goal_count} #{network_goal_possessive} relationships visualized"
- show_network = !hide_network && (goals_for_network_graph.present? || goals_for_network_graph == [])
-# Bootstrap Icons: pass suffix only (e.g. bi-people) so we output bi bi-people

%div{class: wrap_class}
  - if show_network
    .row.mb-4
      .col-12
        .card.border-0.shadow-sm.goals-network-section
          .card-header.bg-light
            %h5.mb-0
              %i.bi.bi-diagram-3-fill.me-2
              = network_card_title
          .card-body
            - if goals_for_network_graph.any?
              - if collapse_network_by_default
                %button.btn.btn-link.btn-sm.text-decoration-none.px-0.mb-0{type: "button", "data-bs-toggle": "collapse", "data-bs-target": "##{network_collapse_id}", "aria-expanded": "false", "aria-controls": network_collapse_id}
                  %i.bi.bi-arrows-expand.me-1
                  = network_expand_label
                .collapse{id: network_collapse_id}
                  .pt-3
                    = render 'shared/goals_network_graph',
                      goals: goals_for_network_graph,
                      goal_links: goal_links_for_network_graph,
                      organization: goals_org,
                      chart_id_prefix: network_chart_id_prefix,
                      defer_init: true
              - else
                = render 'shared/goals_network_graph',
                  goals: goals_for_network_graph,
                  goal_links: goal_links_for_network_graph,
                  organization: goals_org,
                  chart_id_prefix: network_chart_id_prefix
            - else
              .alert.alert-info.mb-0
                %h6.mb-2
                  %i.bi.bi-info-circle.me-2
                  No goals to display
                %p.mb-0 There are no active goals or recently completed goals in this scope.

  - if after_network.present?
    = after_network

  - unless hide_weekly_charts
    - if goals_summary.present?
      .row.mb-2
        .col-12
          %p.mb-0.text-muted= goals_summary_timespan_label
      .row.mb-4.g-3
        .col-md-3
          .card.bg-light.border-0.h-100
            .card-body.text-center
              .display-6.fw-semibold= number_with_delimiter(goals_summary.created_goals_count)
              .small.text-muted.mt-1 Goals created
              .fw-semibold.mt-2= number_with_delimiter(goals_summary.created_teammates_count)
              .small.text-muted Teammates
        .col-md-3
          .card.bg-light.border-0.h-100
            .card-body.text-center
              .display-6.fw-semibold= number_with_delimiter(goals_summary.confidence_checked_goals_count)
              .small.text-muted.mt-1 Goals with a confidence check
              .fw-semibold.mt-2= number_with_delimiter(goals_summary.confidence_checked_teammates_count)
              .small.text-muted Teammates
        .col-md-3
          .card.bg-light.border-0.h-100
            .card-body.text-center
              .display-6.fw-semibold= number_with_delimiter(goals_summary.stale_goals_count)
              .small.text-muted.mt-1{ title: "Created before this timespan with no confidence checks during this timespan" } Stale goals
              .fw-semibold.mt-2= number_with_delimiter(goals_summary.stale_teammates_count)
              .small.text-muted Teammates
        .col-md-3
          .card.bg-light.border-0.h-100
            .card-body.text-center
              .display-6.fw-semibold= number_with_delimiter(goals_summary.completed_goals_count)
              .small.text-muted.mt-1 Goals completed
              .fw-semibold.mt-2= number_with_delimiter(goals_summary.completed_teammates_count)
              .small.text-muted Teammates

    - if show_network || goals_summary.present?
      %hr.my-5

    .row.mb-4
      .col-12
        .card.border-0.shadow-sm
          .card-header.bg-primary.text-white
            %h4.mb-0
              %i.bi.bi-bullseye.me-2
              Goals by Week (#{chart_title_period})
          .card-body
            %div{id: first_chart_dom_id, style: "height: 400px;"}

    - unless hide_second_chart
      %hr.my-5

      .row.mb-4
        .col-12
          .card.border-0.shadow-sm
            .card-header.bg-secondary.text-white
              %h4.mb-0
                %i.bi{class: "#{second_header_icon} me-2"}
                = second_card_heading
            .card-body
              %div{id: second_chart_dom_id, style: "height: 400px;"}

    - charts_after_first.each do |ch|
      %hr.my-5
      .row.mb-4
        .col-12
          .card.border-0.shadow-sm
            .card-header{class: ch[:header_class]}
              %h4.mb-0
                %i.bi{class: "#{ch[:header_icon]} me-2"}
                = ch[:card_heading]
            .card-body
              %div{id: ch[:dom_id], style: "height: 400px;"}

    - charts_after_second.each do |ch|
      %hr.my-5
      .row.mb-4
        .col-12
          .card.border-0.shadow-sm
            .card-header{class: ch[:header_class]}
              %h4.mb-0
                %i.bi{class: "#{ch[:header_icon]} me-2"}
                = ch[:card_heading]
            .card-body
              %div{id: ch[:dom_id], style: "height: 400px;"}

:javascript
  (function() {
    if (#{hide_weekly_charts.to_json}) return;

    var goalsChartData = #{goals_chart_data.to_json};
    var secondChartData = #{second_chart_data.to_json};
    var chartsAfterFirst = #{charts_after_first.to_json};
    var chartsAfterSecond = #{charts_after_second.to_json};
    var chartTitle = #{chart_title_period.to_json};
    var firstId = #{first_chart_dom_id.to_json};
    var secondId = #{second_chart_dom_id.to_json};
    var secondYTitle = #{second_y_axis_title.to_json};
    var secondChartTitle = #{second_highcharts_title.to_json};

    function stackedColumnOptions(categories, series, yTitle, titleText) {
      return {
        chart: { type: 'column' },
        title: { text: titleText },
        accessibility: { enabled: false },
        xAxis: {
          categories: categories,
          title: { text: 'Week of' }
        },
        yAxis: {
          min: 0,
          title: { text: yTitle },
          stackLabels: { enabled: true }
        },
        plotOptions: {
          column: {
            stacking: 'normal',
            dataLabels: { enabled: false }
          }
        },
        series: series
      };
    }

    function initializeGoalsChart() {
      if (typeof Highcharts === 'undefined') return;
      if (!document.getElementById(firstId)) return;
      Highcharts.chart(firstId, stackedColumnOptions(
        goalsChartData.categories,
        goalsChartData.series,
        'Number of goals',
        'Goals by week (' + chartTitle + ')'
      ));
    }

    function initializeSecondChart() {
      if (typeof Highcharts === 'undefined') return;
      if (!document.getElementById(secondId)) return;
      Highcharts.chart(secondId, stackedColumnOptions(
        secondChartData.categories,
        secondChartData.series,
        secondYTitle,
        secondChartTitle
      ));
    }

    function initializeExtraCharts(list) {
      if (!list || !list.length) return;
      list.forEach(function(ch) {
        var el = document.getElementById(ch.dom_id);
        if (!el || !ch.chart_data) return;
        Highcharts.chart(ch.dom_id, stackedColumnOptions(
          ch.chart_data.categories,
          ch.chart_data.series,
          ch.y_axis_title,
          ch.chart_title
        ));
      });
    }

    function initializeCharts() {
      initializeGoalsChart();
      if (!#{hide_second_chart.to_json}) initializeSecondChart();
      initializeExtraCharts(chartsAfterFirst);
      initializeExtraCharts(chartsAfterSecond);
    }

    var attempts = 0;
    function waitForHighcharts() {
      if (typeof Highcharts !== 'undefined') {
        initializeCharts();
      } else if (attempts < 100) {
        attempts++;
        setTimeout(waitForHighcharts, 100);
      } else {
        var script = document.createElement('script');
        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/highcharts/11.3.0/highcharts.js';
        script.onload = initializeCharts;
        document.head.appendChild(script);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', waitForHighcharts);
    } else {
      waitForHighcharts();
    }
    window.addEventListener('load', function() {
      if (typeof Highcharts !== 'undefined') initializeCharts();
    });
  })();
