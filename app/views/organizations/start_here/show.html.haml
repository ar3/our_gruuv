- content_for :title, "Start Here"
- org_name = current_organization&.name || "Organization"
- dash = @start_here_dashboard

- content_for :header do
  .d-flex.flex-wrap.align-items-center.justify-content-between.gap-2.w-100
    %div
      %h1.mb-0 Start Here
      %p.lead.text-muted.mb-0
        A quick guide to #{org_name}'s Gruuv. Pick a place to go.

= render "organizations/start_here/widget_dashboard", dash: dash

- prefs = current_user_preferences
- vertical_nav_mode = prefs.vertical_nav_mode.presence || (prefs.vertical_nav_locked? ? "locked_open" : "closed_unless_opened")

%hr.my-4
%a.start-here-customize-toggle.h5.fw-semibold.text-body.text-decoration-none.d-inline-flex.align-items-center.gap-2.mb-3.collapsed{href: "#start-here-other-customize", role: "button", data: { turbo: false, bs_toggle: "collapse", bs_target: "#start-here-other-customize" }, "aria-expanded": "false", "aria-controls": "start-here-other-customize"}
  Other ways to customize OurGruuv
  %i.bi.bi-chevron-down.start-here-customize-chevron-down{aria: { hidden: true }}
  %i.bi.bi-chevron-up.start-here-customize-chevron-up{aria: { hidden: true }}

.collapse#start-here-other-customize
  .mb-4
    %label.form-label.small.fw-semibold.mb-1{for: "start_here_start_page"} Start page when I open #{org_name}
    = form_with url: organization_start_here_update_start_page_path(current_organization), method: :post, local: true, html: { data: { turbo: false }, class: "mb-0" } do
      = select_tag :start_page, options_for_select(start_page_options_for_select(current_organization, current_company_teammate), start_page_preference(current_organization, current_person)), { id: "start_here_start_page", class: "form-select", onchange: "this.form.submit()" }
    %p.form-text.text-muted.small.mb-0 Choose where you land when you sign in or click the org name in the header.

  .mb-4
    %p.small.fw-semibold.text-muted.mb-2 Vertical nav behavior
    = form_with url: organization_start_here_update_vertical_nav_mode_path(current_organization), method: :post, local: true, html: { data: { turbo: false }, class: "mb-0" } do
      .form-check
        = radio_button_tag :mode, "locked_open", vertical_nav_mode == "locked_open", id: "vertical_nav_mode_locked_open", class: "form-check-input", onchange: "this.form.submit()"
        %label.form-check-label{for: "vertical_nav_mode_locked_open"}
          Lock the vertical nav bar open
      .form-check
        = radio_button_tag :mode, "closed_unless_opened", vertical_nav_mode == "closed_unless_opened", id: "vertical_nav_mode_closed_unless_opened", class: "form-check-input", onchange: "this.form.submit()"
        %label.form-check-label{for: "vertical_nav_mode_closed_unless_opened"}
          Keep the vertical nav bar closed unless I open it

  .mb-4
    .alert.alert-info.mb-0
      Notification timing and delivery preferences moved to the Notifications tab on your profile.
      = link_to "Open notification settings", organization_company_teammate_notifications_path(current_organization, current_company_teammate), class: "alert-link ms-1"

.alert.alert-warning.mt-4.mb-5{role: "alert"}
  %p.mb-0
    %strong This page is retiring on #{start_here_retirement_date_label}.
    After that, this URL will redirect to
    = link_to "OG Academy", organization_og_academy_path(current_organization), class: "alert-link"
    where the same customizable widget dashboard already lives (below OG Mastery milestones).
    If you’re disappointed by this change, reach out to your OG Admin.
