- content_for :title, "Edit proposal · #{@seat.display_name}"

- content_for :header do
  %h1.mb-0 Edit draft proposal

- content_for :go_back_link do
  = nav_hierarchy_with_previous(organization: @organization, crumbs: [{ label: "Seats", url: organization_seats_path(@organization) }, { label: @seat.display_name, url: organization_seat_path(@organization, @seat) }, { label: "Proposal", url: organization_seat_maap_proposal_path(@organization, @seat, @proposal) }, { label: "Edit", url: nil }])

.row.justify-content-center
  .col-lg-8
    = form_with model: @proposal, url: organization_seat_maap_proposal_path(@organization, @seat, @proposal), method: :patch, local: true, scope: :maap_proposal do |f|
      = render "organizations/seats/maap_proposals/form_fields",
               f: f,
               organization: @organization,
               titles: @titles,
               reportable_seats: @reportable_seats,
               payload: @payload

      .d-flex.flex-wrap.gap-2.mt-4
        = f.submit "Save draft", class: "btn btn-primary"
        = link_to "Cancel", organization_seat_maap_proposal_path(@organization, @seat, @proposal), class: "btn btn-outline-secondary"
