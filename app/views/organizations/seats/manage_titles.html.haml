- content_for :title, "Manage Titles - #{@seat.display_name}"

- content_for :header do
  %h1.mb-0
    %i.bi.bi-tags.me-2
    Manage Titles - #{@seat.display_name}

- content_for :return_url do
  = organization_seat_path(@organization, @seat)

- content_for :return_text do
  = "Back to #{@seat.display_name}"

- can_manage = policy(@seat).update?

= form_with url: update_titles_organization_seat_path(@organization, @seat), method: :patch, local: true do |form|
  .row
    .col-12
      .card.mb-4
        .card-header
          %h5.mb-0
            %i.bi.bi-list-check.me-2
            Select Titles
        .card-body
          %p.text-muted.mb-3
            Select one or more titles for
            %strong= @seat.display_name
            = ". The primary title stays primary when still selected; otherwise the first selected title becomes primary."

          - if @titles.any?
            .mb-3{data: {controller: "selection-toolbar options-filter"}}
              = render "shared/selection_pages/toolbar",
                form: form,
                save_label: "Save Titles",
                can_manage: can_manage,
                search_placeholder: "Search titles...",
                search_aria_label: "Filter titles",
                disabled_tooltip: "Requires manage MAAP permission",
                large_save: true

              .selection-page-columns{data: {options_filter_target: "list"}}
                - @titles.each do |title|
                  .filterable-option
                    .form-check
                      = check_box_tag "title_ids[]",
                        title.id,
                        @selected_title_ids.include?(title.id),
                        class: "form-check-input",
                        id: "title_#{title.id}",
                        disabled: !can_manage,
                        data: {selection_toolbar_label: title.external_title}
                      = label_tag "title_#{title.id}", class: "form-check-label" do
                        %strong= title.external_title
                        - if title.department
                          %br
                          %small.text-muted= title.department.display_name
                        - else
                          %br
                          %small.text-muted No department
          - else
            .alert.alert-info
              %i.bi.bi-info-circle.me-2
              No titles found in this organization.

      .card.mb-4
        .card-body
          = render "shared/selection_pages/save_button",
            form: form,
            label: "Save Titles",
            can_manage: can_manage,
            large: true,
            disabled_tooltip: "Requires manage MAAP permission"
