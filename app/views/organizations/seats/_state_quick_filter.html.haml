- selection = seat_state_quick_filter_selection(local_assigns[:filters] || @current_filters)
- enabled = selection != :custom
- options = [[:filled, "Filled only"], [:unfilled, "Unfilled only"], [:all_open, "All Open"], [:draft, "Draft only"], [:all, "All"]]
- customize_params = params.except(:controller, :action, :page).permit!.to_h
.seat-state-quick-filter{class: local_assigns[:wrapper_class]}
  - if enabled
    .btn-group.btn-group-sm{role: "group", "aria-label": "Seat status filter"}
      - options.each do |key, label|
        - active = selection == key
        = link_to label, seat_state_quick_filter_path(@organization || organization, key), class: "btn #{active ? 'btn-primary' : 'btn-outline-secondary'}", "aria-current": (active ? "true" : nil)
  - else
    %span.d-inline-block{"data-bs-toggle" => "tooltip", "data-bs-title" => SeatsHelper::STATE_QUICK_FILTER_CUSTOM_TOOLTIP}
      .btn-group.btn-group-sm{role: "group", "aria-label": "Seat status filter"}
        - options.each do |_key, label|
          %button.btn.btn-outline-secondary.disabled{type: "button", disabled: true}= label
  - unless local_assigns[:hide_customize_hint]
    %small.text-muted.d-block.mt-1
      Same status filter can be set in
      = link_to "Customize View", customize_view_organization_seats_path(@organization || organization, customize_params), class: "link-secondary"
