-# Locals: organization, seat
- organization = local_assigns.fetch(:organization)
- seat = local_assigns.fetch(:seat)
- if seat&.active_tenure_without_filled_state?
  - active_tenure = seat.employment_tenures.active.includes(company_teammate: :person).first
  - person = active_tenure&.teammate&.person
  - casual = person&.casual_name.presence || "someone"

  .alert.alert-warning.mb-4{role: "alert"}
    %h5.alert-heading.mb-2
      %i.bi.bi-exclamation-triangle.me-2
      Seat status does not match active tenure
    %p.mb-2
      This seat is marked
      %strong= seat.state_display_label
      but has an active employment tenure for #{casual}. Only open (unfilled) seats should be assignable; filled status is set automatically when someone is in the seat.
    %p.mb-0
      - if active_tenure&.teammate
        = link_to "Go to Seat Management for #{casual}",
                  organization_teammate_position_path(organization, active_tenure.teammate),
                  class: "alert-link"
        to remove them from the seat, or
      = link_to "edit this seat", edit_organization_seat_path(organization, seat), class: "alert-link"
      to review status.
      - if policy(seat).reconcile?
        = link_to "Reconcile state", reconcile_organization_seat_path(organization, seat), class: "alert-link ms-1", data: { turbo_method: :patch }
