- content_for :title, "Create proposal · #{@payload.name}"
- page_help_id = "maapAbilityCreateShowPageHelp"

- content_for :header do
  .d-flex.flex-wrap.align-items-center.gap-2
    %h1.mb-0.d-flex.align-items-center.flex-wrap.gap-2
      %span Ability create proposal
      = render "shared/page_help/header_info_button",
               collapse_id: page_help_id,
               tooltip: "Propose a new Ability. Click for how create proposals work."
      - if policy(@proposal).edit?
        = link_to edit_organization_maap_ability_create_path(@organization, @proposal),
                  class: "btn btn-primary",
                  title: "Edit draft",
                  "aria-label" => "Edit draft",
                  data: { "bs-toggle" => "tooltip", "bs-placement" => "top" } do
          %i.bi.bi-pencil

- content_for :go_back_link do
  = nav_hierarchy_with_previous(organization: @organization, crumbs: [{ label: "Abilities", url: organization_abilities_path(@organization) }, { label: "Proposed Ability creates", url: organization_maap_ability_creates_path(@organization) }, { label: "Proposal", url: nil }])

.collapse.mb-4{id: page_help_id}
  = render "organizations/maap_ability_creates/page_help"

.row.justify-content-center
  .col-lg-8
    = render "organizations/maap_proposals/parent_seat_create_link", parent_seat_proposal: @parent_seat_proposal

    .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.mb-3
      %div
        %span.badge.me-2{class: proposal_status_badge_class(@proposal.status)}= @proposal.status
        %span.text-muted
          Proposed by #{@proposal.proposer.person.display_name}
          - if @proposal.create_key.present?
            · create_key #{@proposal.create_key}
      .d-flex.flex-wrap.gap-2
        = link_to markdown_organization_maap_ability_create_path(@organization, @proposal), class: "btn btn-outline-secondary btn-sm" do
          %i.bi.bi-download.me-1
          Download .md
        - if policy(@proposal).edit?
          = link_to "Edit draft", edit_organization_maap_ability_create_path(@organization, @proposal), class: "btn btn-outline-primary btn-sm"
        - if policy(@proposal).submit?
          = button_to "Submit", submit_organization_maap_ability_create_path(@organization, @proposal), method: :post, class: "btn btn-primary btn-sm"
        - if policy(@proposal).destroy?
          = button_to "Delete", organization_maap_ability_create_path(@organization, @proposal), method: :delete, class: "btn btn-outline-danger btn-sm", data: { turbo_confirm: "Delete this proposal?" }

    - if @name_uniqueness&.taken?
      .alert.alert-warning.mb-4{role: "status"}
        %i.bi.bi-exclamation-triangle.me-1
        = @name_uniqueness.message

    .card.mb-4
      .card-header
        %h5.mb-0 Proposed content
      .card-body
        %h6.text-muted Name
        %p= @payload.name
        - if @payload.department_id.present?
          %h6.text-muted Department
          %p= Department.find_by(id: @payload.department_id)&.name || @payload.department_id
        %h6.text-muted Description
        .markdown-content.mb-3= simple_format(@payload.description.to_s)
        - (1..5).each do |level|
          - text = @payload.public_send("milestone_#{level}_description")
          %h6.text-muted Milestone #{level}
          - if text.present?
            .markdown-content.mb-3= render_markdown(text.to_s)
          - else
            %p.text-muted.mb-3 None

    - if @proposal.applied? || @proposal.rejected?
      - decision_verb = @proposal.applied? ? "accepted" : "rejected"
      - decision_alert_class = @proposal.applied? ? "alert-success" : "alert-danger"
      - decider_name = @proposal.decided_by&.person&.display_name || "Someone"
      .alert{class: "#{decision_alert_class} mb-4", role: "region", "aria-labelledby": "ability-create-proposal-decision"}
        %h5.alert-heading.mb-2{ id: "ability-create-proposal-decision" }
          %i.bi{class: "#{@proposal.applied? ? 'bi-check-circle' : 'bi-x-circle'} me-2"}
          Proposal #{decision_verb}
        %p.mb-2
          #{decider_name} #{decision_verb} this create proposal
          - if @proposal.decided_at.present?
            on #{l(@proposal.decided_at, format: :long)}
          - if @proposal.applied? && @proposal.proposable
            %span
              · created
              = link_to @proposal.proposable.name, organization_ability_path(@organization, @proposal.proposable)
        - if @proposal.decision_note.present?
          %p.mb-2
            %strong Note:
            = @proposal.decision_note
        - else
          %p.mb-2.text-muted No note was left with this decision.
        - if Array(@proposal.decision_warnings).any?
          %p.mb-1
            %strong Apply warnings:
          %ul.mb-0
            - Array(@proposal.decision_warnings).each do |warning|
              %li= warning
    - else
      - decision_disabled_reason = maap_proposal_decision_disabled_reason(@proposal)
      .card.mb-4{ role: "region", "aria-labelledby": "ability-create-proposal-review" }
        .card-header
          %h5.mb-0{ id: "ability-create-proposal-review" } Review
        .card-body
          - if decision_disabled_reason.blank?
            = form_with url: apply_organization_maap_ability_create_path(@organization, @proposal), method: :post, local: true do
              %p.text-muted.small
                Applying creates a new Ability at the initial early-draft version (0.0.1). No version bump picker.
              .mb-3
                = label_tag :decision_note, "Note (optional)", class: "form-label"
                = text_area_tag :decision_note, nil, class: "form-control", rows: 2
              .d-flex.flex-wrap.gap-2
                = submit_tag "Apply proposal", class: "btn btn-success"
            = form_with url: reject_organization_maap_ability_create_path(@organization, @proposal), method: :post, local: true, class: "mt-3" do
              .mb-3
                = label_tag :decision_note, "Rejection note (optional)", class: "form-label"
                = text_area_tag :decision_note, nil, class: "form-control", rows: 2
              = submit_tag "Reject proposal", class: "btn btn-outline-danger", data: { turbo_confirm: "Reject this proposal?" }
          - else
            .d-flex.flex-wrap.align-items-center.gap-2
              %button.btn.btn-success{type: "button", disabled: true, "aria-label" => "Apply proposal"} Apply proposal
              %span.text-warning{"data-bs-toggle" => "tooltip", "data-bs-placement" => "top", "data-bs-title" => decision_disabled_reason, tabindex: "0", role: "img", "aria-label" => "Permission notice"}
                %i.bi.bi-exclamation-triangle
              %button.btn.btn-outline-danger{type: "button", disabled: true, "aria-label" => "Reject proposal"} Reject proposal
              %span.text-warning{"data-bs-toggle" => "tooltip", "data-bs-placement" => "top", "data-bs-title" => decision_disabled_reason, tabindex: "0", role: "img", "aria-label" => "Permission notice"}
                %i.bi.bi-exclamation-triangle
