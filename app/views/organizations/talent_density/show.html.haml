- page_help_id = "talentDensityPageHelp"
- viz_params = talent_density_viz_filter_params(matrix: "stances")

- content_for :title, "Talent Density"

- content_for :go_back_link do
  = nav_hierarchy_with_previous(organization: @organization, crumbs: [{ label: "Talent Density", url: nil }])

- content_for :header do
  .d-flex.align-items-center.gap-2.flex-wrap
    %h1.mb-0.d-flex.align-items-center.gap-2
      %i.bi.bi-people.me-1
      Talent Density
      = render "shared/page_help/header_info_button",
               collapse_id: page_help_id,
               tooltip: "Private keeper-test stances for a manager's team. Click for the rubric and privacy rules."
    %span.badge.text-bg-warning
      %i.bi.bi-flask.me-1
      Beta

.collapse.mb-4{id: page_help_id}
  = render "organizations/talent_density/page_help"

- if @explainer_only
  = render "organizations/talent_density/explainer"
- else
  = render "organizations/talent_density/shared_filters_bar"
  = render "organizations/talent_density/tabs", organization: @organization, active_tab: :stances, viz_params: viz_params
  = render "organizations/talent_density/working_page"
