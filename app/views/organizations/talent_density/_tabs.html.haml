-# locals: active_tab (:stances or :visualization)
- active_tab = local_assigns.fetch(:active_tab)
- viz_params = local_assigns.fetch(:viz_params, {})

%ul.nav.nav-tabs.mb-4
  %li.nav-item
    = link_to "Stances",
      organization_talent_density_path(organization),
      class: "nav-link #{'active' if active_tab == :stances}",
      aria: { current: (active_tab == :stances ? "page" : nil) }
  %li.nav-item
    = link_to "Visualization",
      visualization_organization_talent_density_path(organization, viz_params),
      class: "nav-link #{'active' if active_tab == :visualization}",
      aria: { current: (active_tab == :visualization ? "page" : nil) }
