- teammate = row[:teammate]
- stance_record = row[:stance]
- history = Array(row[:history_reflections])
- selected = stance_record.stance
- check_ins_path = review_most_recent_organization_company_teammate_check_ins_path(organization, teammate)

.card.border.shadow-sm.mb-3
  .card-body
    .d-flex.justify-content-between.align-items-start.gap-3.flex-wrap.mb-3
      .d-flex.align-items-start.gap-3.min-w-0
        .flex-shrink-0
          = teammate_profile_image(teammate, size: 48)
        .min-w-0
          %h3.h5.mb-1
            = link_to teammate.person.display_name, check_ins_path, class: "text-decoration-none"
          %p.small.text-muted.mb-0= talent_density_teammate_context_sentence(row)
          %p.small.mb-0
            %span.badge.text-bg-light.border Confidential Talent Reflection
            %span.text-muted.ms-1= stance_record.period_month.strftime("%B %Y")
      - if stance_record.persisted?
        = link_to organization_paper_trail_path(organization, item_type: "TalentDensityStance", item_id: stance_record.id), class: "small text-decoration-none" do
          %i.bi.bi-clock-history.me-1
          Change history

    = render "organizations/talent_density/history_carousel",
      teammate: teammate,
      organization: organization,
      history_reflections: history,
      current_reflection: stance_record

    .row.g-3
      - TalentDensity::Rubric::CHOICES.each do |choice|
        .col-md-4
          .form-check{class: talent_density_choice_card_class(choice, selected: selected == choice[:key])}
            = radio_button_tag "stances[#{teammate.id}][stance]",
              choice[:key],
              selected == choice[:key],
              id: "stance_#{teammate.id}_#{choice[:key]}",
              class: "form-check-input"
            %label.form-check-label{for: "stance_#{teammate.id}_#{choice[:key]}"}
              %span{class: talent_density_choice_title_class(choice)}= choice[:id_do]
              %span.d-block.small.text-muted.mt-1 I'd feel: #{choice[:id_feel]}
              %span.d-block.small.mt-1 It means: #{choice[:it_means]}
    .form-check.mt-2
      = radio_button_tag "stances[#{teammate.id}][stance]",
        "not_yet",
        selected.blank?,
        id: "stance_#{teammate.id}_blank",
        class: "form-check-input"
      %label.form-check-label.text-muted{for: "stance_#{teammate.id}_blank"} Not yet

    - if stance_record.stance.present? && stance_record.stance_set_by.present?
      %p.small.text-muted.mt-2.mb-0
        Stance set by #{stance_record.stance_set_by.casual_name}
        - if stance_record.stance_set_at.present?
          on #{format_date_in_user_timezone(stance_record.stance_set_at)}

    .mt-3
      %p.small.text-muted.mb-2
        Narratives (separate voices) are only visible to #{talent_density_visible_to_sentence(row[:viewers])}.
      = render "shared/inline_top_level_comments",
        comments: row[:root_comments],
        organization: organization,
        composer: true,
        textarea_name: "stances[#{teammate.id}][comment]",
        textarea_id: "stance_comment_#{teammate.id}",
        textarea_value: row[:pending_comment],
        textarea_placeholder: "Add a narrative note for this Confidential Talent Reflection…",
        hint: "Saved with Save reflections... stance optional. Each person keeps their own voice.",
        empty_message: "No narrative notes yet for this Confidential Talent Reflection.",
        legacy_notes: stance_record.notes,
        legacy_notes_at: stance_record.updated_at,
        legacy_author_label: "Earlier notes"

    = render "organizations/talent_density/teammate_info_section",
      teammate: teammate,
      organization: organization,
      info: row[:teammate_info]
