- content_for :title, "Manage Members - #{@team.name}"

- content_for :go_back_link do
  = nav_hierarchy_with_previous(organization: @organization, crumbs: [{ label: @team.name, url: organization_team_path(@organization, @team) }, { label: "Manage members", url: nil }])

- content_for :header do
  .d-flex.align-items-center
    %h1.mb-0
      %i.bi.bi-person-check.me-2
      Manage Members
      %small.text-muted.ms-2
        = @team.name

.card.mb-3
  .card-header
    %h5.mb-0
      %i.bi.bi-people.me-2
      Select Team Members
  .card-body
    = form_with url: update_members_organization_team_path(@organization, @team), method: :patch, local: true do |form|
      = hidden_field_tag :authenticity_token, form_authenticity_token

      %p.text-muted.mb-3
        Select the employees who should be members of this team. Only active employees are shown.

      - if @teammates.any?
        .mb-3{data: {controller: "selection-toolbar options-filter"}}
          = render "shared/selection_pages/toolbar",
            form: form,
            save_label: "Save Changes",
            can_manage: true,
            search_placeholder: "Search teammates...",
            search_aria_label: "Filter teammates"

          .selection-page-columns{data: {options_filter_target: "list"}}
            - @teammates.each do |teammate|
              - checked = @member_teammate_ids.include?(teammate.id)
              - display_name = teammate.person.preferred_first_then_last_display_name
              %label.card.filterable-option.text-decoration-none{for: "teammate_#{teammate.id}", style: "cursor: pointer;"}
                .card-body
                  .d-flex.align-items-start
                    .form-check.me-2.mt-1
                      = check_box_tag "teammate_ids[]",
                        teammate.id,
                        checked,
                        class: "form-check-input",
                        id: "teammate_#{teammate.id}",
                        data: {selection_toolbar_label: display_name}
                    .flex-grow-1
                      .d-flex.align-items-center.mb-2
                        .me-3
                          = teammate_profile_image(teammate, size: 48)
                        .flex-grow-1
                          %h6.mb-1= display_name
                      - active_tenure = teammate.employment_tenures.find { |tenure| tenure.ended_at.nil? && tenure.company_id == teammate.organization_id }
                      - department = active_tenure&.position&.title&.department
                      - if department
                        %p.text-muted.mb-1
                          %small Department: #{department.name}
                      - if active_tenure&.position&.title
                        %p.text-muted.mb-0
                          %small Position: #{active_tenure.position.title.external_title}
      - else
        .alert.alert-info.mb-0
          %i.bi.bi-info-circle.me-2
          No active employees found in this organization. Please ensure employees are created first.

      .d-flex.gap-2.mt-3
        = render "shared/selection_pages/save_button", form: form, label: "Save Changes", can_manage: true
        = link_to 'Cancel', organization_team_path(@organization, @team), class: 'btn btn-outline-secondary'
