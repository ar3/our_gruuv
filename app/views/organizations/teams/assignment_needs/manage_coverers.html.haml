- content_for :title, "Manage Coverers - #{@assignment.title}"

- content_for :go_back_link do
  = nav_hierarchy_with_previous(organization: @organization, crumbs: [{ label: @team.name, url: organization_team_path(@organization, @team) }, { label: "Manage coverers", url: nil }])

- content_for :header do
  .d-flex.align-items-center
    %h1.mb-0
      %i.bi.bi-people.me-2
      Who is taking this on for the team?
      %small.text-muted.ms-2
        = @assignment.title

.card.mb-3
  .card-header
    %h5.mb-0
      %i.bi.bi-person-check.me-2
      Select coverers
  .card-body
    = form_with url: update_coverers_organization_team_assignment_need_path(@organization, @team, @need), method: :patch, local: true do |form|
      %p.text-muted.mb-3
        Name who is taking on
        %strong= @assignment.title
        for
        %strong= @team.name
        = ". Discrepancies (no active assignment or not on the team) are shown on the team page."

      - teammates_available = @team_member_teammates_with_assignment.any? || @team_member_teammates_without_assignment.any? || @other_teammates.any?
      - if teammates_available
        .mb-3{data: {controller: "selection-toolbar options-filter"}}
          = render "shared/selection_pages/toolbar",
            form: form,
            save_label: "Save Coverers",
            can_manage: true,
            search_placeholder: "Search teammates...",
            search_aria_label: "Filter teammates",
            large_save: true

          .selection-page-columns{data: {options_filter_target: "list"}}
            - if @team_member_teammates_with_assignment.any?
              %h6.fw-semibold.text-muted.mb-2.selection-page-full-width Currently have this assignment
              - @team_member_teammates_with_assignment.each do |teammate|
                = render "organizations/teams/coverer_option", teammate: teammate, selected_coverer_ids: @selected_coverer_ids
            - if @team_member_teammates_without_assignment.any?
              - if @team_member_teammates_with_assignment.any?
                %hr.my-4.selection-page-full-width
              .alert.alert-light.border.mb-3.selection-page-full-width
                %p.mb-0
                  %strong Below are those on the #{@team.name} team,
                  but do not currently have
                  %strong= @assignment.title
                  = "."
              - @team_member_teammates_without_assignment.each do |teammate|
                = render "organizations/teams/coverer_option", teammate: teammate, selected_coverer_ids: @selected_coverer_ids
            - if @other_teammates.any?
              - if @team_member_teammates_with_assignment.any? || @team_member_teammates_without_assignment.any?
                %hr.my-4.selection-page-full-width
              .alert.alert-light.border.mb-3.selection-page-full-width
                %p.mb-0
                  %strong Below are folks not on #{@team.name}.
                  It should be rare that they are taking on
                  %strong= @assignment.title
                  for this team.
              - @other_teammates.each do |teammate|
                = render "organizations/teams/coverer_option", teammate: teammate, selected_coverer_ids: @selected_coverer_ids
      - else
        .alert.alert-warning.mb-0
          No active employees found in this organization.

      .d-flex.gap-2.mt-3
        = render "shared/selection_pages/save_button", form: form, label: "Save Coverers", can_manage: true, large: true
