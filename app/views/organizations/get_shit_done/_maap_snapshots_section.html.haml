- pending_items = Array(@pending_acknowledgement_queue&.items)
- pending_count = pending_items.size
- section_id = 'checkInAcknowledgementsSection'
- section_open = gsd_open_section?(section_id)
= render 'shared/section_header',
         title: clarity_check_ins_awaiting_acknowledgement_label,
         icon: 'bi-clipboard-check',
         description: clarity_check_ins_awaiting_acknowledgement_description,
         collapsible: true,
         collapse_target: section_id,
         aria_expanded: gsd_section_aria_expanded(section_id),
         status_indicator: :warning

-# Summary view (shown when collapsed) — warning alert style
%div{class: "alert mb-4 collapse-summary #{status_indicator_alert_class(:warning)}#{' hidden' if section_open}", "data-bs-toggle" => "collapse", "data-bs-target" => "##{section_id}", "aria-expanded" => gsd_section_aria_expanded(section_id), "aria-controls" => section_id, style: "cursor: pointer;"}
  %p.mb-0
    %i{class: "#{status_indicator_icon(:warning)} #{status_indicator_badge_class(:warning)} me-2"}
    = clarity_check_ins_awaiting_acknowledgement_summary(count: pending_count)

-# Collapsible content
%div{class: gsd_collapse_class(section_id), id: section_id}
  .card.mb-4
    .card-body
      - if pending_items.any?
        .table-responsive
          %table.table.table-hover
            %thead
              %tr
                %th Item
                %th Reviewed Together
                %th Action
            %tbody
              - pending_items.each do |check_in|
                - type_label, item_name = check_in_subject_object_labels(check_in)
                %tr
                  %td
                    %span.badge.bg-secondary.me-2= type_label
                    = item_name
                  %td
                    - if check_in.official_check_in_completed_at.present?
                      = format_date_in_user_timezone(check_in.official_check_in_completed_at, format: '%b %d, %Y')
                    - else
                      %span.text-muted —
                  %td
                    = link_to "View what needs to be Acknowledged",
                              acknowledge_organization_company_teammate_check_ins_path(organization, @teammate),
                              class: "btn btn-primary btn-sm"

        .mt-3
          = render 'shared/acknowledgement_explanation_callout',
                   markdown_text: acknowledgement_explanation_markdown(organization),
                   direction: :up
      - else
        %p.text-muted.mb-0 No check-ins awaiting acknowledgement.
