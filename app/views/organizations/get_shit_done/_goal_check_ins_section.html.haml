- goals_count = @goals_needing_check_in.count
- section_id = 'goalCheckInsSection'
- section_open = gsd_open_section?(section_id)
= render 'shared/section_header',
         title: goal_confidence_checks_label,
         icon: 'bi-bullseye',
         description: goal_confidence_checks_description,
         collapsible: true,
         collapse_target: section_id,
         aria_expanded: gsd_section_aria_expanded(section_id),
         status_indicator: :warning

-# Summary view (shown when collapsed) — warning alert style
%div{class: "alert mb-4 collapse-summary #{status_indicator_alert_class(:warning)}#{' hidden' if section_open}", "data-bs-toggle" => "collapse", "data-bs-target" => "##{section_id}", "aria-expanded" => gsd_section_aria_expanded(section_id), "aria-controls" => section_id, style: "cursor: pointer;"}
  %p.mb-0
    %i{class: "#{status_indicator_icon(:warning)} #{status_indicator_badge_class(:warning)} me-2"}
    = goals_needing_confidence_check_summary(count: goals_count)

-# Collapsible content
%div{class: gsd_collapse_class(section_id), id: section_id}
  .card.mb-4
    .card-body
      - if @goals_needing_check_in.any?
        - grow_by_goals_url = my_growth_goals_organization_company_teammate_path(organization, @teammate)
        - bulk_edit_url = organization_goals_bulk_edit_path(organization, owner_id: "CompanyTeammate_#{@teammate.id}", status: ["active"])
        .alert.alert-primary.d-flex.flex-wrap.align-items-center.justify-content-between.gap-3.mb-4.py-4.px-4
          %p.fs-4.fw-semibold.mb-0
            Confidence checks on all of your active goals:
          .d-flex.flex-wrap.gap-2
            = link_to grow_by_goals_url, class: "btn btn-primary btn-lg" do
              %i.bi.bi-graph-up-arrow.me-2
              Grow by Goals
            - if policy(Goal).bulk_edit?
              = link_to bulk_edit_url, class: "btn btn-outline-primary btn-lg" do
                %i.bi.bi-table.me-2
                Bulk Edit Goals
        .table-responsive
          %table.table.table-hover
            %thead
              %tr
                %th Goal
                %th Last Check-in
                %th Action
            %tbody
              - @goals_needing_check_in.each do |goal|
                - last_check_in = goal.goal_check_ins.recent.first
                %tr
                  %td
                    %strong= goal.title
                    %br
                    %small.text-muted= goal.goal_type.humanize
                  %td
                    - if last_check_in
                      %strong= "#{last_check_in.confidence_percentage}%"
                      %br
                      %small.text-muted= last_check_in.check_in_week_start.strftime('%b %d, %Y')
                    - else
                      %span.text-muted No confidence check yet
                  %td
                    = link_to update_confidence_label,
                              organization_goal_path(organization, goal, anchor: 'check-in'),
                              class: "btn btn-primary btn-sm"
      - else
        %p.text-muted.mb-0 All goals are up to date.

