- silent_count = @silent_observations.count
- section_id = 'silentObservationsSection'
- section_open = gsd_open_section?(section_id)
= render 'shared/section_header',
         title: 'Silent Observations',
         icon: 'bi-bell-slash',
         description: 'Published observations (not journal-only) that have not been shared via Slack or DM yet',
         collapsible: true,
         collapse_target: section_id,
         aria_expanded: gsd_section_aria_expanded(section_id),
         status_indicator: :warning

%div{class: "alert mb-4 collapse-summary #{status_indicator_alert_class(:warning)}#{' hidden' if section_open}", "data-bs-toggle" => "collapse", "data-bs-target" => "##{section_id}", "aria-expanded" => gsd_section_aria_expanded(section_id), "aria-controls" => section_id, style: "cursor: pointer;"}
  %p.mb-0
    %i{class: "#{status_indicator_icon(:warning)} #{status_indicator_badge_class(:warning)} me-2"}
    = pluralize(silent_count, 'silent observation') + ' — publish is done; notifications are not'

%div{class: gsd_collapse_class(section_id), id: section_id}
  .card.mb-4
    .card-body
      - if @silent_observations.any?
        .d-flex.justify-content-end.mb-3
          = button_to "Skip all notifications",
            skip_all_gsd_notifications_organization_observations_path(organization),
            method: :post,
            class: "btn btn-outline-secondary btn-sm",
            data: { confirm: "Skip notifications for all #{silent_count} silent #{'observation'.pluralize(silent_count)}? They will leave this list without notifying anyone.", turbo: false },
            form: { data: { turbo: false } }
        .table-responsive
          %table.table.table-hover
            %thead
              %tr
                %th Preview
                %th Published
                %th{style: "min-width: 380px;"} Actions
            %tbody
              - @silent_observations.each do |observation|
                %tr
                  %td
                    %strong= truncate(observation.story || 'No story', length: 100)
                    %br
                    %small.text-muted
                      - if observation.observees.any?
                        = "Observing: #{observation.observed_teammates.map { |t| t.person.display_name }.join(', ')}"
                      - else
                        No observees
                  %td
                    %small= observation.published_at&.strftime('%b %d, %Y')
                  %td
                    - casual_names_list = observation.observees.any? ? observation.observed_teammates.map { |t| t.person.casual_name }.join(', ') : '--no observees--'
                    - confirm_skip = "Observations that folks aren't aware of lose a lot of their value... are you sure you don't want to notify #{casual_names_list}?"
                    .btn-group.btn-group-sm{role: "group"}
                      = link_to "Edit",
                                edit_organization_observation_path(organization, observation),
                                class: "btn btn-primary btn-sm"
                      = link_to "Send Notification",
                                organization_observation_path(organization, observation),
                                class: "btn btn-outline-primary btn-sm"
                      = link_to "skip notification",
                                skip_gsd_notification_organization_observation_path(organization, observation),
                                class: "btn btn-outline-secondary btn-sm",
                                data: { turbo_method: :post, turbo_confirm: confirm_skip }
      - else
        %p.text-muted.mb-0 No silent observations.
