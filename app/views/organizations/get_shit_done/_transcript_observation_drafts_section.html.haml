- drafts_count = @transcript_observation_drafts.count
- section_id = "transcriptObservationDraftsSection"
- section_open = gsd_open_section?(section_id)
- gsd_return = organization_gsd_path(organization, open: section_id)
= render "shared/section_header",
         title: "OGO drafts from meeting transcripts",
         icon: "bi-mic",
         description: "You already said these. Publish, set who can see them, and choose whether to notify — in one click.",
         collapsible: true,
         collapse_target: section_id,
         aria_expanded: gsd_section_aria_expanded(section_id),
         status_indicator: :warning

%div{class: "alert mb-4 collapse-summary #{status_indicator_alert_class(:warning)}#{' hidden' if section_open}", "data-bs-toggle" => "collapse", "data-bs-target" => "##{section_id}", "aria-expanded" => gsd_section_aria_expanded(section_id), "aria-controls" => section_id, style: "cursor: pointer;"}
  %p.mb-0
    %i{class: "#{status_indicator_icon(:warning)} #{status_indicator_badge_class(:warning)} me-2"}
    = pluralize(drafts_count, "transcript draft") + " ready to log"

%div{class: gsd_collapse_class(section_id), id: section_id}
  .card.mb-4
    .card-body
      - if @transcript_observation_drafts.any?
        .table-responsive
          %table.table.table-hover
            %thead
              %tr
                %th What you said
                %th{style: "width: 420px;"} Log it
            %tbody
              - @transcript_observation_drafts.each do |draft|
                %tr
                  %td
                    %strong= truncate(draft.story.to_s.split("==========").first.to_s.strip.presence || "No story yet", length: 140)
                    %br
                    %small.text-muted
                      - if draft.observees.any?
                        = "About #{draft.observed_teammates.filter_map { |t| t.person&.casual_name }.to_sentence}"
                      - else
                        No observees yet
                    %br
                    = link_to "Open draft", organization_observation_path(organization, draft), class: "small"
                  %td
                    = render "organizations/observations/transcript_draft_actions", organization: organization, observation: draft, return_url: gsd_return, size: "sm"
      - else
        %p.text-muted.mb-0 No transcript drafts.
