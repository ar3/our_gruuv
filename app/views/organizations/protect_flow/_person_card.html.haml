- person = local_assigns.fetch(:person)
- organization = local_assigns.fetch(:organization)
- historical = local_assigns.fetch(:historical, false)
- teammate = person[:teammate]
- attention_items = Array(person[:attention_items])
- clear_items = Array(person[:clear_items])

.card.border.h-100.protect-flow-person-card
  .card-body
    .d-flex.align-items-start.gap-3.mb-3
      .flex-shrink-0
        = teammate_profile_image(teammate, size: 56)
      .flex-grow-1.min-w-0
        %h2.h5.mb-1
          = link_to person[:name], person[:hub_path], class: "text-decoration-none"
        %p.small.text-muted.mb-0
          = protect_flow_person_week_summary(person)

    - if attention_items.any?
      %h3.h6.fw-semibold.text-muted.mb-2 Needs work
      .d-flex.flex-column.gap-2{class: clear_items.any? ? "mb-3" : "mb-0"}
        - attention_items.each do |action|
          = render "organizations/protect_flow/signal_row",
                   action: action,
                   organization: organization,
                   historical: historical,
                   clear_section: false

    - if clear_items.any?
      %h3.h6.fw-semibold.text-muted.mb-2 Clear
      .d-flex.flex-column.gap-2.mb-0
        - clear_items.each do |action|
          = render "organizations/protect_flow/signal_row",
                   action: action,
                   organization: organization,
                   historical: historical,
                   clear_section: true
