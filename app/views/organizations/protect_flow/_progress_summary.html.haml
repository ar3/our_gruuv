- progress = local_assigns.fetch(:progress)
- week_start = local_assigns.fetch(:week_start)
- historical = local_assigns.fetch(:historical, false)
- teammates_steady = progress[:teammates_steady_count].to_i
- people_count = progress[:people_count].to_i
- start_steady = progress[:start_steady_count].to_i
- total_signals = progress[:total_signal_count].to_i
- improved = progress[:improved_signal_count].to_i
- baseline_day = protect_flow_day_label(progress[:baseline_as_of].presence || week_start)

.card.border.mb-4
  .card-body.py-3
    .row.g-3.align-items-center
      .col-md-5
        %h2.h5.mb-1= historical ? "That week’s progress" : "This week’s progress"
        %p.small.text-muted.mb-0
          Week of #{protect_flow_week_label(week_start)} · we'll keep track of improvements made throughout the week.
      .col-md-7
        .d-flex.flex-wrap.gap-3.justify-content-md-end
          %div
            %div.fs-4.fw-semibold.lh-1
              #{teammates_steady}/#{people_count}
            %div.small.text-muted Teammates steady
          %div
            %div.fs-4.fw-semibold.lh-1
              #{start_steady}/#{total_signals}
            %div.small.text-muted Signals steady as of #{baseline_day}
          %div
            %div.fs-4.fw-semibold.lh-1= improved
            %div.small.text-muted= "signal".pluralize(improved) + " improved"
