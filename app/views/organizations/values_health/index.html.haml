- content_for :title, "Values Health"
- page_help_id = "valuesHealthPageHelp"

- content_for :header do
  - object_lens_trailing = capture do
    = render "shared/page_help/header_info_button",
             collapse_id: page_help_id,
             tooltip: "See Expectation Alignment across values. Click for a full breakdown."
  = render "shared/object_lens_header/switchers",
           organization: @organization,
           current_object: :values,
           current_lens: :health,
           trailing: object_lens_trailing

.mb-4
  = content_for :go_back_link

.collapse.mb-4{id: page_help_id}
  = render "organizations/values_health/page_help"

- content_for :go_back_link do
  = nav_hierarchy_with_previous(organization: @organization, crumbs: [{ label: "Values Health", url: nil }])

.row.justify-content-center.mb-4
  .col-lg-12
    .card.border-0.shadow-sm
      .card-body
        .row
          .col-md-9
            .row.text-center
              .col-3
                .h3.text-primary= @overview.total_count
                %small.text-muted Active values
              .col-3
                .h3.text-success= @overview.scored_count
                %small.text-muted Scored
              .col-3
                .h3.text-warning= @overview.missing_count
                %small.text-muted Missing score
              .col-3
                .h3{class: (@overview.stale_count.positive? ? "text-danger" : "text-muted")}= @overview.stale_count
                %small.text-muted Stale (&gt;1 day)
          .col-md-3
            - if @overview.average_score.present?
              .text-center
                .h3.mb-0= @overview.average_score.round
                %small.text-muted Avg alignment
            - if @overview.refreshable_count.positive?
              .alert.alert-warning.small.mb-0.mt-2
                %i.bi.bi-exclamation-triangle.me-2
                %strong= "#{@overview.refreshable_count} need refresh"
      .card-footer.bg-light
        %small.text-muted
          Expectation Alignment Score bands match the per-value gauge (Strongly Mis-aligned → Strongly Aligned). Shared meaning of each value is how people know what “living it” looks like.

.row.justify-content-center.mb-3
  .col-lg-12
    = render "organizations/health/dashboard_toolbar",
      organization: @organization,
      current: :values_health,
      show_switcher: false,
      other_actions: values_health_other_actions(@organization, refreshable_count: @overview.refreshable_count)

.row.justify-content-center.mb-4
  .col-lg-12
    .card.border-0.shadow-sm
      .card-header.bg-white
        %h5.mb-0
          %i.bi.bi-bar-chart.me-2
          Score distribution
      .card-body
        - if @overview.total_count.zero?
          %p.text-muted.mb-0 No active values yet.
        - else
          #values-health-distribution-chart{style: "height: 320px;"}

.row.justify-content-center.mb-4
  .col-lg-6.mb-4.mb-lg-0
    = render "organizations/values_health/score_list",
             title: "10 best",
             icon: "bi-stars",
             rows: @overview.best,
             empty_message: "No scored values yet. Refresh missing scores to populate this list."
  .col-lg-6
    = render "organizations/values_health/score_list",
             title: "10 worst",
             icon: "bi-exclamation-octagon",
             rows: @overview.worst,
             empty_message: "No scored values yet. Refresh missing scores to populate this list."

- if @overview.refreshable_rows.any?
  - refreshable_preview = @overview.refreshable_rows.first(25)
  .row.justify-content-center.mb-4
    .col-lg-12
      .card.border-0.shadow-sm
        .card-header.bg-white.d-flex.justify-content-between.align-items-center
          %h5.mb-0
            %i.bi.bi-arrow-clockwise.me-2
            Missing &amp; stale scores
          %span.badge.text-bg-secondary= @overview.refreshable_count
        .card-body
          %p.small.text-muted.mb-3
            Scores older than one day, or values with no calculated score, can be queued for a background refresh.
            - if @overview.refreshable_count > refreshable_preview.size
              Showing the first #{refreshable_preview.size} of #{@overview.refreshable_count}; use
              %strong Refresh missing &amp; stale
              to queue all.
          .table-responsive
            %table.table.table-sm.table-hover.mb-0
              %thead
                %tr
                  %th Value
                  %th Status
                  %th Last calculated
                  %th
              %tbody
                - refreshable_preview.each do |row|
                  %tr
                    %td
                      = link_to row.aspiration.name, organization_aspiration_path(@organization, row.aspiration)
                    %td
                      - if row.missing?
                        %span.badge.text-bg-warning Missing
                      - else
                        %span.badge.text-bg-danger Stale
                    %td.small.text-muted
                      - if row.calculated_at.present?
                        = time_ago_in_words(row.calculated_at)
                        ago
                      - else
                        Never
                    %td.text-end
                      = button_to organization_values_health_refresh_path(@organization, aspiration_id: row.aspiration.id),
                                  method: :post,
                                  class: "btn btn-outline-secondary btn-sm",
                                  form: { class: "d-inline" } do
                        %i.bi.bi-arrow-clockwise.me-1
                        Refresh

%h2.h4.mb-3.mt-5#values-clarity
  %i.bi.bi-diagram-3.me-2
  Values check-in clarity
%p.text-muted.mb-3
  How often employee, manager, and final ratings agree on the latest finalized values check-in.
  Dots mode always redacts. Names mode shows identities you can see: everyone if you have manage employment,
  otherwise yourself and people in your managerial hierarchy.

.d-flex.flex-wrap.align-items-center.gap-2.mb-3
  %span.text-muted Show
  .btn-group{role: "group", "aria-label": "Marker style"}
    = link_to "Dots",
      organization_values_health_path(@organization),
      class: "btn btn-sm #{@clarity_display == 'dots' ? 'btn-primary' : 'btn-outline-primary'}"
    = link_to "Names",
      organization_values_health_path(@organization, display: 'names'),
      class: "btn btn-sm #{@clarity_display == 'names' ? 'btn-primary' : 'btn-outline-primary'}"

= render "organizations/insights/values_clarity_grid",
  query: @clarity_query,
  display: @clarity_display,
  organization: @organization,
  viewer_teammate: current_company_teammate,
  can_manage_employment: @can_manage_employment

- if @overview.total_count.positive?
  :javascript
    (function() {
      var chartData = #{@overview.chart_data.to_json};

      function initChart() {
        if (typeof Highcharts === 'undefined') return;
        var el = document.getElementById('values-health-distribution-chart');
        if (!el) return;
        Highcharts.chart('values-health-distribution-chart', {
          chart: { type: 'column' },
          title: { text: null },
          accessibility: { enabled: false },
          xAxis: { categories: chartData.categories, title: { text: 'Alignment band' } },
          yAxis: { min: 0, allowDecimals: false, title: { text: 'Values' } },
          legend: { enabled: false },
          plotOptions: {
            column: {
              dataLabels: { enabled: true },
              colorByPoint: true
            }
          },
          series: chartData.series
        });
      }

      var attempts = 0;
      function waitForHighcharts() {
        if (typeof Highcharts !== 'undefined') {
          initChart();
        } else if (attempts < 100) {
          attempts++;
          setTimeout(waitForHighcharts, 100);
        }
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', waitForHighcharts);
      } else {
        waitForHighcharts();
      }
    })();
