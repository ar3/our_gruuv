- page_help_id = "seatSuggestionPageHelp"
- content_for :title, "Suggest a Seat"

- content_for :go_back_link do
  = nav_hierarchy_with_previous(organization: @organization, crumbs: [{ label: "Seats", url: organization_seats_path(@organization) }, { label: "Suggest a Seat", url: nil }])

- content_for :header do
  .d-flex.align-items-center.gap-2.flex-wrap
    %h1.mb-0.d-flex.align-items-center.gap-2
      %i.bi.bi-chat-dots.me-1
      Suggest a Seat
      = render "shared/page_help/header_info_button",
               collapse_id: page_help_id,
               tooltip: "Chat to draft a Seat proposal when you are still figuring the role out. Click for details."
      = link_to organization_seat_suggestion_path(@organization),
                class: "btn btn-outline-primary btn-sm",
                title: "Start new conversation",
                "aria-label" => "Start new conversation" do
        %i.bi.bi-plus-lg.me-1
        Start new conversation
    %span.badge.text-bg-warning
      %i.bi.bi-flask.me-1
      Beta

.collapse.mb-4{id: page_help_id}
  = render "organizations/seat_suggestions/page_help"

.row.justify-content-center
  .col-lg-9
    %p.text-muted.mb-3
      Not sure what Titles, Assignments, or Abilities this Seat needs? Paste what you have and chat until OG can draft a Seat proposal — plus linked drafts for new or edited MAAP objects. Nothing is applied until someone applies each proposal separately.

    .card.border.shadow-sm.seat-suggestion-chat
      .card-body.p-0
        .ask-og-panel{ data: { controller: "ask-og",
          ask_og_create_url_value: organization_seat_suggestions_path(@organization),
          ask_og_query_value: "",
          ask_og_csrf_token_value: form_authenticity_token,
          ask_og_auto_start_value: false,
          ask_og_consultation_id_value: @consultation&.id,
          ask_og_status_url_value: (@consultation ? status_organization_seat_suggestion_path(@organization, @consultation) : ""),
          ask_og_reply_url_value: (@consultation ? reply_organization_seat_suggestion_path(@organization, @consultation) : "") } }
          .ask-og-thread.seat-suggestion-thread.px-3.py-3{ data: { ask_og_target: "thread" } }
            - unless @consultation
              .ask-og-bubble-row.ask-og-bubble-row--assistant
                .ask-og-bubble.ask-og-bubble--assistant.markdown-content
                  %p.mb-2
                    %strong Paste whatever you have
                    about the Seat you are trying to define — job docs, notes, rough bullets, or a brain dump.
                  %p.mb-0.text-muted
                    I will ask a few sharp questions, then show a summary of the Seat proposal drafts I can create for you to Confirm.

          .ask-og-waiting.d-none.px-3.py-2.border-top{ data: { ask_og_target: "waiting" } }
            .d-flex.align-items-center.gap-2.text-muted.small
              .spinner-border.spinner-border-sm{role: "status"}
                %span.visually-hidden Loading
              %span{ data: { ask_og_target: "phaseLabel" } } Starting…

          .ask-og-error.alert.alert-warning.mb-0.rounded-0.d-none{ data: { ask_og_target: "error" } }

          .ask-og-composer.border-top.p-3{ data: { ask_og_target: "composer" } }
            .input-group
              = text_area_tag :message, nil,
                class: "form-control",
                rows: 3,
                placeholder: "Paste notes or reply…",
                data: { ask_og_target: "input", action: "keydown.ctrl+enter->ask-og#handleSendShortcut keydown.meta+enter->ask-og#handleSendShortcut" },
                "aria-label" => "Message Seat Suggestion"
              %button.btn.btn-primary{ type: "button",
                data: { ask_og_target: "sendButton", action: "ask-og#send" },
                "aria-label" => "Send" }
                %i.bi.bi-send
            %p.form-text.text-muted.small.mb-0.mt-2
              Enter for a new line · ⌘/Ctrl+Enter to send, or click Send.

    - if @recent.any?
      .mt-4
        %h2.h6.text-muted Recent conversations
        %ul.list-group
          - @recent.each do |consultation|
            %li.list-group-item.d-flex.justify-content-between.align-items-center.gap-2
              = link_to organization_seat_suggestion_path(@organization, id: consultation.id) do
                = consultation.result.try(:query).to_s.truncate(80).presence || "Seat suggestion ##{consultation.id}"
              %span.badge{class: seat_suggestion_conversation_status_badge_class(consultation)}
                = seat_suggestion_conversation_status(consultation)
