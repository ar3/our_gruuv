-# locals: cell, driver_key, company_name, mode (optional), period_progress (optional), starts_on (optional), ends_on (optional)
- mode = local_assigns.fetch(:mode, :complete)
- if cell
  - if mode == :in_progress
    - popover_content = billing_in_progress_activity_popover(key: driver_key, cell: cell, company_name: company_name, period_progress: period_progress)
    - projected_count = billing_extrapolate_count(cell.activity_count, period_progress)
  - elsif mode == :upcoming
    - popover_content = billing_upcoming_activity_popover(key: driver_key, cell: cell, company_name: company_name, starts_on: starts_on, ends_on: ends_on)
  - else
    - popover_content = billing_value_outcome_popover(key: driver_key, teammate_count: cell.teammate_count, activity_count: cell.activity_count, value_sum: cell.value_sum, company_name: company_name)
  %span.border-bottom.border-dotted{tabindex: "0", style: "cursor: help;", "data-bs-toggle" => "popover", "data-bs-trigger" => "hover focus", "data-bs-placement" => "top", "data-bs-content" => popover_content, "aria-label" => popover_content}
    - if mode == :upcoming
      %span.text-muted= "~"
      = number_with_delimiter(cell.activity_count)
    - elsif mode == :in_progress
      = number_with_delimiter(cell.activity_count)
      %span.text-muted= "+"
      - if projected_count
        %span.text-muted.ms-1= "(~#{number_with_delimiter(projected_count)})"
    - else
      = number_with_delimiter(cell.activity_count)
- else
  %span.text-muted —
