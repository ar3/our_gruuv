-# locals: cell, driver_key, company_name, projected (optional), starts_on (optional), ends_on (optional)
- projected = local_assigns.fetch(:projected, false)
- if cell
  - outcome = billing_value_outcome_popover(key: driver_key, teammate_count: cell.teammate_count, activity_count: cell.activity_count, value_sum: cell.value_sum, company_name: company_name)
  - if projected
    - popover_content = "This is an estimated projection of the value #{company_name} will receive during the next period between #{l(starts_on, format: :long)} and #{l(ends_on, format: :long)}. #{outcome}"
  - else
    - popover_content = outcome
  %span.border-bottom.border-dotted{tabindex: "0", style: "cursor: help;", "data-bs-toggle" => "popover", "data-bs-trigger" => "hover focus", "data-bs-placement" => "top", "data-bs-content" => popover_content, "aria-label" => popover_content}
    - if projected
      %span.text-muted ~
    = number_with_delimiter(cell.activity_count)
- else
  %span.text-muted —
