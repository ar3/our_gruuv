-# locals: period
.qbr-snapshot
  %p.fw-semibold.mb-2
    - if period.locked?
      OG Value Analysis
    - else
      OG Value Analysis
      %span.text-muted.fw-normal (incomplete)
  %ul.mb-3
    %li
      Value delivered
      %strong= number_to_currency(period.value_delivered_total)
      across
      = pluralize(period.teammate_count, "teammate")
      - unless period.locked?
        %span.text-muted (so far)
    %li
      - if period.locked?
        Locked PEPM
      - else
        Likely PEPM
      %strong
        - if period.pepm.to_f.zero?
          nothing
        - else
          = number_to_currency(period.pepm)
          / teammate
    %li
      - if period.locked?
        Invoice total
      - else
        Likely invoice total
      %strong= number_to_currency(period.amount_due)
    %li
      - if period.prior_pepm
        Prior setpoint
        %strong= number_to_currency(period.prior_pepm)
        / teammate
        — this
        = period.locked? ? "lock" : "preview"
        is
        %strong= number_to_currency(period.pepm)
        / teammate
      - else
        No prior PEPM setpoint yet.

  - if period.value_analysis
    - analysis = period.value_analysis
    - prior_prior_col = analysis.columns[0]
    - prior_col = analysis.columns[1]
    - current_col = analysis.columns[2]
    - teammate_count = analysis.teammate_count
    - company_name = organization.display_name
    - current_ee_locals = { teammate_count: teammate_count }
    - if analysis.projected?
      - current_ee_locals = current_ee_locals.merge(projected: true, company_name: company_name, starts_on: current_col.starts_on, ends_on: current_col.ends_on)
    .table-responsive
      %table.table.table-sm.align-middle.mb-2
        %thead
          %tr
            %th Value driver
            %th.text-end
              Prior-prior
              - if prior_prior_col.starts_on
                %br
                %span.fw-normal.text-muted.small
                  = l(prior_prior_col.starts_on, format: :long)
                  –
                  = l(prior_prior_col.ends_on, format: :long)
              - else
                %br
                %span.fw-normal.text-muted.small n/a
            %th.text-end
              Prior
              - if prior_col.starts_on
                %br
                %span.fw-normal.text-muted.small
                  = l(prior_col.starts_on, format: :long)
                  –
                  = l(prior_col.ends_on, format: :long)
              - else
                %br
                %span.fw-normal.text-muted.small n/a
            %th.text-end
              = current_col.label
              %br
              %span.fw-normal.text-muted.small
                = l(current_col.starts_on, format: :long)
                –
                = l(current_col.ends_on, format: :long)
        %tbody
          - analysis.rows.each do |row|
            %tr
              %td= row.label
              %td.text-end
                = render "organizations/billing/ee_value", value: row.prior_prior_value, total: row.prior_prior_total, teammate_count: teammate_count
              %td.text-end
                = render "organizations/billing/ee_value", value: row.prior_value, total: row.prior_total, teammate_count: teammate_count
              %td.text-end
                = render "organizations/billing/ee_value", **current_ee_locals, value: row.current_value, total: row.current_total
          %tr.fw-semibold
            %td Total
            %td.text-end
              = render "organizations/billing/ee_value", value: analysis.totals[:prior_prior], total: analysis.total_sums[:prior_prior], teammate_count: teammate_count
            %td.text-end
              = render "organizations/billing/ee_value", value: analysis.totals[:prior], total: analysis.total_sums[:prior], teammate_count: teammate_count
            %td.text-end
              = render "organizations/billing/ee_value", **current_ee_locals, value: analysis.totals[:current], total: analysis.total_sums[:current]
    - if analysis.projected?
      %p.text-muted.small.mb-0
        Projected uses the prior period when progress is flat or down; if prior-prior → prior improved, it continues that linear increase.
    - else
      %p.text-muted.small.mb-0
        Actual reflects value delivered during this period after it ended — even if that is less than what was paid for.
