-# locals: period
.qbr-snapshot
  %p.fw-semibold.mb-2
    - if period.locked?
      OG Value Analysis
    - else
      OG Value Analysis
      %span.text-muted.fw-normal (incomplete)
  %ul.mb-3
    %li
      Value delivered
      %strong= number_to_currency(period.value_delivered_total)
      across
      = pluralize(period.teammate_count, "teammate")
      - unless period.locked?
        %span.text-muted (so far)
    %li
      - if period.locked?
        Locked PEPM
      - else
        Likely PEPM
      %strong
        - if period.pepm.to_f.zero?
          nothing
        - else
          = number_to_currency(period.pepm)
          / teammate
    %li
      - if period.locked?
        Invoice total
      - else
        Likely invoice total
      %strong= number_to_currency(period.amount_due)
    %li
      - if period.prior_pepm
        Prior setpoint
        %strong= number_to_currency(period.prior_pepm)
        / teammate
        — this
        = period.locked? ? "lock" : "preview"
        is
        %strong= number_to_currency(period.pepm)
        / teammate
      - else
        No prior PEPM setpoint yet.

  - if period.value_analysis
    - analysis = period.value_analysis
    - lookback_col = analysis.column_for(:lookback)
    - current_col = analysis.column_for(:current)
    - future_col = analysis.column_for(:future)
    - company_name = organization.display_name
    - lookback_mode = billing_column_mode_locals(lookback_col, company_name: company_name)
    - current_mode = billing_column_mode_locals(current_col, company_name: company_name)
    - future_mode = billing_column_mode_locals(future_col, company_name: company_name)
    .table-responsive
      %table.table.table-sm.align-middle.mb-2
        %thead
          %tr
            %th Value driver
            %th.text-end
              %div.fw-semibold Lookback
              - if lookback_col&.starts_on
                %span.fw-normal.text-muted.small
                  = l(lookback_col.starts_on, format: :long)
                  –
                  = l(lookback_col.ends_on, format: :long)
              - else
                %span.fw-normal.text-muted.small n/a
            %th.text-end
              %div.fw-semibold This period
              - if current_col&.starts_on
                %span.fw-normal.text-muted.small
                  = l(current_col.starts_on, format: :long)
                  –
                  = l(current_col.ends_on, format: :long)
              - else
                %span.fw-normal.text-muted.small n/a
            %th.text-end
              %div.fw-semibold Next period
              - if future_col&.starts_on
                %span.fw-normal.text-muted.small
                  = l(future_col.starts_on, format: :long)
                  –
                  = l(future_col.ends_on, format: :long)
              - else
                %span.fw-normal.text-muted.small n/a
        %tbody
          - analysis.rows.each do |row|
            %tr
              %td= row.label
              %td.text-end
                = render "organizations/billing/driver_activity_value", **lookback_mode, cell: row.lookback, driver_key: row.key, company_name: company_name, activity_scale: lookback_col.activity_scale
              %td.text-end
                = render "organizations/billing/driver_activity_value", **current_mode, cell: row.current, driver_key: row.key, company_name: company_name, activity_scale: current_col.activity_scale
              %td.text-end
                = render "organizations/billing/driver_activity_value", **future_mode, cell: row.future, driver_key: row.key, company_name: company_name, activity_scale: future_col.activity_scale
          %tr.fw-semibold
            %td Total
            %td.text-end
              = render "organizations/billing/ee_value", **lookback_mode, total_cell: analysis.totals[:lookback]
            %td.text-end
              = render "organizations/billing/ee_value", **current_mode, total_cell: analysis.totals[:current]
            %td.text-end
              = render "organizations/billing/ee_value", **future_mode, total_cell: analysis.totals[:future]
    - if analysis.any_incomplete?
      %p.text-muted.small.mb-0
        Lookback is the same ~90-day window used to set PEPM. Driver activity in This / Next period is scaled to that lookback length so monthly and six-month cadences compare fairly; Total PEPM is always monthly Value-page math. Incomplete periods show activity so far (+) with a pace projection to 100% in (~…), or a trend projection (~) if not started yet.
    - else
      %p.text-muted.small.mb-0
        Lookback is the same ~90-day window used to set PEPM. Driver activity in This / Next period is scaled to that lookback length so monthly and six-month cadences compare fairly; Total PEPM is always monthly Value-page math. Actual reflects value delivered during this period after it ended — even if that is less than what was paid for.
