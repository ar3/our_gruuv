- day_to_day_title = set_day_to_day_assignments_title
- content_for :title, teammate_context_page_title(@teammate, day_to_day_title)
- set_day_to_day_page_help_id = 'setDayToDayAssignmentsPageHelp'
- expand_add = @current_assignments.empty?
- available_count = @available_assignments.size

- content_for :header do
  .d-flex.flex-column.gap-1
    - trailing = capture do
      = render 'shared/page_help/header_info_button',
               collapse_id: set_day_to_day_page_help_id,
               tooltip: 'Set day-to-day assignment energy and MAAP flow. Click for details.'
    = render "shared/teammate_modality_header/switchers",
             organization: @current_organization,
             selected_teammate: @selected_teammate,
             viewable_teammate_groups: @viewable_teammate_groups,
             path_for_teammate: ->(tm) { assignment_tenure_check_in_bypass_organization_company_teammate_path(@current_organization, tm) },
             switch_aria_label: "Switch teammate for set day-to-day assignments",
             trailing: trailing
    %p.text-muted.mb-0= set_day_to_day_assignments_subtitle

- content_for :go_back_link do
  = nav_hierarchy_with_previous(organization: @current_organization, crumbs: [{ label: true_jd_teammate_view_suffix, url: internal_organization_company_teammate_path(@current_organization, @teammate) }, { label: day_to_day_title, url: nil }])

.collapse.mb-4{id: set_day_to_day_page_help_id}
  = render 'organizations/company_teammates/set_day_to_day_assignments_page_help',
           organization: @current_organization,
           teammate: @teammate

.row
  .col-12
    .card.mb-4
      .card-header
        %h5.mb-0
          %i.bi.bi-info-circle.me-2
          Instructions
      .card-body
        %p
          Use this page to update assignment tenure energy percentages without going through the normal check-in flow.
          Changes will be recorded in a MAAP snapshot for audit purposes.
        %p.mb-0
          %strong Note:
          Setting energy percentage to 0% will end the active tenure. Setting it to any other value will update or create a tenure as needed.

= form_with url: update_assignment_tenure_check_in_bypass_organization_company_teammate_path(@current_organization, @teammate), method: :patch, local: true do |form|
  - show_energy_bars = @assignment_energy_allocation&.contexts?
  - energy_select_data = show_energy_bars ? { action: "change->assignment-energy-allocation-finalization#refreshUpdatedFromDom" } : {}
  - employee_name = @assignment_energy_employee_name || @teammate.person.casual_name
  - manager_name = @assignment_energy_manager_name || 'Manager'
  - energy_allocation = @assignment_energy_allocation
  %div#tenure-bypass-assignment-energy-section{
    class: (show_energy_bars ? 'tenure-bypass-assignment-energy-section' : nil),
    data: (show_energy_bars ? {
      controller: 'assignment-energy-allocation-finalization',
      assignment_energy_allocation_finalization_colors_value: energy_allocation.color_by_assignment_id.to_json,
      assignment_energy_allocation_finalization_current_forecast_value: energy_allocation.current_forecast_by_assignment_id.to_json,
      assignment_energy_allocation_finalization_employee_actual_value: energy_allocation.employee_actual_by_assignment_id.transform_values { |v| v.nil? ? '' : v }.to_json,
      assignment_energy_allocation_finalization_updated_forecast_value: energy_allocation.updated_forecast_by_assignment_id.to_json,
      assignment_energy_allocation_finalization_assignments_value: energy_allocation.assignment_metadata_by_id.to_json,
      assignment_energy_allocation_finalization_employee_name_value: employee_name
    } : {})
  }
    - if show_energy_bars
      = render 'organizations/company_teammates/assignment_tenure_bypass_energy_section_help',
               employee_name: employee_name,
               manager_name: manager_name
      .assignment-energy-allocation-sticky-wrap
        = render 'organizations/company_teammates/finalizations/assignment_energy_allocation_panel',
                 summary: energy_allocation,
                 employee_name: employee_name,
                 manager_name: manager_name

    .card.mb-4#current-day-to-day-assignments
      .card-header
        %h5.mb-0
          %i.bi.bi-sliders.me-2
          Current Assignments
        %p.mb-0.text-muted.small
          Active tenures and position-required assignments. Adjust anticipated energy here.
      .card-body
        - if @current_assignments.any?
          .table-responsive
            %table.table.table-hover.mb-0
              %thead
                %tr
                  %th Assignment Name
                  %th Latest Tenure
                  %th Anticipated Energy %
                  %th Status
              %tbody
                - @current_assignments.each do |assignment|
                  = render 'organizations/company_teammates/assignment_tenure_bypass_row',
                    assignment: assignment,
                    form: form,
                    assignment_data: @assignment_data,
                    teammate: @teammate,
                    energy_select_data: energy_select_data,
                    required_assignment_ids: @required_assignment_ids
        - else
          .alert.alert-info.mb-0
            %i.bi.bi-info-circle.me-2
            No current day-to-day assignments yet. Add assignments below to set anticipated energy.

    .card.mb-4#add-day-to-day-assignments
      - unless expand_add
        .card-body.py-3.border-bottom
          %a.text-decoration-none{"data-bs-toggle" => "collapse", "data-bs-target" => "#addDayToDayAssignments", "aria-expanded" => "false", "aria-controls" => "addDayToDayAssignments", href: "#addDayToDayAssignments"}
            Need more of the #{available_count} available Assignments… add an assignment
      .collapse{id: "addDayToDayAssignments", class: ("show" if expand_add)}
        - if expand_add
          .card-header
            %h5.mb-0
              %i.bi.bi-plus-circle.me-2
              Add Assignments
            %p.mb-0.text-muted.small
              Set anticipated energy above 0% and save to start a tenure.
        .card-body
          - if @available_assignments.any?
            .mb-0{data: {controller: "options-filter"}}
              %input.form-control.form-control-lg.mb-3{type: "search", placeholder: "Search assignments by name or department...", "data-options-filter-target": "input", "aria-label": "Filter available assignments"}
              .table-responsive
                %table.table.table-hover.mb-0
                  %thead
                    %tr
                      %th Assignment Name
                      %th Latest Tenure
                      %th Anticipated Energy %
                      %th Status
                  %tbody{data: {"options-filter-target": "list"}}
                    - @available_assignments.each do |assignment|
                      = render 'organizations/company_teammates/assignment_tenure_bypass_row',
                        assignment: assignment,
                        form: form,
                        assignment_data: @assignment_data,
                        teammate: @teammate,
                        energy_select_data: energy_select_data,
                        required_assignment_ids: @required_assignment_ids,
                        filterable: true
          - else
            .alert.alert-info.mb-0
              %i.bi.bi-info-circle.me-2
              - if @current_assignments.any?
                All available assignments are already current.
              - else
                No assignments found in this organization hierarchy.

  .row.mt-4
    .col-12
      .d-flex.justify-content-end
        = form.submit "Save Changes", class: "btn btn-primary"
        = link_to "Cancel", internal_organization_company_teammate_path(@current_organization, @teammate), class: "btn btn-secondary ms-2"
