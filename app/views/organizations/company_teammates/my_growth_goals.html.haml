- content_for :title, "#{@selected_teammate.person.casual_name.strip}'s Growth"

- content_for :header do
  = render 'organizations/company_teammates/my_growth/header',
    path_for_teammate: ->(tm) { my_growth_goals_organization_company_teammate_path(organization, tm, timeframe: params[:timeframe]) },
    intent_text: "One stop for active goals, missing-goal opportunities, and goal history for this teammate."

= render 'organizations/company_teammates/my_growth/nav'

= render 'shared/context_callout' do
  %p.mb-0
    There are four ways to grow: new experiences, gaining skills/knowledge/abilities, goal attainment, and position/title changes. This is the third of the four.
    %span.fw-bold Grow by Goals.
    Setting goals — personal, professional, dream goals — these are an incredible way to track your progress to where you are wanting to go. Growth accountability!

- my_growth_goals_casual = @teammate.person.casual_name.presence || @teammate.person.display_name
- my_growth_goals_scope = Goal.where(company: organization, owner: @teammate).incomplete_unarchived
- my_growth_active_goals_count = my_growth_goals_scope.where.not(started_at: nil).count
- my_growth_draft_goals_count = @draft_goals_count || my_growth_goals_scope.where(started_at: nil).count
- my_growth_all_goals_count = my_growth_active_goals_count + my_growth_draft_goals_count
- grow_return_url = my_growth_goals_organization_company_teammate_path(organization, @teammate, timeframe: params[:timeframe])
- grow_return_text = "Back to Grow by Goals"
- nav_links = my_growth_goals_section_nav_links
- nav_title = "On this page"
- initial_section = "active-goals"

= render layout: "shared/in_page_section_nav/wrapper", locals: { nav_title: nav_title, nav_links: nav_links, initial_section: initial_section } do
  %section#active-goals.my-growth-section.mb-5{aria: { labelledby: "active-goals-heading" }}
    %h2#active-goals-heading.my-growth-section__title.mb-3
      %i.bi.bi-lightning-charge-fill.me-2.text-primary
      Active Goals

    .my-growth-section__body
      #active-goal-map
        = render 'shared/goals_weekly_charts',
          chart_title_period: @chart_title_period,
          goals_for_network_graph: @goals_for_network_graph,
          goal_links_for_network_graph: @goal_links_for_network_graph,
          organization: organization,
          goals_chart_data: { categories: [], series: [] },
          first_chart_dom_id: 'my-growth-goals-by-week-chart-active-placeholder',
          second_chart_dom_id: 'my-growth-goals-by-week-chart-hidden',
          hide_second_chart: true,
          hide_weekly_charts: true,
          wrap_class: 'container-fluid px-0',
          collapse_network_by_default: true,
          network_card_title: 'Visualize goal map'

      #active-confidence
        = render 'organizations/company_teammates/my_growth/bulk_confidence_check_section',
          organization: organization,
          teammate: @teammate,
          bulk_check_in_goals: @bulk_check_in_goals,
          bulk_check_in_hierarchy: @bulk_check_in_hierarchy

      .row.g-3.mt-1
        .col-md-6
          = link_to organization_goals_path(organization,
                    owner_id: "CompanyTeammate_#{@teammate.id}",
                    status: 'active',
                    view: 'hierarchical-collapsible',
                    return_url: grow_return_url,
                    return_text: grow_return_text),
                  class: "btn btn-outline-success w-100" do
            %i.bi.bi-box-arrow-up-right.me-2
            = go_add_confidence_checks_on_goals_label(name: my_growth_goals_casual, count: my_growth_active_goals_count)
        .col-md-6
          = link_to organization_goals_path(organization,
                    owner_id: "CompanyTeammate_#{@teammate.id}",
                    view: 'hierarchical-collapsible',
                    return_url: grow_return_url,
                    return_text: grow_return_text),
                  class: "btn btn-outline-info w-100" do
            %i.bi.bi-box-arrow-up-right.me-2
            = "Go review #{my_growth_goals_casual}'s #{pluralize(my_growth_all_goals_count, 'goal')} (draft + active)"

  %hr.my-5

  %section#missing-goals.my-growth-section.mb-5{aria: { labelledby: "missing-goals-heading" }}
    %h2#missing-goals-heading.my-growth-section__title.mb-3
      %i.bi.bi-exclamation-diamond.me-2.text-warning
      Missing Goals

    .my-growth-section__body
      #missing-draft-goals
        = render 'organizations/company_teammates/my_growth/missing_goals/drafts_summary',
          organization: organization,
          teammate: @teammate,
          recent_draft_goals: @recent_draft_goals,
          draft_goals_count: my_growth_draft_goals_count,
          return_url: grow_return_url,
          return_text: grow_return_text

      #missing-work-to-meet
        = render 'shared/work_to_meet/body',
          summary: @work_to_meet_summary,
          casual_name: my_growth_goals_casual,
          show_intro: true,
          nested: true,
          non_essential_collapse_id: 'growByGoalsNonEssentialWtmAssignments'

      #missing-exceed
        = render 'organizations/company_teammates/my_growth/missing_goals/exceed_expectation',
          organization: organization,
          teammate: @teammate,
          exceed_gaps: @exceed_expectation_gaps,
          return_url: grow_return_url,
          return_text: grow_return_text

      #missing-milestones
        = render 'organizations/company_teammates/my_growth/missing_goals/milestone_gaps',
          organization: organization,
          teammate: @teammate,
          milestone_gaps: @current_position_milestone_gaps,
          return_url: grow_return_url,
          return_text: grow_return_text

      = render 'organizations/company_teammates/my_growth/missing_goals/target_position_note',
        organization: organization,
        teammate: @teammate,
        target_position: @target_position_for_goals_note

  %hr.my-5

  %section#goal-history.my-growth-section.mb-5{aria: { labelledby: "goal-history-heading" }}
    .d-flex.flex-wrap.align-items-center.justify-content-between.gap-3.mb-3
      %h2#goal-history-heading.my-growth-section__title.mb-0
        %i.bi.bi-clock-history.me-2.text-secondary
        Goal History
      = render 'organizations/company_teammates/my_growth/goals_timeframe_toggle',
        teammate: @teammate,
        timeframe: @timeframe,
        anchor: 'goal-history',
        wrap_class: 'mb-0'

    .my-growth-section__body
      #goals-by-week
        = render 'shared/goals_weekly_charts',
          chart_title_period: @chart_title_period,
          goals_for_network_graph: nil,
          organization: organization,
          goals_chart_data: @goals_chart_data,
          first_chart_dom_id: 'my-growth-goals-by-week-chart',
          second_chart_dom_id: 'my-growth-goals-by-week-chart-hidden',
          hide_second_chart: true,
          hide_network: true,
          wrap_class: 'container-fluid px-0'

      = render 'organizations/company_teammates/my_growth/completed_goals_section',
        completed_goals_journey: @completed_goals_journey,
        chart_title_period: @chart_title_period,
        teammate: @teammate,
        timeframe: @timeframe,
        show_timeframe_toggle: false
