- casual = @teammate.person.casual_name
- employee_casual = casual
- manager_teammate = @teammate.active_employment_tenure&.manager_teammate
- manager_casual = manager_teammate&.person&.casual_name.presence || 'their manager'
- company_name = organization.display_name
- other_role = view_role == :employee ? :manager : :employee
- content_for :title, "#{casual}: Ability milestone calibration"

- content_for :go_back_link do
  = nav_hierarchy_with_previous(organization: organization, crumbs: [{ label: 'Grow by Abilities', url: my_growth_abilities_organization_company_teammate_path(organization, @teammate) }, { label: 'Milestone calibration', url: nil }])

.d-flex.align-items-center.flex-wrap.gap-2.mb-3
  %h1.h3.mb-0 Ability milestone calibration
  = render 'shared/page_help/header_info_button',
    collapse_id: 'abilityMilestoneCalibrationPageInfo',
    tooltip: 'Rate abilities one at a time. Click for details.'

.collapse.mb-4#abilityMilestoneCalibrationPageInfo
  = render 'organizations/company_teammates/ability_milestone_calibrations/page_help'

.alert.alert-info.mb-4
  %p.mb-1
    %strong One-time calibration.
    #{@entry_counts[:will_show]} of #{@entry_counts[:full_set]} abilities need calibration
    (abilities in this set still at Milestone 0).
  %p.mb-2.small
    - if view_role == :employee
      Both #{employee_casual} (you) and #{manager_casual} will rate what Milestone has been demonstrated so far at #{company_name} across all of the required Abilities.
    - else
      Both #{employee_casual} and #{manager_casual} (you) will rate what Milestone has been demonstrated so far at #{company_name} across all of the required Abilities.
  %p.mb-0.small
    Select a Milestone (1-5) to save immediately. That choice cannot be undone. Changes are kept in an audit trail.

- if @items.blank? && @history_items.blank?
  .alert.alert-secondary
    No abilities at Milestone 0 need rating right now.
    = link_to 'Back to Grow by Abilities', my_growth_abilities_organization_company_teammate_path(organization, @teammate), class: 'alert-link'
- else
  - milestones_by_key = ability_milestone_calibration_milestones_index(@teammate, @items)
  - ready_count = @ready_items.size
  - if ready_count.positive?
    .alert.alert-success.mb-4
      %p.mb-0
        %strong #{ready_count} #{'ability'.pluralize(ready_count)} ready to recognize and certify.
        Both of you have rated. Recognize and certify below on this page.

  - @items.each do |item|
    - ability = item.ability
    - my_rating = item.rating_for(view_role)
    - my_rated = item.rated_for?(view_role)
    - other_rated = item.other_rated_for?(view_role)
    - ability_pop = ability_milestone_calibration_ability_description_popover_html(ability)
    .card.mb-3{class: item.ready_for_review? ? 'border-success' : nil}
      .card-body
        .d-flex.flex-wrap.justify-content-between.align-items-start.gap-2.mb-2
          %h2.h5.mb-0
            = link_to ability.display_name,
              organization_teammate_ability_path(organization, @teammate, ability),
              class: 'text-decoration-none',
              data: { bs_toggle: 'popover', bs_html: true, bs_trigger: 'hover focus', bs_placement: 'right', bs_title: ability.display_name, bs_custom_class: 'complete-picture-milestone-popover', bs_content: ability_pop }
          .d-flex.flex-wrap.gap-1
            - if item.ready_for_review?
              %span.badge.bg-success Ready to recognize and certify
            - elsif my_rated && !other_rated
              %span.badge.bg-warning.text-dark Your rating saved
              %span.badge.bg-secondary Waiting on other participant
            - elsif !my_rated && other_rated
              %span.badge.bg-info.text-dark Other participant has rated
              %span.badge.bg-warning.text-dark Your rating still needed
            - else
              %span.badge.bg-light.text-dark.border Not rated yet

        - if my_rated || other_rated
          .small.text-muted.mb-3
            - if my_rated
              %div
                %span.fw-semibold You:
                = ability_milestone_calibration_rating_audit_lines(item, role: view_role).join(' · ')
            - if other_rated
              %div
                %span.fw-semibold Other participant:
                = ability_milestone_calibration_rating_audit_lines(item, role: other_role).join(' · ')

        - if item.ready_for_review?
          .row.g-3.mb-3
            .col-md-4
              .border.rounded.p-3.h-100
                %div.small.text-muted.mb-1 Employee proposal
                - emp_pop = ability_milestone_calibration_milestone_popover_html(ability, item.employee_rating)
                %div.fs-5.fw-semibold{role: 'button', tabindex: 0, data: { bs_toggle: 'popover', bs_html: true, bs_trigger: 'hover focus', bs_placement: 'top', bs_title: ability_milestone_calibration_rating_label(item.employee_rating), bs_custom_class: 'complete-picture-milestone-popover', bs_content: emp_pop }}
                  = ability_milestone_calibration_rating_label(item.employee_rating)
            .col-md-4
              .border.rounded.p-3.h-100
                %div.small.text-muted.mb-1 Manager proposal
                - mgr_pop = ability_milestone_calibration_milestone_popover_html(ability, item.manager_rating)
                %div.fs-5.fw-semibold{role: 'button', tabindex: 0, data: { bs_toggle: 'popover', bs_html: true, bs_trigger: 'hover focus', bs_placement: 'top', bs_title: ability_milestone_calibration_rating_label(item.manager_rating), bs_custom_class: 'complete-picture-milestone-popover', bs_content: mgr_pop }}
                  = ability_milestone_calibration_rating_label(item.manager_rating)
            .col-md-4
              .border.rounded.p-3.h-100{class: item.employee_rating == item.manager_rating ? 'border-success' : 'border-warning'}
                %div.small.text-muted.mb-1 Alignment
                - if item.employee_rating == item.manager_rating
                  %div.fw-semibold.text-success Same Milestone
                - else
                  %div.fw-semibold.text-warning Different. Talk it through.

          - if @can_award
            = form_with url: award_ability_milestone_calibration_item_organization_company_teammate_path(organization, @teammate, item), method: :post, local: true, data: { turbo: false, controller: 'ability-milestone-calibration-certify', ability_milestone_calibration_certify_ability_name_value: ability.display_name }, class: 'ability-milestone-calibration-award-form' do
              %label.form-label.small.mb-2 Official Milestone
              .btn-group.btn-group-sm.flex-wrap.mb-3{role: 'group', 'aria-label': "Official Milestone for #{ability.display_name}"}
                - (0..5).each do |milestone_n|
                  - input_id = "official_milestone_#{item.id}_#{milestone_n}"
                  - milestone_rec = milestones_by_key[[ability.id, milestone_n]]
                  - pop_html = ability_milestone_calibration_milestone_popover_html(ability, milestone_n, milestone_rec)
                  - btn_outline = milestone_n.zero? ? 'btn-outline-secondary' : 'btn-outline-primary'
                  - selected = !item.manager_rating.nil? && item.manager_rating == milestone_n
                  = radio_button_tag :official_milestone_level, milestone_n, selected, class: 'btn-check js-calibration-official-milestone', id: input_id, required: true, data: { action: 'change->ability-milestone-calibration-certify#officialChanged', milestone_n: milestone_n, milestone_label: milestone_n.zero? ? 'Milestone 0' : milestone_level_display(milestone_n) }
                  = label_tag input_id, nil, class: "btn #{btn_outline}", role: 'button', data: { bs_toggle: 'popover', bs_html: true, bs_trigger: 'hover focus', bs_placement: 'top', bs_title: "Milestone #{milestone_n}", bs_custom_class: 'complete-picture-milestone-popover', bs_content: pop_html } do
                    = milestone_n.zero? ? '0' : milestone_n.to_s

              = render 'organizations/company_teammates/ability_milestone_calibrations/recognize_and_certify',
                item: item,
                teammate: @teammate,
                ability: ability

              %div
                = submit_tag 'Recognize and certify', class: 'btn btn-primary'
          - else
            %p.small.text-muted.mb-0 Waiting for someone who can recognize and certify milestones to set the official Milestone.

          %hr.my-3

        = form_with url: ability_milestone_calibration_organization_company_teammate_path(organization, @teammate), method: :patch, local: true, data: { turbo: false }, class: 'ability-milestone-calibration-item-form', html: { id: "calibration-item-form-#{item.id}" } do
          = hidden_field_tag :item_id, item.id
          .btn-group.flex-wrap{role: 'group', "aria-label" => "Milestone rating for #{ability.display_name}"}
            - (1..5).each do |milestone_n|
              - input_id = "calibration_rating_#{item.id}_#{milestone_n}"
              - milestone_rec = milestones_by_key[[ability.id, milestone_n]]
              - pop_html = ability_milestone_calibration_milestone_popover_html(ability, milestone_n, milestone_rec)
              - checked = !my_rating.nil? && my_rating == milestone_n
              = radio_button_tag :rating, milestone_n, checked, class: 'btn-check', id: input_id, onchange: 'this.form.requestSubmit()'
              = label_tag input_id, nil, class: 'btn btn-outline-primary', role: 'button', data: { bs_toggle: 'popover', bs_html: true, bs_trigger: 'hover focus', bs_placement: 'top', bs_title: "Milestone #{milestone_n}", bs_custom_class: 'complete-picture-milestone-popover', bs_content: pop_html } do
                = milestone_n.to_s

  - if @history_items.any?
    - history_milestones_by_key = @teammate.teammate_milestones.where(ability_id: @history_items.map(&:ability_id)).index_by { |m| [m.ability_id, m.milestone_level] }
    .mt-5.pt-3.border-top
      %h2.h5.mb-3
        Milestones earned
        %span.text-muted.fw-normal.small
          (#{@history_items.size} #{'ability'.pluralize(@history_items.size)}. Collapsed by default.)
      - @history_items.each do |item|
        - ability = item.ability
        - collapse_id = "calibration-history-#{item.id}"
        - ability_pop = ability_milestone_calibration_ability_description_popover_html(ability)
        - official = item.official_milestone_level
        - earned_milestone = official.to_i.positive? ? history_milestones_by_key[[ability.id, official.to_i]] : nil
        .card.mb-2.border-secondary-subtle
          .card-header.py-2.bg-body-tertiary
            %button.btn.btn-link.text-decoration-none.text-body.w-100.text-start.d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.p-0{type: 'button', data: { bs_toggle: 'collapse', bs_target: "##{collapse_id}" }, aria: { expanded: 'false', controls: collapse_id }}
              %span
                %i.bi.bi-chevron-down.me-1.text-muted
                = ability.display_name
              %span.d-flex.flex-wrap.gap-2.align-items-center
                %span.badge{class: official.to_i.positive? ? 'bg-success' : 'bg-secondary'}
                  Official: #{ability_milestone_calibration_rating_label(official)}
                - if item.awarded_at.present?
                  %span.small.text-muted
                    Earned #{format_time_in_user_timezone(item.awarded_at)}
          .collapse{id: collapse_id}
            .card-body
              .row.g-3.mb-3
                .col-md-6
                  .border.rounded.p-3.h-100
                    %div.small.text-muted.mb-1 Employee proposal
                    %div.fs-5.fw-semibold.mb-2= ability_milestone_calibration_rating_label(item.employee_rating)
                    .small.text-muted
                      - ability_milestone_calibration_rating_audit_lines(item, role: :employee).each do |line|
                        %div= line
                .col-md-6
                  .border.rounded.p-3.h-100
                    %div.small.text-muted.mb-1 Manager proposal
                    %div.fs-5.fw-semibold.mb-2= ability_milestone_calibration_rating_label(item.manager_rating)
                    .small.text-muted
                      - ability_milestone_calibration_rating_audit_lines(item, role: :manager).each do |line|
                        %div= line
              - if item.awarded_by_teammate.present?
                %p.small.text-muted.mb-2
                  Certified by #{item.awarded_by_teammate.person.display_name}
                  - if item.awarded_at.present?
                    on #{format_time_in_user_timezone(item.awarded_at)}
              - if earned_milestone&.certification_note.present?
                .mb-2
                  %div.small.text-muted.mb-1 Reason
                  %p.small.mb-0= earned_milestone.certification_note
              - if earned_milestone.present?
                %p.mb-0
                  = link_to organization_teammate_milestone_path(organization, earned_milestone), class: 'small' do
                    View Milestone #{official}
                    %i.bi.bi-box-arrow-up-right.ms-1
