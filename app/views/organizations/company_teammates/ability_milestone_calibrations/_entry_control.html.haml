- counts = ability_milestone_calibration_entry_counts(teammate: teammate, organization: organization)
- if counts[:full_set].to_i >= 1
  - calibration = teammate.ability_milestone_calibration || AbilityMilestoneCalibration.new(teammate: teammate)
  - if policy(calibration).entry_control?
    .border.rounded.p-3.mb-3.bg-light
      %h3.h6.mb-2
        %i.bi.bi-sliders.me-1
        One-time ability milestone calibration
      %p.mb-2.small
        Establish a shared baseline once: employee and manager each rate privately, talk with ratings revealed, then award.
        After that, milestones are earned by demonstration—not another full calibration.
      %p.mb-3.mb-md-2.fw-semibold
        #{counts[:will_show]} of #{counts[:full_set]} abilities need calibration
      - if counts[:will_show].to_i.positive? || teammate.ability_milestone_calibration&.ready_for_review?
        = link_to ability_milestone_calibration_organization_company_teammate_path(organization, teammate), class: 'btn btn-outline-primary btn-sm' do
          - if teammate.ability_milestone_calibration&.ready_for_review?
            Continue calibration (ready for review)
          - else
            Start one-time milestone calibration
      - else
        %p.small.text-muted.mb-0 No abilities at milestone 0 in this set right now.
