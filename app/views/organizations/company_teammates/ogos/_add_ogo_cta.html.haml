-# Giant CTA to open new observation with this teammate pre-selected (skips type picker).
- return unless policy(Observation).create?

- new_ogo_path = new_organization_observation_path(organization, observee_ids: [@teammate.id], return_url: request.fullpath, return_text: "Back to #{@casual_name}'s OGOs")

.row.mb-4
  .col-10.offset-1
    = link_to new_ogo_path, class: "btn btn-primary btn-lg w-100 py-4 fs-3 fw-semibold" do
      %i.bi.bi-plus-lg.me-2
      Add an OGO about #{@casual_name}
