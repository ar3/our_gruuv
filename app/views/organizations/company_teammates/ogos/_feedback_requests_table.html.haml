- rows = local_assigns[:rows] || @feedback_request_rows || []

.table-responsive
  %table.table.table-hover.align-middle.mb-0
    %thead
      %tr
        %th Subject
        %th Requestor
        %th Request
        %th Questions
        %th Responses
    %tbody
      - rows.each do |row|
        - request = row.feedback_request
        - subject = request.subject_of_feedback_teammate
        - questions = request.feedback_request_questions.sort_by(&:position)
        - can_view = policy(request).show?
        - can_answer = policy(request).answer?
        - state_label = request.archived? ? 'Archived' : request.state.humanize
        - state_class = request.archived? ? 'bg-secondary' : 'bg-success'
        - state_tooltip = feedback_request_state_tooltip(request)
        %tr{class: "#{'text-muted' if request.archived?}"}
          %td
            .d-flex.align-items-center.gap-2
              = teammate_profile_image(subject, size: 32)
              %span= subject.person.display_name
          %td
            %div= feedback_request_requestor_display_name(request)
            %small.text-muted= format_time_in_user_timezone(request.created_at)
          %td
            - request_label = request.subject_line.presence || "Untitled request"
            .d-flex.flex-wrap.align-items-center.gap-2
              %span.badge{class: state_class, "data-bs-toggle": "tooltip", "data-bs-title": state_tooltip, title: state_tooltip}= state_label
              - if can_view
                = link_to request_label, organization_feedback_request_path(organization, request)
              - else
                %span= request_label
            - if can_answer
              .mt-2
                = link_to "Respond… Give Kudos and/or Feedback", answer_organization_feedback_request_path(organization, request), class: "btn btn-outline-primary"
          %td
            - if questions.any?
              %span.badge.bg-secondary{style: "cursor: pointer;",
                "data-bs-toggle" => "popover",
                "data-bs-trigger" => "hover focus",
                "data-bs-placement" => "left",
                "data-bs-html" => "true",
                "data-bs-title" => "Questions",
                "data-bs-content" => feedback_request_questions_popover_content(request),
                tabindex: 0}= questions.size
            - else
              %span.badge.bg-secondary 0
          %td
            %span= row.responses_label
            - if row.show_responder_details? && row.visible_responders.any?
              %ul.list-unstyled.mb-0.mt-1.small
                - row.visible_responders.each do |responder|
                  %li
                    = link_to responder.person.display_name, internal_organization_company_teammate_path(organization, responder), class: "text-decoration-none"
            - if row.show_responder_details? && row.awaiting_responders.any?
              %small.text-muted.d-block.mt-1
                No visible response yet:
                = row.awaiting_responders.map { |r| r.person.display_name }.join(", ")
