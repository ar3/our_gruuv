- page_help_id = "sourceFromSlackPageHelp"
- viewer = current_company_teammate
- return_to = ogos_source_from_slack_organization_company_teammate_path(organization, teammate_route_param(@teammate))

= render "page_header",
         page_help_id: page_help_id,
         page_help_tooltip: "Source draft OGOs from Slack moments already about #{@casual_name}. Click for details."

.collapse.mb-4{id: page_help_id}
  = render "source_from_slack_page_help", casual_name: @casual_name

= render "tabs"

.card.border-0.shadow-sm.mb-4
  .card-header.bg-transparent.border-0.d-flex.justify-content-between.align-items-center.flex-wrap.gap-2
    %h5.mb-0
      %i.bi.bi-chat-quote.me-2
      Slack moments about #{@casual_name}
    = link_to ogos_slack_search_runs_organization_company_teammate_path(organization, teammate_route_param(@teammate)), class: "btn btn-sm btn-outline-secondary" do
      %i.bi.bi-clock-history.me-1
      Search runs
  .card-body
    - if @filter_search
      .alert.alert-info.border.mb-3
        Filtered to run:
        %strong= @filter_search.display_name
        = link_to "Clear filter", ogos_source_from_slack_organization_company_teammate_path(organization, teammate_route_param(@teammate)), class: "ms-2"
    - moments = @slack_possible_observations || []
    - if moments.any?
      .list-group.list-group-flush
        - moments.each do |moment|
          .list-group-item.px-0
            .d-flex.justify-content-between.align-items-start.gap-3
              .flex-grow-1
                - if moment.summary.present?
                  %p.mb-1= moment.summary
                - quote = moment.quote
                - if quote.present?
                  %blockquote.blockquote.mb-2.small
                    %p.mb-0= quote
                .small.text-muted
                  - if moment.speaker_label.present?
                    %span.me-2= moment.speaker_label
                  - if moment.channel_name.present?
                    %span.me-2
                      %i.bi.bi-hash
                      = moment.channel_name
                  - elsif moment.private_or_dm?
                    %span.badge.text-bg-secondary.me-2 Private / DM
                  - else
                    %span.badge.text-bg-light.border.me-2 Public channel
                  - if moment.permalink.present?
                    = link_to "Open in Slack", moment.permalink, target: "_blank", rel: "noopener", class: "me-2"
                  %span= "#{format('%.0f%%', moment.confidence * 100)} confident"
              .flex-shrink-0
                = button_to "Dismiss",
                            dismiss_organization_company_teammate_slack_possible_observation_path(organization, teammate_route_param(@teammate), moment),
                            method: :post,
                            class: "btn btn-sm btn-outline-secondary",
                            form: { data: { turbo: false, confirm: "Dismiss this Slack moment for everyone?" } }
    - else
      %p.mb-0.text-muted
        No open Slack moments about #{@casual_name} yet. Run a search below — new finds land here for anyone who can view these OGOs (public channels) or for you alone (private / DMs).

.card.border-0.shadow-sm.mb-4
  .card-header.bg-transparent.border-0
    %h5.mb-0.d-flex.align-items-center.flex-wrap.gap-2
      %span
        %i.bi.bi-slack.me-2
        Source OGOs from Slack about #{@casual_name}
  .card-body
    - if viewer.nil?
      %p.mb-0.text-muted
        Sign in as a teammate in this organization to connect Slack search.
    - elsif viewer.has_slack_search_identity?
      .alert.alert-success.border.mb-3
        %i.bi.bi-check-circle.me-1
        Slack (search) is connected for
        %strong= viewer.person.casual_name
        — searches run with your Slack visibility.
      .d-flex.flex-wrap.gap-2.mb-4
        = link_to organization_company_teammate_slack_search_oauth_authorize_path(organization, teammate_route_param(viewer), source: "sourceFromSlack", return_to: return_to), class: "btn btn-outline-secondary btn-sm" do
          %i.bi.bi-arrow-repeat.me-1
          Reconnect
        = button_to organization_company_teammate_slack_search_disconnect_path(organization, teammate_route_param(viewer), return_to: return_to),
                    method: :delete,
                    class: "btn btn-outline-danger btn-sm",
                    data: { turbo: false, confirm: "Disconnect Slack (search)? You will not be able to search Slack as yourself until you reconnect." } do
          %i.bi.bi-x-circle.me-1
          Disconnect

      .mb-4
        %h6.fw-semibold.mb-2 Auto-refresh
        - if @auto_refresh_locked_by_hub
          .alert.alert-secondary.border.mb-0.py-2
            %i.bi.bi-lock.me-1
            Covered by your hub auto-refresh (self / direct reports). Turn hub off on Consult OG to change this.
        - elsif @auto_refresh_enabled
          = button_to ogos_slack_pogo_auto_refresh_organization_company_teammate_path(organization, teammate_route_param(@teammate)),
                      method: :delete,
                      class: "btn btn-outline-secondary btn-sm",
                      data: { turbo: false, confirm: "Turn off auto-refresh for #{@casual_name}?" } do
            %i.bi.bi-arrow-repeat.me-1
            Auto-refresh on for #{@casual_name} (every 14 days) — turn off
        - else
          = button_to ogos_slack_pogo_auto_refresh_organization_company_teammate_path(organization, teammate_route_param(@teammate)),
                      method: :post,
                      class: "btn btn-outline-primary btn-sm",
                      data: { turbo: false } do
            %i.bi.bi-arrow-repeat.me-1
            Keep #{@casual_name}’s pOGOs from Slack up-to-date (auto-refresh every 14 days)

      %h6.fw-semibold.mb-2 Run a new search
      = form_with url: organization_company_teammate_possible_observation_slack_searches_path(organization, teammate_route_param(@teammate)), method: :post, local: true, class: "row g-2 align-items-end" do
        .col-auto
          %label.form-label.mb-1{for: "slack-search-window-days"} Time window
          %select#slack-search-window-days.form-select{name: "possible_observation_slack_search[window_days]"}
            - PossibleObservationSlackSearch::ALLOWED_WINDOW_DAYS.each do |days|
              %option{value: days, selected: days == PossibleObservationSlackSearch::DEFAULT_WINDOW_DAYS}
                Last #{days} days
        .col-auto
          %button.btn.btn-primary{type: "submit"}
            %i.bi.bi-search.me-1
            Search Slack about #{@casual_name}
      %p.mt-2.mb-0.small.text-muted
        Uses your Slack (search) token. Prefer a linked Slack identity on #{@casual_name} for mention-based results; otherwise we search by name.
    - else
      %p.mb-3
        Connect
        %strong Slack (search)
        on your own profile so OurGruuv can search Slack
        %em as you
        (your visibility). This is separate from the linked Slack identity used for DMs and mentions.
      = link_to organization_company_teammate_slack_search_oauth_authorize_path(organization, teammate_route_param(viewer), source: "sourceFromSlack", return_to: return_to), class: "btn btn-primary" do
        %i.bi.bi-slack.me-1
        Sign in to Slack
      %p.mt-3.mb-0.text-muted
        %i.bi.bi-info-circle.me-1
        You can also connect or disconnect from your profile Identities section.

.card.border-0.shadow-sm
  .card-header.bg-transparent.border-0
    %h5.mb-0 Search history
  .card-body
    %p.mb-2.text-muted
      pOGOs are shared across runs. Open
      = link_to "Search runs", ogos_slack_search_runs_organization_company_teammate_path(organization, teammate_route_param(@teammate))
      for per-run stats (messages consulted, already known, dismissed / reviewing / published / not OGO-worthy).
    - recent = (@prior_slack_searches || []).first(5)
    - if recent.any?
      %ul.list-unstyled.mb-0
        - recent.each do |search|
          %li.mb-1
            = link_to search.display_name, ogos_slack_search_run_organization_company_teammate_path(organization, teammate_route_param(@teammate), search)
            %span.small.text-muted
              · #{search.search_status}
              · #{l(search.created_at, format: :short)}
    - else
      %p.mb-0.text-muted No Slack search runs about #{@casual_name} yet.
