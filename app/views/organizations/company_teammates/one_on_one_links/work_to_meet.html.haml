- hub_label = one_thing_label_for(@teammate)
- content_for :title, teammate_context_page_title(@selected_teammate, "#{hub_label} — Work to Meet")

- content_for :header do
  = render "shared/teammate_modality_header/switchers",
           organization: organization,
           selected_teammate: @selected_teammate,
           viewable_teammate_groups: @viewable_teammate_groups,
           path_for_teammate: ->(tm) { work_to_meet_organization_company_teammate_one_on_one_link_path(organization, teammate_route_param(tm)) },
           switch_aria_label: "Switch teammate for Work to Meet"

- content_for :go_back_link do
  = nav_hierarchy_with_previous(organization: organization, crumbs: [{ label: "Teammates", url: organization_employees_path(organization) }, { label: hub_label, url: organization_company_teammate_one_on_one_link_path(organization, teammate_route_param(@teammate)) }, { label: "Work to Meet", url: nil }])

- casual_name = @teammate.person.casual_name
- summary = @work_to_meet_summary

= render "hub_tabs", one_thing_active: false, detailed_active: false, work_to_meet_active: true, work_to_meet_summary: summary

.container-fluid
  = render "shared/work_to_meet/body", summary: summary, casual_name: casual_name, show_intro: true
