-# Locals: actions_needed, actions_total, label (optional heading override), compact (optional, smaller variant),
-#         tell_me_next (optional hash from CheckIns::UpNextTellMeNextService — overall spotlight only)
- actions_needed = local_assigns.fetch(:actions_needed)
- actions_total = local_assigns.fetch(:actions_total)
- actions_completed = actions_total - actions_needed
- label = local_assigns[:label]
- compact = local_assigns.fetch(:compact, false)
- tell_me_next = local_assigns[:tell_me_next]
- wrapper_class = compact ? "py-2 px-3 rounded border mb-0" : "card border mb-4"
- body_class = compact ? "mb-0" : "card-body py-4"
- heading_class = compact ? "h6 mb-1" : "h3 mb-2"
- stat_class = compact ? "h5 mb-1" : "display-6 mb-1"
- caption_class = compact ? "small text-muted mb-0" : "text-muted small mb-0"

%div{class: wrapper_class, role: "region"}
  - unless compact
    .card-header.bg-light
      %h6.mb-0.text-uppercase.text-muted Spotlight
  %div{class: body_class}
    - if tell_me_next.present? && !compact
      .d-flex.flex-column.flex-md-row.align-items-md-start.justify-content-between.gap-4
        %div.flex-grow-1
          - if label.present?
            %p{class: "#{heading_class} fw-semibold"}
              = label
          %p{class: stat_class}
            %span.text-success= actions_completed
            %span.text-muted
              of
              = actions_total
              clarifying #{"action".pluralize(actions_total)}
              completed
          %p{class: caption_class}
            %span ... meaning;
            %span.text-danger= actions_needed
            %span.text-muted
              of
              = actions_total
              #{"action".pluralize(actions_total)}
              needed for clarity
        .flex-shrink-0{style: "max-width: 22rem;"}
          %p.h6.mb-2.fw-semibold Just tell me what to do next
          - if tell_me_next[:note].present?
            %p.small.text-muted.mb-2= tell_me_next[:note]
          - if tell_me_next[:state] == :nudge && tell_me_next[:preview_text].present?
            .alert.alert-warning.py-2.px-3.small.mb-2{role: "status"}
              %p.fw-semibold.mb-1 This will send the following Slack message to you and the other person:
              %p.mb-0.text-break= tell_me_next[:preview_text]
            - if tell_me_next[:last_nudge].present?
              %p.small.text-muted.mb-2
                Last sent
                = time_ago_in_words(tell_me_next[:last_nudge].created_at)
                ago.
          - method = tell_me_next[:button_method].presence || :get
          - btn_class = tell_me_next[:state] == :all_clear ? "btn btn-outline-primary" : "btn btn-primary"
          - if method.to_sym == :post
            = button_to tell_me_next[:button_label],
                        tell_me_next[:button_url],
                        method: :post,
                        class: "#{btn_class} w-100 text-wrap"
          - else
            = link_to tell_me_next[:button_label],
                      tell_me_next[:button_url],
                      class: "#{btn_class} w-100 text-wrap text-center"
    - else
      - if label.present?
        %p{class: "#{heading_class} fw-semibold"}
          = label
      %p{class: stat_class}
        %span.text-success= actions_completed
        %span.text-muted
          of
          = actions_total
          clarifying #{"action".pluralize(actions_total)}
          completed
      %p{class: caption_class}
        %span ... meaning;
        %span.text-danger= actions_needed
        %span.text-muted
          of
          = actions_total
          #{"action".pluralize(actions_total)}
          needed for clarity
