-# locals: moment:, draft_observation: nil, teammate:, return_to: nil,
-#         actions: :manage (:manage = Promote/Dismiss; :evidence = Open in Slack only)
- draft = local_assigns[:draft_observation]
- return_to = local_assigns[:return_to]
- actions = local_assigns.fetch(:actions, :manage).to_sym
- suggestion_chip = moment.suggested_association_chip

.mb-3
  - if moment.summary.present?
    %p.mb-1.fw-semibold{style: "color: #495057;"}= moment.summary
  - if moment.quote.present?
    = render "shared/context_callout", margin_class: "mb-2" do
      %p.mb-0= moment.quote
  - if draft
    %p.mb-2.small
      %span.badge.text-bg-warning Draft OGO — needs publishing
  .d-flex.flex-wrap.align-items-center.justify-content-between.gap-2
    .d-flex.flex-wrap.align-items-center.gap-2.small
      - if moment.speaker_label.present?
        %span.text-muted= moment.speaker_label
      - if moment.channel_name.present?
        %span.text-muted
          %i.bi.bi-hash
          = moment.channel_name
      = slack_pogo_visibility_indicator(moment, subject: teammate, viewer: current_company_teammate)
      %span.text-muted= "#{format('%.0f%%', moment.confidence * 100)} confident"
      - if suggestion_chip.present?
        %span.badge.text-bg-light.border.text-muted.d-inline-flex.align-items-center.gap-1
          - if moment.suggested_rating.present?
            %span.rounded-circle.d-inline-block.flex-shrink-0{ class: ObservationRating.suggestion_dot_bg_class(moment.suggested_rating), style: "width:0.45rem;height:0.45rem;", title: ObservationRating.display_label(moment.suggested_rating), "aria-hidden" => "true" }
          %span= suggestion_chip
    - if actions == :manage
      .d-flex.flex-wrap.align-items-center.gap-1{ "aria-label" => "pOGO actions" }
        - if moment.permalink.present?
          = link_to "Open in Slack",
                    moment.permalink,
                    target: "_blank",
                    rel: "noopener",
                    class: "btn btn-sm btn-outline-secondary"
        - if draft
          = link_to "Open draft / Finish publishing",
                    organization_observation_path(organization, draft),
                    class: "btn btn-sm btn-primary"
        - else
          = button_to "Promote to OGO",
                      promote_organization_company_teammate_slack_possible_observation_path(organization, teammate_route_param(teammate), moment, return_to: return_to),
                      method: :post,
                      class: "btn btn-sm btn-outline-primary",
                      form: { data: { turbo: false }, class: "d-inline" }
          = button_to "Dismiss: this is not OGO-worthy",
                      dismiss_organization_company_teammate_slack_possible_observation_path(organization, teammate_route_param(teammate), moment, return_to: return_to),
                      method: :post,
                      class: "btn btn-sm btn-outline-danger",
                      form: { data: { turbo: false, confirm: "Dismiss this Slack moment for everyone? It will be treated as not OGO-worthy." }, class: "d-inline" }
    - elsif actions == :evidence
      .d-flex.flex-wrap.align-items-center.gap-1
        - if moment.permalink.present?
          = link_to "Open in Slack",
                    moment.permalink,
                    target: "_blank",
                    rel: "noopener",
                    class: "btn btn-sm btn-outline-secondary"
