-# Locals: seat, organization, teammate, casual_name
- seat = seat.with_indifferent_access

.mt-5
  %p.text-muted
    %em
      - if seat[:present]
        = seat[:disclaimer]
      - else
        = render "organizations/company_teammates/job_description_acknowledgements/no_seat_value", organization: organization, teammate: teammate, casual_name: casual_name

  %p.text-muted
    %strong Work environment:
    - if seat[:present]
      = seat[:work_environment]
    - else
      = render "organizations/company_teammates/job_description_acknowledgements/no_seat_value", organization: organization, teammate: teammate, casual_name: casual_name

  %p.text-muted
    %strong Physical requirements:
    - if seat[:present]
      = seat[:physical_requirements]
    - else
      = render "organizations/company_teammates/job_description_acknowledgements/no_seat_value", organization: organization, teammate: teammate, casual_name: casual_name

  %p.text-muted
    %strong Travel:
    - if seat[:present]
      = seat[:travel]
    - else
      = render "organizations/company_teammates/job_description_acknowledgements/no_seat_value", organization: organization, teammate: teammate, casual_name: casual_name
