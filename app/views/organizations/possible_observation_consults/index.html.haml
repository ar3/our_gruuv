.row.mb-3
  .col
    %h1.h3.mb-1
      Consult
      %i.bi.bi-stars
      OG to find potential OurGruuv Observations (pOGOs)
    %p.text-muted.mb-0
      Paste or upload a transcript, or start Slack searches for your direct reports from My Employees. Process candidates from either source here.

.mb-3.d-flex.flex-wrap.gap-2
  = link_to "New consult", new_organization_possible_observation_consult_path(organization), class: "btn btn-primary"
  - if current_company_teammate&.has_direct_reports? && policy(PossibleObservationSlackSearch).create?
    = button_to organization_direct_reports_slack_ogo_consults_path(organization),
                method: :post,
                class: "btn btn-outline-primary",
                data: { turbo: false, confirm: "Start a 30-day Slack search + stronger-model consultation for each of your direct reports? This may take a while — each person finishes separately. Results will appear on this page." } do
      %i.bi.bi-slack.me-1
      Refresh pOGOs for my direct reports (30 days)

.mb-3
  %p.small.text-muted.mb-2
    Transcript consults and Slack searches in one list.
    - if @prompt_debug_count.to_i.positive?
      · #{pluralize(@prompt_debug_count, "prompt-debug run")}
    - if @slack_searches_polling
      · In-flight Slack runs update automatically.
  .d-flex.flex-wrap.gap-2.align-items-center
    %span.small.text-muted Type
    .btn-group.btn-group-sm{ role: "group", "aria-label" => "Filter consultation type" }
      = link_to "All",
                organization_possible_observation_consults_path(organization),
                class: "btn #{@type_filter.blank? ? 'btn-secondary' : 'btn-outline-secondary'}"
      = link_to "Transcript",
                organization_possible_observation_consults_path(organization, type: "transcript"),
                class: "btn #{@type_filter == 'transcript' ? 'btn-secondary' : 'btn-outline-secondary'}"
      = link_to "Slack",
                organization_possible_observation_consults_path(organization, type: "slack"),
                class: "btn #{@type_filter == 'slack' ? 'btn-secondary' : 'btn-outline-secondary'}"

- if @hub_rows.any?
  .table-responsive{ "data-controller" => (@slack_searches_polling ? "hub-slack-search-status" : nil),
                     "data-hub-slack-search-status-url-value" => (@slack_searches_polling ? slack_search_statuses_organization_possible_observation_consults_path(organization) : nil) }
    %table.table.table-striped.align-middle
      %thead
        %tr
          %th Type
          %th Name
          %th Status
          %th.text-end pOGOs
          %th.text-end Dismissed
          %th.text-end Promoted
          %th Created
          %th
      %tbody
        - @hub_rows.each do |row|
          - if row[:type] == :slack
            - search = row[:record]
            - subject = search.subject_company_teammate
            - slack_stats = PossibleObservationSlackSearches::RunStats.call(search: search)
            %tr{ "data-hub-slack-search-status-row" => true, "data-search-id" => search.id }
              %td
                %span.badge.text-bg-dark Slack
              %td
                .fw-semibold= search.display_name
                .small.text-muted= subject&.person&.display_name
              %td
                %span.badge.text-bg-secondary{ "data-hub-phase" => true }= search.hub_phase
              %td.text-end{ "data-hub-pogo-count" => true }= slack_stats.pogos_reviewing + slack_stats.pogos_dismissed + slack_stats.pogos_published
              %td.text-end{ "data-hub-dismissed-count" => true }= slack_stats.pogos_dismissed
              %td.text-end{ "data-hub-promoted-count" => true }= slack_stats.pogos_published
              %td= l(search.created_at, format: :short)
              %td
                = link_to "Open",
                          ogos_slack_search_run_organization_company_teammate_path(organization, subject, search),
                          class: "btn btn-sm btn-outline-primary"
          - else
            - consult = row[:record]
            %tr
              %td
                %span.badge.text-bg-primary Transcript
              %td
                .fw-semibold
                  = consult.display_name
                  - if consult.prompt_debug?
                    %span.badge.text-bg-warning.ms-1 Debug
                .small.text-muted= consult.hub_teammate_caption
              %td
                %span.badge.text-bg-secondary= consult.hub_step_label
              %td.text-end= consult.pogo_count
              %td.text-end= consult.dismissed_pogo_count
              %td.text-end= consult.promoted_pogo_count
              %td= l(consult.created_at, format: :short)
              %td
                = link_to "Open", organization_possible_observation_consult_path(organization, consult), class: "btn btn-sm btn-outline-primary"
- else
  %p.text-muted
    - case @type_filter
    - when "transcript"
      No transcript consults yet. Start by pasting or uploading a transcript.
    - when "slack"
      No Slack searches yet. Refresh pOGOs for your direct reports to start one.
    - else
      No consultations yet. Start by pasting or uploading a transcript, or refresh Slack pOGOs for your direct reports.
