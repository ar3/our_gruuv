-# Locals: item, idx, editable, prompt_debug, identities_locked, linked_cue_ids, timestamp_label
- prompt_debug = local_assigns.fetch(:prompt_debug, false)
- identities_locked = local_assigns.fetch(:identities_locked, false)
- linked_cue_ids = Array(local_assigns[:linked_cue_ids])
- timestamp_label = local_assigns[:timestamp_label]
- included = ActiveModel::Type::Boolean.new.cast(item[:include])
- locked = item[:observation_id].present?
- observer_tm = @selectable_teammates.find { |tm| tm.id == item[:responder_company_teammate_id].to_i }
- subject_tm = @selectable_teammates.find { |tm| tm.id == item[:subject_company_teammate_id].to_i }
- dismissed = item[:dismissed_at].present?
- current_state = locked ? "included" : (dismissed ? "dismissed" : (included ? "included" : "needs_processed"))
-# Prompt-debug hone loop: edit while Keep Reviewing; product path still unlocks only on Create Draft OGO.
- field_disabled = locked || (!prompt_debug && current_state != "included")
- confidence = item[:confidence].to_f
- badge_class = confidence >= 0.75 ? "text-bg-success" : (confidence >= 0.5 ? "text-bg-warning" : "text-bg-secondary")
- include_label = prompt_debug ? "Would create draft OGO" : "Create Draft OGO"
- quote_rows = 11
- row_data = { consult_candidate_row: true, consult_prompt_debug: prompt_debug.presence }
- row_data = row_data.merge(prompt_debug_transcript_target: "item", item_id: item[:id], cue_ids: linked_cue_ids.join(",")) if prompt_debug
%tr{ data: row_data }
  %td
    = hidden_field_tag "items[#{idx}][id]", item[:id]
    = hidden_field_tag "items[#{idx}][confidence]", item[:confidence]
    = hidden_field_tag "items[#{idx}][observation_id]", item[:observation_id]
    = hidden_field_tag "items[#{idx}][summary]", item[:summary]
    = hidden_field_tag "items[#{idx}][short_quote]", item[:short_quote]
    = hidden_field_tag "items[#{idx}][full_quote]", item[:full_quote]
    = hidden_field_tag "items[#{idx}][speaker_label]", item[:speaker_label]
    = hidden_field_tag "items[#{idx}][recipient_label]", item[:recipient_label]
    = hidden_field_tag "items[#{idx}][suggested_rateable_type]", item[:suggested_rateable_type]
    = hidden_field_tag "items[#{idx}][suggested_rateable_id]", item[:suggested_rateable_id]
    = hidden_field_tag "items[#{idx}][suggested_rateable_name]", item[:suggested_rateable_name]
    = hidden_field_tag "items[#{idx}][suggested_rating]", item[:suggested_rating]
    = hidden_field_tag "items[#{idx}][association_reason]", item[:association_reason]
    = hidden_field_tag "items[#{idx}][rating_reason]", item[:rating_reason]
    = hidden_field_tag "items[#{idx}][suggested_goal_id]", item[:suggested_goal_id]
    = hidden_field_tag "items[#{idx}][dismissed_at]", item[:dismissed_at]
    = hidden_field_tag "items[#{idx}][dismissed_by_company_teammate_id]", item[:dismissed_by_company_teammate_id]
    .small.text-muted.mb-1
      - if timestamp_label.present?
        = timestamp_label
      - else
        —
      - if prompt_debug && linked_cue_ids.any?
        %span.ms-2
          %span.badge.text-bg-success.me-1 #{linked_cue_ids.size} cue#{'s' unless linked_cue_ids.one?}
          %button.btn.btn-link.btn-sm.p-0.align-baseline{
              type: "button",
              data: { action: "prompt-debug-transcript#highlightFromItem", item_id: item[:id], cue_ids: linked_cue_ids.join(",") }
            } Show in transcript
    = text_area_tag "items[#{idx}][quote]", item[:quote], class: "form-control form-control-sm", rows: quote_rows, disabled: field_disabled, data: { consult_row_field: true }
    .mt-2.fs-6
      %span.badge.me-2{ class: badge_class }= "#{format('%.0f%%', confidence * 100)} confident in this suggestion"
      - if item[:suggested_rating].present?
        - rating_label = ObservationRating.display_label(item[:suggested_rating]) if item[:suggested_rating].present?
        Suggested:
        %strong= rating_label
        for #{item[:suggested_rateable_name].presence || item[:suggested_rateable_type]}
  %td{ style: "min-width: 240px;" }
    .mb-2
      = label_tag nil, "What we'll do when we Save all at the end", class: "form-label small mb-1 d-block"
      - if locked
        = hidden_field_tag "items[#{idx}][state]", "included"
        %span.badge.text-bg-success Included (draft created)
      - else
        .btn-group.btn-group-sm.d-flex{ role: "group", "aria-label" => "What we'll do when we Save all at the end" }
          = radio_button_tag "items[#{idx}][state]", "needs_processed", current_state == "needs_processed", class: "btn-check", id: "consult_#{idx}_state_needs", data: { consult_state: true }
          = label_tag "consult_#{idx}_state_needs", "Keep Reviewing", class: "btn btn-outline-secondary"
          = radio_button_tag "items[#{idx}][state]", "included", current_state == "included", class: "btn-check", id: "consult_#{idx}_state_incl", data: { consult_state: true }
          = label_tag "consult_#{idx}_state_incl", include_label, class: "btn btn-outline-success"
          = radio_button_tag "items[#{idx}][state]", "dismissed", current_state == "dismissed", class: "btn-check", id: "consult_#{idx}_state_dismiss", data: { consult_state: true }
          = label_tag "consult_#{idx}_state_dismiss", "Dismiss", class: "btn btn-outline-danger"
        - unless prompt_debug
          - act_now_id = "consult_#{idx}_act_now"
          .mt-2
            %button.btn.btn-link.btn-sm.p-0.text-muted{
                type: "button",
                "data-bs-toggle" => "collapse",
                "data-bs-target" => "##{act_now_id}",
                "aria-expanded" => "false",
                "aria-controls" => act_now_id
              }
              …or act on just this one right now
            .collapse{ id: act_now_id }
              .d-flex.flex-column.align-items-start.gap-1.mt-1
                = button_tag "Create draft OGO now",
                             type: "submit",
                             name: "promote_item_id",
                             value: item[:id],
                             class: "btn btn-sm btn-link text-decoration-none p-0"
                = button_tag "Create published OGO now (private)",
                             type: "submit",
                             name: "publish_item_id",
                             value: item[:id],
                             class: "btn btn-sm btn-link text-decoration-none p-0"
                = button_tag "Dismiss now",
                             type: "submit",
                             name: "dismiss_item_id",
                             value: item[:id],
                             class: "btn btn-sm btn-link text-decoration-none p-0"
    %hr.my-2
    - @observation_type_options.each do |label, value|
      .form-check
        = radio_button_tag "items[#{idx}][kind]", value, item[:kind].to_s == value, class: "form-check-input", disabled: field_disabled, data: { consult_row_field: true }
        = label_tag nil, label, class: "form-check-label"
    - if identities_locked && !locked
      .mb-1
        = label_tag nil, "Observer", class: "form-label small mb-0 mt-2"
        = hidden_field_tag "items[#{idx}][responder_company_teammate_id]", item[:responder_company_teammate_id]
        .small= observer_tm&.person&.display_name.presence || "—"
      .mb-1
        = label_tag nil, "Subject", class: "form-label small mb-0 mt-2"
        = hidden_field_tag "items[#{idx}][subject_company_teammate_id]", item[:subject_company_teammate_id]
        .small= subject_tm&.person&.display_name.presence || "—"
    - else
      .mb-1{ data: { controller: "ogo-identity-alternates" } }
        = label_tag nil, "Observer", class: "form-label small mb-0 mt-2"
        = select_tag "items[#{idx}][responder_company_teammate_id]", options_for_select([["—", ""]] + @selectable_teammates.map { |tm| [tm.person.display_name, tm.id] }, item[:responder_company_teammate_id]), class: "form-select form-select-sm", disabled: locked, data: { ogo_identity_alternates_target: "select" }
        - unless locked
          = render "shared/og_identity_alternates", alternates: og_identity_alternates(item, :observer_alternates)
      .mb-1{ data: { controller: "ogo-identity-alternates" } }
        = label_tag nil, "Subject", class: "form-label small mb-0 mt-2"
        = select_tag "items[#{idx}][subject_company_teammate_id]", options_for_select([["—", ""]] + @selectable_teammates.map { |tm| [tm.person.display_name, tm.id] }, item[:subject_company_teammate_id]), class: "form-select form-select-sm", disabled: locked, data: { ogo_identity_alternates_target: "select" }
        - unless locked
          = render "shared/og_identity_alternates", alternates: og_identity_alternates(item, :observee_alternates)
  %td
    - if locked
      = link_to "Open draft OGO", organization_observation_path(organization, item[:observation_id]), class: "btn btn-sm btn-outline-primary"
    - elsif item[:responder_company_teammate_id].blank? || item[:subject_company_teammate_id].blank?
      %span.text-warning Needs IDs
    - else
      %span.text-muted Ready
