-# locals: organization, feedback_request, draft_ogo_count, return_to: nil, style: :button|:link
- draft_ogo_count = local_assigns.fetch(:draft_ogo_count, 0).to_i
- return_to = local_assigns[:return_to]
- style = local_assigns.fetch(:style, :button)
- skip_path = skip_organization_feedback_request_path(organization, feedback_request)
- skip_params = return_to.present? ? { return_to: return_to } : {}
- can_skip = draft_ogo_count.zero?
- blocked_message = feedback_request_skip_blocked_message(draft_ogo_count)
- btn_class = style == :link ? "btn btn-link btn-sm p-0 align-baseline" : "btn btn-outline-secondary"

- if can_skip
  = button_to "Skip this request",
              skip_path,
              method: :post,
              params: skip_params,
              class: btn_class,
              form: { class: "d-inline", data: { turbo_confirm: feedback_request_skip_confirm_message } }
- else
  - disabled_btn_class = style == :link ? "btn btn-link btn-sm p-0 align-baseline disabled" : "btn btn-outline-secondary"
  .d-inline-flex.align-items-center.gap-2
    %button{type: "button", class: disabled_btn_class, disabled: true, style: "opacity: 0.6; cursor: not-allowed;"}
      Skip this request
    %span.text-warning.flex-shrink-0{"data-bs-toggle" => "tooltip", "data-bs-title" => blocked_message, tabindex: "0", role: "img", "aria-label" => "Why Skip is unavailable"}
      %i.bi.bi-exclamation-triangle
