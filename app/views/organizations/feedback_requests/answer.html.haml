- content_for :title, "Answer Feedback Request"
- draft_ogo_count = @draft_ogo_count.to_i

- content_for :go_back_link do
  - if policy(@feedback_request).show?
    = nav_hierarchy_with_previous(organization: organization, crumbs: [{ label: "Feedback Requests", url: organization_feedback_requests_path(organization) }, { label: "Feedback Request", url: organization_feedback_request_path(organization, @feedback_request) }, { label: "Answer", url: nil }])
  - else
    = nav_hierarchy_with_previous(organization: organization, crumbs: [{ label: "Feedback Requests", url: organization_feedback_requests_path(organization) }, { label: "Answer", url: nil }])

- content_for :header do
  .d-flex.align-items-center
    %h1.mb-0.me-2
      %i.bi.bi-reply.me-2
      Answer Feedback Request

.alert.alert-light.border.mb-3.py-2{role: "status"}
  - if draft_ogo_count.zero?
    %span.text-muted.small Prefer not to answer?
    = render "organizations/feedback_requests/skip_this_request_control",
        organization: organization,
        feedback_request: @feedback_request,
        draft_ogo_count: draft_ogo_count,
        style: :link
  - else
    %span.text-muted.small
      = feedback_request_skip_blocked_message(draft_ogo_count)

.alert.alert-light.border.mb-3{role: "status"}
  %strong Submit a new set of observations.
  This form creates new OGOs for
  %strong= @feedback_request.subject_of_feedback_teammate.person.display_name
  when you save.
  - if @observation_by_question_id.any?
    You have an incomplete draft in progress below — saving updates that draft until you mark it complete.
  - elsif @prior_published_observations.any?
    You have submitted before; those earlier OGOs stay as they are.

- if @prior_published_observations.any?
  .alert.alert-secondary.mb-3
    %p.mb-2.small
      %strong Side note:
      You’ve submitted #{pluralize(@prior_published_observations.size, "observation")} from this request before.
    %ul.mb-0.small
      - @prior_published_observations.first(5).each do |observation|
        %li
          = link_to organization_observation_path(organization, observation) do
            - label = observation.feedback_request_question&.question_text.to_s.truncate(60).presence || "Observation"
            = "#{label} · #{format_time_in_user_timezone(observation.published_at)}"
      - if @prior_published_observations.size > 5
        %li.text-muted …and #{@prior_published_observations.size - 5} more

.card.mb-3
  .card-header
    %h5.mb-0 Request Details
  .card-body
    %p
      %strong Subject:
      = @feedback_request.subject_of_feedback_teammate.person.display_name
    - if @feedback_request.subject_line.present?
      %p
        %strong Subject line:
        = @feedback_request.subject_line
    %p.mb-0
      %strong Resources:
      - rateables = @questions.map(&:rateable).compact.uniq
      - if rateables.any?
        - rateables.each do |rateable|
          - case rateable.class.name
          - when 'Assignment'
            %span.badge.bg-primary.me-1= rateable.title
          - when 'Ability'
            %span.badge.bg-info.me-1= rateable.name
          - when 'Aspiration'
            %span.badge.bg-success.me-1= rateable.name
          - when 'Position'
            %span.badge.bg-dark.me-1= rateable.display_name
      - else
        %span.text-muted Generic

= form_with url: submit_answers_organization_feedback_request_path(organization, @feedback_request), method: :post, local: true do |form|
  - if flash[:alert]
    .alert.alert-danger= flash[:alert]

  = render "organizations/feedback_requests/answer_question_cards",
      organization: organization,
      feedback_request: @feedback_request,
      questions: @questions,
      observation_by_question_id: @observation_by_question_id,
      disabled: false

  .d-flex.justify-content-between.align-items-start.pt-2.gap-3.flex-wrap
    - cancel_path = policy(@feedback_request).show? ? organization_feedback_request_path(organization, @feedback_request) : ogos_feedback_requests_organization_company_teammate_path(organization, "me")
    = link_to 'Cancel', cancel_path, class: 'btn btn-secondary'
    .d-flex.flex-column.align-items-end
      .d-flex.flex-wrap.gap-2.justify-content-end
        = form.submit 'Save and Keep Incomplete', name: 'save_and_keep_incomplete', class: 'btn btn-outline-primary'
        = form.submit "Save and I'm Done!", name: 'save_and_complete', class: 'btn btn-primary'
        = render "organizations/feedback_requests/skip_this_request_control",
            organization: organization,
            feedback_request: @feedback_request,
            draft_ogo_count: draft_ogo_count,
            style: :button
      %p.form-text.text-muted.text-end.mb-0.mt-1{style: "max-width: 28rem;"}
        You don’t have to respond to all of the items on this list — even one is an incredible gift.
      - if draft_ogo_count.positive?
        %p.form-text.text-muted.text-end.mb-0.mt-1{style: "max-width: 28rem;"}
          = feedback_request_skip_blocked_message(draft_ogo_count)
