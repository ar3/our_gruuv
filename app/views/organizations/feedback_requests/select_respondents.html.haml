- content_for :title, "Who Can Respond"

- content_for :header do
  .d-flex.align-items-center
    %h1.mb-0.me-2
      %i.bi.bi-people.me-2
      Who Can Respond
    - if @feedback_request.subject_line.present?
      %small.text-muted.ms-2= @feedback_request.subject_line

- content_for :go_back_link do
  = nav_hierarchy_with_previous(organization: organization, crumbs: [{ label: "Feedback Questions", url: feedback_prompt_organization_feedback_request_path(organization, @feedback_request) }, { label: "Who Can Respond", url: nil }])

= render 'shared/feedback_request_wizard_header', organization: organization, feedback_request: @feedback_request, current_step: 4

- save_label = "Save who can respond"
- cancel_path = policy(@feedback_request).show? ? organization_feedback_request_path(organization, @feedback_request) : ogos_feedback_requests_organization_company_teammate_path(organization, "me")

= form_with url: update_respondents_organization_feedback_request_path(organization, @feedback_request), method: :patch, local: true do |form|
  .card.mb-4
    .card-header
      %h5.mb-0
        %i.bi.bi-people.me-2
        Who can respond
    .card-body
      - if flash[:alert]
        .alert.alert-danger= flash[:alert]

      %p.text-muted.mb-3
        Feedback about
        %strong= @feedback_request.subject_of_feedback_teammate.person.display_name
        is open to anyone with the link by default. Named respondents are optional — use them when you want inbox / Slack nudge accountability.

      .form-check.mb-4
        = hidden_field_tag "open_to_anyone", "0"
        = check_box_tag "open_to_anyone",
          "1",
          @feedback_request.open_to_anyone?,
          class: "form-check-input",
          id: "open_to_anyone"
        = label_tag "open_to_anyone", class: "form-check-label" do
          %strong Open to anyone with the link
          .form-text.mb-0
            Any logged-in teammate can open the permalink and submit new OGOs. Turn this off only when responses should be limited to named people.

      .mb-3{data: {controller: "selection-toolbar options-filter"}}
        %h6.mb-2 Named respondents
        %p.text-muted.small.mb-3
          Optional when the link is open. Required if you turn off “Open to anyone with the link.” Named people can be nudged in Slack and see this in their Feedback Requests inbox.

        - if @teammates.any?
          = render "shared/selection_pages/toolbar",
            form: form,
            save_label: save_label,
            can_manage: true,
            search_placeholder: "Search teammates...",
            search_aria_label: "Filter teammates",
            empty_selection_label: "None selected"

          .selection-page-columns{data: {options_filter_target: "list"}}
            - @teammates.each do |teammate|
              - checked = @selected_respondent_ids.include?(teammate.id)
              - display_name = teammate.person.preferred_first_then_last_display_name
              %label.card.filterable-option.text-decoration-none{for: "respondent_#{teammate.id}", style: "cursor: pointer;"}
                .card-body
                  .d-flex.align-items-start
                    .form-check.me-2.mt-1
                      = check_box_tag "respondent_ids[]",
                        teammate.id,
                        checked,
                        class: "form-check-input",
                        id: "respondent_#{teammate.id}",
                        data: {selection_toolbar_label: display_name}
                    .flex-grow-1
                      .d-flex.align-items-center.mb-2
                        .me-3
                          = teammate_profile_image(teammate, size: 48)
                        .flex-grow-1
                          %h6.mb-1= display_name
                      - active_tenure = teammate.employment_tenures.find { |tenure| tenure.ended_at.nil? && tenure.company_id == teammate.organization_id }
                      - department = active_tenure&.position&.title&.department
                      - if department
                        %p.text-muted.mb-1
                          %small Department: #{department.name}
                      - if active_tenure&.position&.title
                        %p.text-muted.mb-0
                          %small Position: #{active_tenure.position.title.external_title}
        - else
          .alert.alert-warning.mb-0
            No teammates available to select as respondents.

  .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.mb-4
    = link_to "Cancel", cancel_path, class: "btn btn-secondary"
    = render "shared/selection_pages/save_button", form: form, label: save_label, can_manage: true
