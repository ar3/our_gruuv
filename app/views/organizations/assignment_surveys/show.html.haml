= render "header"
= render "tabs", active_tab: :take

- unless @single_assignment_focus
  - if @due_count.to_i.positive?
    .alert.alert-light.border.mb-4
      %strong #{@due_count} assignment#{'s' if @due_count != 1} need feedback attention
      %span.text-muted — based on a check-in or assignment change since your last response.

- if @in_progress_responses.any?
  - if @form_errors.present?
    .alert.alert-danger
      %strong Please fix the following:
      %ul.mb-0
        - @form_errors.each do |message|
          %li= message

  = form_with url: organization_assignment_survey_path(organization, assignment_id: @focus_assignment_id),
    method: :patch,
    local: true,
    data: { controller: "check-in-autosave",
      action: "input->check-in-autosave#markDirty change->check-in-autosave#markDirty submit->check-in-autosave#handleSubmit",
      check_in_autosave_debounce_ms_value: 1200,
      check_in_autosave_message_value: "Your latest changes may still be saving. Leave this page?" } do |form|
    - @in_progress_responses.each_with_index do |response, index|
      - next if @focus_assignment_id.present? && response.assignment_id != @focus_assignment_id
      - due_status = @due_statuses&.[](response.assignment_id)
      - hide_fresh_feedback = hide_fresh_assignment_feedback_fields?(due_status, response, form_errors: @form_errors)
      - toggle_target = ".fresh-feedback-toggle-#{response.assignment_id}"
      = fields_for "assignment_survey_responses[#{index}]", response do |response_fields|
        .row.mt-5.mb-3{id: "assignment-survey-response-#{response.assignment_id}"}
          .col-12
            .d-flex.align-items-center.flex-wrap.gap-2
              %h3.text-primary.mb-0.me-3
                %i.bi.bi-clipboard2-check.me-2
                = response.snapshot_title
              .flex-grow-1
                %hr.border-primary
              %span.badge.text-bg-secondary= response.source_label
              - if due_status&.due?
                %span.badge.text-bg-warning Feedback due
              - elsif due_status&.early? && !hide_fresh_feedback
                %span.badge.text-bg-success Feedback fresh — you can still update early
        .mb-4
          - if response.snapshot_tagline.present?
            %p.text-muted= response.snapshot_tagline
          - if due_status&.early? && due_status.latest_submitted_at.present? && !hide_fresh_feedback
            %p.small.text-muted.mb-2
              Last submitted #{l(due_status.latest_submitted_at.to_date, format: :long)}. Your work is done here, but you can give feedback early.
          %details.mb-3
            %summary.fw-semibold Assignment outcomes and required activities
            .row.g-3.mt-1
              .col-12.col-lg-6
                %h4.h6 Outcomes
                - if response.snapshot_outcomes.any?
                  %ul.mb-0
                    - response.snapshot_outcomes.each do |outcome|
                      %li= outcome["description"]
                - else
                  %p.text-muted.mb-0 No outcomes are documented.
              .col-12.col-lg-6
                %h4.h6 Required activities
                - if response.snapshot_required_activities.present?
                  .markdown-content= render_markdown(response.snapshot_required_activities)
                - else
                  %p.text-muted.mb-0 No required activities are documented.
          - if hide_fresh_feedback
            %div{class: "collapse show fresh-feedback-toggle-#{response.assignment_id}"}
              .alert.alert-success.py-3.mb-0
                %i.bi.bi-check-circle-fill.me-2{style: "font-size: 1.15rem;"}
                - if due_status.latest_submitted_at.present?
                  %span
                    Last submitted #{l(due_status.latest_submitted_at.to_date, format: :long)}.
                    Your feedback is up to date.
                - else
                  %span Your feedback is up to date.
                .mt-2
                  %a{href: "#", "data-bs-toggle" => "collapse", "data-bs-target" => toggle_target, "aria-expanded" => "false"}
                    Click here to give feedback early
            %div{class: "collapse fresh-feedback-toggle-#{response.assignment_id}"}
              = render "assignment_response_form",
                form: form,
                response_fields: response_fields,
                single_assignment_focus: @single_assignment_focus
          - else
            = render "assignment_response_form",
              form: form,
              response_fields: response_fields,
              single_assignment_focus: @single_assignment_focus
          - if @focus_assignment_id.present?
            = hidden_field_tag "response_ids[]", response.id

    .d-flex.justify-content-between.align-items-center.flex-wrap.gap-3.mb-4
      %span.text-muted.d-none{data: { check_in_autosave_target: "status" }, "aria-live": "polite"}
      .d-flex.gap-2.ms-auto.flex-wrap.justify-content-end
        - if @single_assignment_focus
          = render "single_assignment_submit_buttons", form: form
        - else
          = form.submit "Save progress", class: "btn btn-outline-primary"
          = form.button "Submit filled feedback",
            type: :submit,
            name: "finalize",
            value: "1",
            class: "btn btn-primary"
- else
  .card.mb-4
    .card-body.text-center.py-5
      %i.bi.bi-clipboard2-check.display-4.text-muted
      %h2.h4.mt-3 No assignments to rate
      %p.text-muted.mx-auto
        You need an active or required assignment before you can give feedback here.

- if @submitted_responses.any? && !@single_assignment_focus
  .d-flex.justify-content-end.mb-4
    = link_to "View your feedback history",
      teammate_responses_organization_assignment_survey_path(organization, current_company_teammate),
      class: "btn btn-outline-secondary btn-sm"

= render "identifiable_notice"
