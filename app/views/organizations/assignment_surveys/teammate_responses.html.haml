= render "header"
= render "tabs", active_tab: :results

.mb-3
  = link_to results_organization_assignment_survey_path(organization), class: "text-decoration-none" do
    %i.bi.bi-arrow-left.me-1
    Back to results

.card.mb-4
  .card-body
    %h2.h3.mb-1= @teammate.person.display_name
    %p.text-muted.mb-0 Assignment experience feedback history

- if @in_progress_responses.any?
  .alert.alert-warning
    %strong In progress
    — #{@in_progress_responses.size} assignment#{'s' if @in_progress_responses.size != 1} with unsaved feedback.

- labels = { 1 => "Strongly disagree", 2 => "Disagree", 3 => "Somewhat disagree", 4 => "Somewhat agree", 5 => "Agree", 6 => "Strongly agree" }
- @submitted_responses.each do |response|
  .row.mt-5.mb-3
    .col-12
      .d-flex.align-items-center
        %h3.text-primary.mb-0.me-3
          %i.bi.bi-clipboard2-check.me-2
          = response.snapshot_title
        .flex-grow-1
          %hr.border-primary
        %span.badge.text-bg-secondary.ms-3= response.source_label
  .mb-4
    %p.text-muted.small.mb-2
      Submitted #{l(response.submitted_at, format: :long)}
    - if response.snapshot_tagline.present?
      %p.text-muted= response.snapshot_tagline
    - if response.personal_alignment.present?
      .mb-3
        %h4.h6 Personal alignment
        %p.mb-0= response.personal_alignment.humanize
    .row.g-3
      - rating_rows = [["Understandable", response.understandable_rating], ["Possible", response.possible_rating], ["Relevant", response.relevant_rating]]
      - rating_rows.each do |title, rating|
        .col-12.col-md-4
          .border.border-2.rounded.p-3.h-100{class: ("likert-answer-border-#{rating}" if rating)}
            .text-muted.small= title
            - if rating
              .fw-semibold{class: "likert-answer-text-#{rating}"}= labels.fetch(rating)
              .likert-scale-dots.mt-2{"aria-label": "#{labels.fetch(rating)} (#{rating} of 6)"}
                - (1..6).each do |value|
                  %span.likert-dot{class: "likert-dot-#{value} #{'filled' if value == rating}", title: labels.fetch(value)}
            - else
              .text-muted Not answered
    .mt-3
      %h4.h6 Comment
      - if response.comment.present?
        = simple_format(response.comment, {}, wrapper_tag: "div")
      - else
        %p.text-muted.mb-0 No comment provided.

- if @submitted_responses.empty?
  .alert.alert-info No submitted feedback yet for this teammate.
