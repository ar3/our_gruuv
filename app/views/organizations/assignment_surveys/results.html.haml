= render "header"
= render "tabs", active_tab: :results

.d-flex.justify-content-between.align-items-center.flex-wrap.gap-2.mb-4
  %p.text-muted.mb-0
    - if @results.show_people_results?
      Showing people you are authorized to support. Draft answers are included only in individual results.
    - else
      Showing org-wide score cards for assignments you maintain. Individual answers stay with the managerial hierarchy.
    - if @maintained_assignment_ids.present?
      %span.ms-1
        Assignment score cards you maintain include
        %strong org-wide finalized responses
        (not only people in your hierarchy).
  - if @results.show_people_results?
    = link_to export_organization_assignment_survey_path(organization), class: "btn btn-outline-primary" do
      %i.bi.bi-download.me-1
      Export CSV

- if @results.show_people_results?
  .row.g-3.mb-4
    .col-12.col-md-3
      .card.h-100
        .card-body
          .text-muted People in view
          .display-6= @results.teammates.size
    .col-12.col-md-3
      .card.h-100.border-success
        .card-body
          .text-muted Finalized
          .display-6.text-success= @results.finalized_teammate_count
    .col-12.col-md-3
      .card.h-100.border-warning
        .card-body
          .text-muted Draft
          .display-6.text-warning= @results.draft_teammate_count
    .col-12.col-md-3
      .card.h-100.border-secondary
        .card-body
          .text-muted Not started
          .display-6.text-secondary= @results.not_started_teammate_count

- if @results.show_overall_results?
  .card.mb-4
    .card-header
      %h2.h4.mb-0 Current overall results
    .card-body
      %p.text-muted
        Uses only each teammate's latest finalized survey among people you support. Distributions are primary; averages are a quick OG-graded reference.
      = render "quality_legend"
      .row.g-4.mt-1
        .col-12.col-lg-4
          = render "distribution",
            distributions: @results.overall_distributions,
            dimension: :understandable,
            title: "Understandable"
        .col-12.col-lg-4
          = render "distribution",
            distributions: @results.overall_distributions,
            dimension: :possible,
            title: "Possible"
        .col-12.col-lg-4
          = render "distribution",
            distributions: @results.overall_distributions,
            dimension: :relevant,
            title: "Relevant"

- if @results.show_assignment_score_results?
  .card.mb-4
    .card-header.d-flex.justify-content-between.align-items-center.flex-wrap.gap-2
      %h2.h4.mb-0 Results by assignment
      .d-flex.align-items-center.gap-2.flex-wrap
        %span.small.text-muted Sort by
        .btn-group.btn-group-sm{role: "group", "aria-label": "Sort assignments"}
          - [{ key: "name", label: "Name" }, { key: "average", label: "Average" }, { key: "responses", label: "Responses" }].each do |option|
            - active = @assignment_sort == option[:key]
            = link_to results_organization_assignment_survey_path(organization, sort: option[:key]),
              class: "btn #{active ? 'btn-primary' : 'btn-outline-secondary'}",
              "aria-current": (active ? "true" : nil) do
              = option[:label]
    .list-group.list-group-flush
      - @results.assignment_rows.each do |row|
        .list-group-item
          %details
            %summary.d-flex.justify-content-between.align-items-center.gap-3.flex-wrap
              %span.fw-semibold
                = row[:title]
                - if row[:org_wide]
                  %span.badge.text-bg-info.ms-2 Org-wide (maintainer)
              .d-flex.align-items-center.gap-3.ms-auto.flex-wrap
                .d-flex.align-items-center.gap-3.small.text-muted
                  = render "quality_average",
                    distributions: row[:distributions],
                    dimension: :understandable,
                    title: "Understandable",
                    show_label: true
                  = render "quality_average",
                    distributions: row[:distributions],
                    dimension: :possible,
                    title: "Possible",
                    show_label: true
                  = render "quality_average",
                    distributions: row[:distributions],
                    dimension: :relevant,
                    title: "Relevant",
                    show_label: true
                %span.badge.text-bg-secondary #{row[:response_count]} responses
            .row.g-4.mt-2
              .col-12.col-lg-4
                = render "distribution",
                  distributions: row[:distributions],
                  dimension: :understandable,
                  title: "Understandable"
              .col-12.col-lg-4
                = render "distribution",
                  distributions: row[:distributions],
                  dimension: :possible,
                  title: "Possible"
              .col-12.col-lg-4
                = render "distribution",
                  distributions: row[:distributions],
                  dimension: :relevant,
                  title: "Relevant"
- elsif !@results.show_overall_results?
  .alert.alert-info
    No finalized survey scores are available yet for the people or assignments you can see.

- if @results.show_people_results?
  .card.mb-4
    .card-header
      %h2.h4.mb-0 Individual results
    .table-responsive
      %table.table.table-hover.align-middle.mb-0
        %thead
          %tr
            %th Teammate
            %th Current status
            %th Finalized versions
            %th Latest finalized
            %th
        %tbody
          - @results.participation_rows.each do |row|
            %tr
              %td.fw-semibold= row[:teammate].person.display_name
              %td
                - case row[:status]
                - when :draft
                  %span.badge.text-bg-warning Draft
                - when :finalized
                  %span.badge.text-bg-success Finalized
                - else
                  %span.badge.text-bg-secondary Not started
              %td= row[:submission_count]
              %td
                - if row[:latest_finalized]
                  = l(row[:latest_finalized].finalized_at, format: :short)
                - else
                  %span.text-muted —
              %td.text-end
                - if row[:draft]
                  = link_to "View draft",
                    submission_organization_assignment_survey_path(organization, row[:draft].id),
                    class: "btn btn-sm btn-outline-warning"
                - elsif row[:latest_finalized]
                  = link_to "View responses",
                    submission_organization_assignment_survey_path(organization, row[:latest_finalized].id),
                    class: "btn btn-sm btn-outline-primary"
