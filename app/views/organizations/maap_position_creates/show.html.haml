- content_for :title, "Create proposal · Position"

- content_for :header do
  .d-flex.flex-wrap.align-items-center.gap-2
    %h1.mb-0 Position create proposal

- content_for :go_back_link do
  - crumbs = []
  - if @parent_seat_proposal
    - crumbs << { label: "Seats", url: organization_seats_path(@organization) }
    - crumbs << { label: "Proposed Seat creates", url: organization_maap_seat_creates_path(@organization) }
    - crumbs << { label: "Seat proposal", url: organization_maap_seat_create_path(@organization, @parent_seat_proposal) }
  - crumbs << { label: "Position proposal", url: nil }
  = nav_hierarchy_with_previous(organization: @organization, crumbs: crumbs)

.row.justify-content-center
  .col-lg-8
    = render "organizations/maap_proposals/parent_seat_create_link", parent_seat_proposal: @parent_seat_proposal

    .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.mb-3
      %div
        %span.badge.me-2{class: proposal_status_badge_class(@proposal.status)}= @proposal.status
        %span.text-muted
          Proposed by #{@proposal.proposer.person.display_name}
          - if @proposal.create_key.present?
            · create_key #{@proposal.create_key}
      .d-flex.flex-wrap.gap-2
        - if policy(@proposal).submit?
          = button_to "Submit", submit_organization_maap_position_create_path(@organization, @proposal), method: :post, class: "btn btn-primary btn-sm"

    .card.mb-4
      .card-header
        %h5.mb-0 Proposed content
      .card-body
        %h6.text-muted Title
        - title_name = Title.find_by(id: @payload.title_id)&.external_title
        %p
          = title_name.presence || (@payload.title_proposal_id.present? ? "Pending Title proposal ##{@payload.title_proposal_id}" : "None")
          - if @payload.title_proposal_id.present?
            %span.badge.text-bg-light.ms-1 via Title proposal ##{@payload.title_proposal_id}
        %h6.text-muted Position level
        %p= @payload.position_level_id.present? ? (PositionLevel.find_by(id: @payload.position_level_id)&.level || @payload.position_level_id) : "Hint: #{@payload.position_level_hint}"
        %h6.text-muted Position summary
        .markdown-content.mb-3= simple_format(@payload.position_summary.to_s.presence || "None")
        %h6.text-muted Assignment links
        - links = Array(@payload.assignment_links)
        - if links.any?
          %ul.mb-0
            - links.each do |link|
              %li
                = link["assignment_type"]
                - if link["assignment_id"].present?
                  · Assignment ##{link["assignment_id"]}
                - elsif link["assignment_proposal_id"].present?
                  · Assignment proposal ##{link["assignment_proposal_id"]}
                - if link["energy_percentage"].present?
                  · #{link["energy_percentage"]}%
        - else
          %p.text-muted.mb-0 None

    - if @proposal.applied? || @proposal.rejected?
      - decision_verb = @proposal.applied? ? "accepted" : "rejected"
      - decision_alert_class = @proposal.applied? ? "alert-success" : "alert-danger"
      - decider_name = @proposal.decided_by&.person&.display_name || "Someone"
      .alert{class: "#{decision_alert_class} mb-4", role: "region", "aria-labelledby": "position-create-proposal-decision"}
        %h5.alert-heading.mb-2{ id: "position-create-proposal-decision" }
          %i.bi{class: "#{@proposal.applied? ? 'bi-check-circle' : 'bi-x-circle'} me-2"}
          Proposal #{decision_verb}
        %p.mb-2
          #{decider_name} #{decision_verb} this create proposal
          - if @proposal.decided_at.present?
            on #{l(@proposal.decided_at, format: :long)}
          - if @proposal.applied? && @proposal.proposable
            %span
              · created
              = link_to @proposal.proposable.display_name, organization_position_path(@organization, @proposal.proposable)
        - if @proposal.decision_note.present?
          %p.mb-0
            %strong Note:
            = @proposal.decision_note
        - else
          %p.mb-0.text-muted No note was left with this decision.
    - else
      - decision_disabled_reason = maap_proposal_decision_disabled_reason(@proposal)
      .card.mb-4{ role: "region", "aria-labelledby": "position-create-proposal-review" }
        .card-header
          %h5.mb-0{ id: "position-create-proposal-review" } Review
        .card-body
          - if decision_disabled_reason.blank?
            = form_with url: apply_organization_maap_position_create_path(@organization, @proposal), method: :post, local: true do
              %p.text-muted.small
                Applying creates or updates a Position for the Title. Linked Seat proposals can still be approved or rejected separately.
              .mb-3
                = label_tag :decision_note, "Note (optional)", class: "form-label"
                = text_area_tag :decision_note, nil, class: "form-control", rows: 2
              .d-flex.flex-wrap.gap-2
                = submit_tag "Apply proposal", class: "btn btn-success"
            = form_with url: reject_organization_maap_position_create_path(@organization, @proposal), method: :post, local: true, class: "mt-3" do
              .mb-3
                = label_tag :decision_note, "Rejection note (optional)", class: "form-label"
                = text_area_tag :decision_note, nil, class: "form-control", rows: 2
              = submit_tag "Reject proposal", class: "btn btn-outline-danger", data: { turbo_confirm: "Reject this proposal?" }
          - else
            .d-flex.flex-wrap.align-items-center.gap-2
              %button.btn.btn-success{type: "button", disabled: true, "aria-label" => "Apply proposal"} Apply proposal
              %span.text-warning{"data-bs-toggle" => "tooltip", "data-bs-placement" => "top", "data-bs-title" => decision_disabled_reason, tabindex: "0", role: "img", "aria-label" => "Permission notice"}
                %i.bi.bi-exclamation-triangle
              %button.btn.btn-outline-danger{type: "button", disabled: true, "aria-label" => "Reject proposal"} Reject proposal
              %span.text-warning{"data-bs-toggle" => "tooltip", "data-bs-placement" => "top", "data-bs-title" => decision_disabled_reason, tabindex: "0", role: "img", "aria-label" => "Permission notice"}
                %i.bi.bi-exclamation-triangle
