- content_for :title, "Proposed Position creates"
- page_help_id = "maapPositionCreatesPageHelp"

- content_for :header do
  .d-flex.flex-wrap.align-items-center.gap-2
    %h1.mb-0.d-flex.align-items-center.flex-wrap.gap-2
      %span Proposed Position creates
      = render "shared/page_help/header_info_button",
               collapse_id: page_help_id,
               tooltip: "Review Position create proposals from MAAP Suggestion. Click for how they work."

- content_for :go_back_link do
  = nav_hierarchy_with_previous(organization: @organization, crumbs: [{ label: "Positions", url: organization_positions_path(@organization) }, { label: "Proposed Position creates", url: nil }])

.collapse.mb-4{id: page_help_id}
  = render "organizations/maap_position_creates/page_help"

.row.justify-content-center
  .col-lg-10
    .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.mb-4
      %p.text-muted.mb-0
        Position create drafts usually come from
        = link_to "Suggest MAAP changes", organization_seat_suggestion_path(@organization)
        \. Teammates who can create Positions apply or reject submitted proposals. Apply often needs the linked Title first.

    = form_with url: organization_maap_position_creates_path(@organization), method: :get, local: true, class: "mb-3" do
      .d-flex.flex-wrap.align-items-center.gap-3
        %span.small.text-muted.fw-semibold Status
        - @filterable_statuses.each do |status|
          .form-check.form-check-inline.mb-0
            = check_box_tag "statuses[]",
                            status,
                            @selected_statuses.include?(status),
                            id: "position_create_proposal_status_#{status}",
                            class: "form-check-input",
                            onchange: "this.form.requestSubmit()"
            = label_tag "position_create_proposal_status_#{status}", status.titleize, class: "form-check-label"

    - if @proposals.any?
      .list-group
        - @proposals.each do |proposal|
          = link_to organization_maap_position_create_path(@organization, proposal), class: "list-group-item list-group-item-action" do
            .d-flex.justify-content-between.align-items-start.gap-3
              %div
                %strong= proposal.proposed_title.presence || "Untitled Position create"
                .small.text-muted
                  = proposal.proposer.person.display_name
                  · created #{l(proposal.created_at, format: :short)}
                  - if proposal.applied? && proposal.proposable
                    · applied as #{proposal.proposable.display_name}
              %span.badge{class: proposal_status_badge_class(proposal.status)}= proposal.status
    - else
      %p.text-muted.mb-0 No create proposals match these filters.
