- content_for :title, "#{all_proposed_edits_label(@assignment)} · #{@assignment.title}"
- page_help_id = "assignmentMaapProposalsPageHelp"

- content_for :header do
  .d-flex.flex-wrap.align-items-center.gap-2
    %h1.mb-0.d-flex.align-items-center.flex-wrap.gap-2
      = render "organizations/assignments/assignment_switcher",
               organization: @organization,
               assignment: @assignment,
               assignments_by_department: @assignments_by_department_for_switcher,
               path_for: ->(asg) { organization_assignment_maap_proposals_path(@organization, asg) },
               switch_aria_label: "Switch assignment for proposed edits"
      = render "shared/page_help/header_info_button",
               collapse_id: page_help_id,
               tooltip: "Everyone can help keep MAAP relevant. Click for how proposals work."
      - if policy(MaapProposal).create?
        = link_to new_organization_assignment_maap_proposal_path(@organization, @assignment),
                  class: "btn btn-primary",
                  title: "Propose edit",
                  "aria-label" => "Propose edit",
                  data: { "bs-toggle" => "tooltip", "bs-placement" => "top" } do
          %i.bi.bi-pencil

- content_for :header_action do
  = render "assignments/view_switcher"

- content_for :go_back_link do
  = nav_hierarchy_with_previous(organization: @organization, crumbs: [{ label: "Assignments", url: organization_assignments_path(@organization) }, { label: @assignment.title, url: organization_assignment_path(@organization, @assignment) }, { label: all_proposed_edits_label(@assignment), url: nil }])

.collapse.mb-4{id: page_help_id}
  = render "organizations/assignments/maap_proposals/page_help"

.row.justify-content-center
  .col-lg-10
    .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.mb-4
      %p.text-muted.mb-0
        Propose apply-ready edits to this assignment. Editors with MAAP update permission can apply or reject submitted proposals.
      .d-flex.flex-wrap.gap-2
        - if policy(MaapProposal).upload_markdown?
          = link_to markdown_template_organization_assignment_maap_proposals_path(@organization, @assignment), class: "btn btn-outline-secondary" do
            %i.bi.bi-download.me-1
            Download markdown template
          %button.btn.btn-outline-secondary{type: "button", "data-bs-toggle": "collapse", "data-bs-target": "#uploadMarkdownCollapse"}
            %i.bi.bi-upload.me-1
            Upload markdown

    - if policy(MaapProposal).upload_markdown?
      #uploadMarkdownCollapse.collapse.mb-4
        .card
          .card-body
            = form_with url: upload_markdown_organization_assignment_maap_proposals_path(@organization, @assignment), method: :post, multipart: true, local: true do |f|
              .mb-3
                = label_tag :markdown_file, "Markdown file", class: "form-label"
                = file_field_tag :markdown_file, accept: ".md,text/markdown,text/plain", class: "form-control"
              .mb-3
                = label_tag :markdown_body, "Or paste markdown", class: "form-label"
                = text_area_tag :markdown_body, nil, rows: 8, class: "form-control font-monospace"
              = submit_tag "Create draft from markdown", class: "btn btn-primary"

    = form_with url: organization_assignment_maap_proposals_path(@organization, @assignment), method: :get, local: true, class: "mb-3" do
      .d-flex.flex-wrap.align-items-center.gap-3
        %span.small.text-muted.fw-semibold Status
        - @filterable_statuses.each do |status|
          .form-check.form-check-inline.mb-0
            = check_box_tag "statuses[]",
                            status,
                            @selected_statuses.include?(status),
                            id: "proposal_status_#{status}",
                            class: "form-check-input",
                            onchange: "this.form.requestSubmit()"
            = label_tag "proposal_status_#{status}", status.titleize, class: "form-check-label"

    - if @proposals.any?
      .list-group
        - @proposals.each do |proposal|
          = link_to organization_assignment_maap_proposal_path(@organization, @assignment, proposal), class: "list-group-item list-group-item-action" do
            .d-flex.justify-content-between.align-items-start.gap-3
              %div
                %strong= proposal.proposed_payload["title"].presence || @assignment.title
                .small.text-muted
                  = proposal.proposer.person.display_name
                  ·
                  = proposal.status.titleize
                  · created #{l(proposal.created_at, format: :short)}
                  - if proposal.submitted_at
                    · submitted #{l(proposal.submitted_at, format: :short)}
              %span.badge{class: proposal_status_badge_class(proposal.status)}= proposal.status
    - else
      .alert.alert-light.border
        - if @selected_statuses.empty?
          No statuses selected. Check a status above to see proposals.
        - elsif params.key?(:statuses)
          No proposals match the selected statuses.
        - else
          No proposals yet. Create one to suggest an apply-ready edit.
