.card.mb-3{"data-maap-proposal-rows-target" => "row"}
  .card-body
    .d-flex.justify-content-between.align-items-start.gap-2.mb-2
      %h6.mb-0= label
      %button.btn.btn-sm.btn-outline-danger{type: "button", "data-action" => "maap-proposal-rows#remove"}
        %i.bi.bi-trash
        Remove
    .mb-0
      %label.form-label Assignment
      = select_tag "maap_proposal[#{param_key}][]",
                   assignments_grouped_options_for_select(assignments, selected_id),
                   include_blank: "Select assignment",
                   class: "form-select"
