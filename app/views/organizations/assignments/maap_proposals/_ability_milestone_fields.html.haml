- assignment_name = local_assigns.fetch(:assignment_name)
- milestone_options = (1..5).map { |level| ["M#{level} – #{milestone_level_display(level)}", level] }
- selected_level = row["milestone_level"].presence || 2

.card.mb-3{"data-maap-proposal-rows-target" => "row"}
  .card-body
    .d-flex.justify-content-end.mb-2
      %button.btn.btn-sm.btn-outline-danger{type: "button", "data-action" => "maap-proposal-rows#remove"}
        %i.bi.bi-trash
        Remove
    .row.g-3.align-items-end
      .col-md-4
        %label.form-label Milestone
        = select_tag "maap_proposal[ability_milestones][][milestone_level]",
                     options_for_select(milestone_options, selected_level),
                     class: "form-select"
      .col-md-8
        %label.form-label
          To be qualified for #{assignment_name}, you must have the following Ability (skill, knowledge, competency, or demonstrated behavior)
        = select_tag "maap_proposal[ability_milestones][][ability_id]",
                     abilities_grouped_options_for_select(abilities, row["ability_id"]),
                     include_blank: "Select ability",
                     class: "form-select"
