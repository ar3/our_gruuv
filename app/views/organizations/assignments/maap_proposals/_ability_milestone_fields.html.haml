.card.mb-3{"data-maap-proposal-rows-target" => "row"}
  .card-body
    .d-flex.justify-content-between.align-items-start.gap-2.mb-2
      %h6.mb-0 Ability milestone
      %button.btn.btn-sm.btn-outline-danger{type: "button", "data-action" => "maap-proposal-rows#remove"}
        %i.bi.bi-trash
        Remove
    .mb-2
      %label.form-label Ability
      = select_tag "maap_proposal[ability_milestones][][ability_id]",
                   abilities_grouped_options_for_select(abilities, row["ability_id"]),
                   include_blank: "Select ability",
                   class: "form-select"
    .mb-0
      %label.form-label Milestone level (1–5)
      = number_field_tag "maap_proposal[ability_milestones][][milestone_level]",
                         row["milestone_level"].presence || 2,
                         class: "form-control",
                         min: 1,
                         max: 5
