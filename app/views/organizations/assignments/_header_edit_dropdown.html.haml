-# Locals: organization, assignment
- organization = local_assigns.fetch(:organization)
- assignment = local_assigns.fetch(:assignment)
- can_suggest = policy(MaapProposal).create?
- can_edit = policy(assignment).update?

- if can_suggest || can_edit
  .dropdown
    %button.btn.btn-primary.dropdown-toggle{type: "button", "data-bs-toggle" => "dropdown", "aria-expanded" => "false", "aria-label" => "Edit or suggest edit", title: "Edit or suggest edit"}
      %i.bi.bi-pencil
    %ul.dropdown-menu
      %li
        - if can_suggest
          = link_to new_organization_assignment_maap_proposal_path(organization, assignment), class: "dropdown-item" do
            %i.bi.bi-lightbulb.me-2
            Suggest Edit
        - else
          .dropdown-item.text-muted.disabled
            %i.bi.bi-lightbulb.me-2
            Suggest Edit
            %i.bi.bi-exclamation-triangle.text-warning.ms-2{"data-bs-toggle" => "tooltip", "data-bs-title" => "You must be in the organization to suggest an edit"}
      %li
        - if can_edit
          = link_to edit_organization_assignment_path(organization, assignment), class: "dropdown-item" do
            %i.bi.bi-pencil.me-2
            Edit
        - else
          .dropdown-item.text-muted.disabled
            %i.bi.bi-pencil.me-2
            Edit
            %i.bi.bi-exclamation-triangle.text-warning.ms-2{"data-bs-toggle" => "tooltip", "data-bs-title" => "You need employment management permissions or admin access to edit assignments"}
