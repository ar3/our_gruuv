- content_for :title, "Manage assignment reliance for #{@assignment.title}"

- content_for :header do
  %h1.mb-0
    %i.bi.bi-diagram-3.me-2
    Manage assignment reliance for #{@assignment.title}

- content_for :return_url do
  = @return_url || organization_assignment_path(@organization, @assignment)

- content_for :return_text do
  = @return_text || "Back to #{@assignment.title}"

- can_manage = policy(@assignment).manage_consumer_assignments?

.card
  .card-header
    %h5.mb-0
      %i.bi.bi-diagram-3.me-2
      Assignment Reliance
    %p.mb-0.text-muted
      Set whether each assignment is upstream of this assignment, downstream of this assignment, or not associated.
      Arrows in Accountability Flow run left → right: upstream supplies, downstream relies.

  .card-body
    = form_with url: organization_assignment_consumer_assignments_path(@organization, @assignment), method: :patch, local: true do |form|
      = render "organizations/assignments/consumer_assignments/reliance_form_sections",
        form: form,
        associated_assignments: @associated_assignments,
        available_assignments: @available_assignments,
        existing_directions_by_assignment_id: @existing_directions_by_assignment_id,
        subject_name: @assignment.title,
        can_manage: can_manage

      .mt-4.d-flex.justify-content-between
        = link_to "Cancel", @return_url, class: "btn btn-secondary"
        - if can_manage
          = form.submit "Save Assignment Reliance", class: "btn btn-primary"
        - else
          %span{title: "Requires manage MAAP permission", "data-bs-toggle": "tooltip"}
            = form.submit "Save Assignment Reliance", class: "btn btn-primary", disabled: true
