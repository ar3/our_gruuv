- content_for :title, "MCP/API access tokens"

- content_for :header do
  .d-flex.align-items-center
    %h1.mb-0.me-2
      %i.bi.bi-key.me-2
      MCP/API access tokens

- content_for :go_back_link do
  = nav_hierarchy_with_previous(organization: @organization, crumbs: [{ label: "Integrations", url: organization_integrations_path(@organization) }, { label: "MCP/API access tokens", url: nil }])

.alert.alert-light.border.mb-4
  %p.mb-2
    These personal Bearer tokens authorize
    %strong MCP
    and the
    %strong Mint Feedback Request
    HTTP API as your teammate in this organization.
  %p.mb-2
    Prefer
    %strong Claude Connectors with OAuth
    for MCP (no paste): add
    %code= "#{request.base_url}/mcp"
    in Claude Settings → Connectors, then sign in with Google and pick an organization.
  %p.mb-0.small.text-muted
    Tokens below are for Zapier, Claude Code / Desktop bridges, scripts, and anything that needs
    %code Authorization: Bearer ogmcp_…
    \.

- if @raw_token.present?
  .alert.alert-warning.mb-4
    %p.fw-semibold.mb-2 Copy this token now — it won’t be shown again.
    %code.user-select-all= @raw_token

.card.mb-4
  .card-body
    %h2.h5 Create token
    = form_with model: @new_token, url: organization_mcp_access_tokens_path(@organization), local: true do |f|
      .mb-3
        = f.label :name, "Label", class: "form-label"
        = f.text_field :name, class: "form-control", placeholder: "Zapier / Claude Desktop"
      = f.submit "Create token", class: "btn btn-primary"

.card
  .card-body
    %h2.h5 Your tokens
    - if @tokens.empty?
      %p.text-muted.mb-0 No tokens yet.
    - else
      %table.table.table-sm.mb-0
        %thead
          %tr
            %th Label
            %th Created
            %th Last used
            %th Status
            %th
        %tbody
          - @tokens.each do |token|
            %tr
              %td= token.name
              %td= l(token.created_at, format: :short)
              %td= token.last_used_at ? l(token.last_used_at, format: :short) : "—"
              %td
                - if token.revoked?
                  %span.badge.text-bg-secondary Revoked
                - elsif !token.active?
                  %span.badge.text-bg-secondary Expired
                - else
                  %span.badge.text-bg-success Active
              %td.text-end
                - unless token.revoked?
                  = button_to "Revoke", organization_mcp_access_token_path(@organization, token), method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: "Revoke this token?" } }
