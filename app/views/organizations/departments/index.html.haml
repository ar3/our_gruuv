- content_for :title, "Departments"
- page_help_id = "departmentsListPageHelp"

- content_for :go_back_link do
  = nav_hierarchy_with_previous(organization: @organization, crumbs: [{ label: "Departments", url: nil }])

- content_for :header do
  - object_lens_trailing = capture do
    = render "shared/page_help/header_info_button",
             collapse_id: page_help_id,
             tooltip: "Browse the department hierarchy. Click for details."
    - if policy(@organization).manage_departments_and_teams?
      = link_to new_organization_department_path(@organization),
                class: "btn btn-primary",
                title: "Add new Department",
                "aria-label" => "Add new Department",
                data: { "bs-toggle" => "tooltip", "bs-placement" => "top" } do
        %i.bi.bi-plus
    - else
      %span.d-inline-flex.align-items-center
        .btn.btn-primary.disabled{style: "opacity: 0.6; cursor: not-allowed;", "aria-label" => "Add new Department"}
          %i.bi.bi-plus
        %i.bi.bi-exclamation-triangle.text-warning.ms-2{"data-bs-toggle" => "tooltip", "data-bs-title" => "You need departments management permission to perform this action"}
  = render "shared/object_lens_header/switchers",
           organization: @organization,
           current_object: :departments,
           current_lens: :list,
           trailing: object_lens_trailing

.collapse.mb-4{id: page_help_id}
  = render "organizations/departments/page_help"

- content_for :header_action do
  %button.btn.btn-outline-secondary{"data-bs-toggle" => "modal", "data-bs-target" => "#departmentsFilterModal", type: "button"}
    %i.bi.bi-funnel.me-2
    Filter & Sort

.row.justify-content-center
  .col-lg-12
    - if @hierarchy_tree.any?
      .tree-visualization{style: "padding: 20px;"}
        - @hierarchy_tree.each do |root_node|
          = render 'organizations/departments/hierarchy_node', node: root_node, depth: 0, organization: @organization
    - else
      .alert.alert-info
        %h6.mb-2
          %i.bi.bi-info-circle.me-2
          No Departments Created
        %p.mb-2 
          This organization doesn't have any departments yet. 
          Create your first department to get started!
        = link_to "Create First Department", new_organization_department_path(@organization, type: 'Department'), class: "btn btn-primary btn-sm"

:javascript
  // Handle collapse/expand icon toggle
  document.addEventListener('DOMContentLoaded', function() {
    const toggleButtons = document.querySelectorAll('.toggle-children');
    
    toggleButtons.forEach(function(button) {
      const targetId = button.getAttribute('data-bs-target');
      const target = document.querySelector(targetId);
      const icon = button.querySelector('.toggle-icon');
      
      if (target) {
        // Set initial icon state based on whether it's expanded
        if (target.classList.contains('show')) {
          icon.classList.remove('bi-chevron-up');
          icon.classList.add('bi-chevron-down');
        } else {
          icon.classList.remove('bi-chevron-down');
          icon.classList.add('bi-chevron-up');
        }
        
        // Listen for Bootstrap collapse events
        target.addEventListener('show.bs.collapse', function() {
          icon.classList.remove('bi-chevron-up');
          icon.classList.add('bi-chevron-down');
        });
        
        target.addEventListener('hide.bs.collapse', function() {
          icon.classList.remove('bi-chevron-down');
          icon.classList.add('bi-chevron-up');
        });
      }
    });
  });

/ Modal for Filter & Sort
#departmentsFilterModal.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "departmentsFilterModalLabel", tabindex: "-1"}
  .modal-dialog.modal-lg
    .modal-content
      .modal-header
        %h5.modal-title#departmentsFilterModalLabel
          %i.bi.bi-funnel.me-2
          Filter & Sort Departments (coming soon)
        %button.btn-close{"aria-label" => "Close", "data-bs-dismiss" => "modal", type: "button"}
      .modal-body
        .row
          .col-md-6
            %h6.mb-3
              %i.bi.bi-funnel.me-2
              Filters
            .mb-3
              %label.form-label Parent Organization
              %select.form-select
                %option All Parents
                %option Direct Children Only
                %option Nested Children Only
            .mb-3
              %label.form-label Status
              %select.form-select
                %option All Status
                %option Active
                %option Inactive
          .col-md-6
            %h6.mb-3
              %i.bi.bi-sort-down.me-2
              Sort Options
            .mb-3
              %label.form-label Sort By
              %select.form-select
                %option Name
                %option Parent
                %option Created Date
            .mb-3
              %label.form-label Order
              %select.form-select
                %option Ascending
                %option Descending
            .mb-3
              %label.form-label View Style
              .form-check
                %input.form-check-input{checked: "checked", type: "radio", name: "viewStyle", value: "table"}
                %label.form-check-label
                  %i.bi.bi-table.me-2
                  Table View
              .form-check
                %input.form-check-input{type: "radio", name: "viewStyle", value: "cards"}
                %label.form-check-label
                  %i.bi.bi-grid.me-2
                  Card View
              .form-check
                %input.form-check-input{type: "radio", name: "viewStyle", value: "tree"}
                %label.form-check-label
                  %i.bi.bi-diagram-3.me-2
                  Tree View
            .mb-3
              %label.form-label Spotlight
              %select.form-select
                %option No Spotlight
                %option Recently Created
                %option Most Active
      .modal-footer
        %button.btn.btn-secondary{"data-bs-dismiss" => "modal", type: "button"} Cancel
        %button.btn.btn-primary.disabled{type: "button"}
          %i.bi.bi-check.me-2
          Apply Filters
