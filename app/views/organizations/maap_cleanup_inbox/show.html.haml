- page_help_id = "maapCleanupInboxPageHelp"

- content_for :title, "MAAP Cleanup Inbox"

- content_for :go_back_link do
  = nav_hierarchy_with_previous(organization: @organization, crumbs: [{ label: "MAAP Cleanup Inbox", url: nil }])

- content_for :header do
  .d-flex.align-items-center.gap-2.flex-wrap
    %h1.mb-0.d-flex.align-items-center.gap-2
      %i.bi.bi-clipboard2-check.me-1
      MAAP Cleanup Inbox
      = render "shared/page_help/header_info_button",
               collapse_id: page_help_id,
               tooltip: "See what still needs fixing for a clean MAAP. Click for details."
    %span.badge.text-bg-warning
      %i.bi.bi-flask.me-1
      Beta

.collapse.mb-4{id: page_help_id}
  = render "organizations/maap_cleanup_inbox/page_help"

.row.justify-content-center.mb-3
  .col-lg-12
    %p.text-muted.mb-0
      %strong= @total_outstanding
      outstanding item#{'s' unless @total_outstanding == 1} org-wide

.row.justify-content-center
  .col-lg-12
    - @sections.each do |section|
      = render "organizations/maap_cleanup_inbox/section",
               section: section,
               organization: @organization
