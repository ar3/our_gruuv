-# locals: manager, skip_level, recipients, message, last_nudge, manager_id
- collapse_id = "goalsHealthNudge"
- can_send = goals_health_nudge_can_send?(recipients)
- disabled_reason = goals_health_nudge_send_disabled_reason(recipients, viewer: current_company_teammate)

.collapse{id: collapse_id}
  .health-dashboard-nudge-panel
    .mb-3
      %label.form-label.fw-semibold.small.text-muted.mb-1 Message preview
      .border.rounded.bg-light.p-3.small{style: "white-space: pre-wrap;"}= message.preview_plain

    .mb-3
      = button_to organization_goals_health_nudge_path(@organization), method: :post, params: { manager_id: manager_id }, class: "btn btn-primary", disabled: !can_send, form: { data: { turbo: false } }, title: disabled_reason do
        %i.bi.bi-send.me-1
        = last_nudge.present? ? "Send nudge again" : "Send nudge now"
      %p.small.text-muted.mb-0.mt-2= goals_health_nudge_recipient_sentence(recipients, viewer: current_company_teammate)
      - if skip_level.nil?
        %p.small.text-muted.mb-0.mt-1 This manager has no manager on file, so the skip-level recipient is omitted.

    %div
      %label.form-label.fw-semibold.small.text-muted.mb-1 History
      - if last_nudge.present?
        %p.small.mb-0
          Last nudge
          - if last_nudge.slack_url.present?
            = link_to "sent", last_nudge.slack_url, target: "_blank", rel: "noopener"
          - else
            sent
          #{time_ago_in_words(last_nudge.created_at)} ago
          by #{last_nudge.nudger_company_teammate&.person&.casual_name || "someone"}.
          - recipient_ids = Array(last_nudge.metadata&.dig("recipient_company_teammate_ids"))
          - if recipient_ids.any?
            - prior_recipients = CompanyTeammate.where(id: recipient_ids).includes(:person)
            %span.text-muted
              To #{prior_recipients.filter_map { |tm| tm.person&.display_name }.to_sentence}.
      - else
        %p.small.text-muted.mb-0 No Goals Health nudge has been sent for this manager yet.
