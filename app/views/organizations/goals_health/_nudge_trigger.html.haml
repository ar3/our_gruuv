-# locals: manager (other nudge locals ignored; kept so index can pass one hash)
- collapse_id = "goalsHealthNudge"

.health-dashboard-nudge-trigger
  %button.btn.btn-link.text-decoration-none.text-body.p-0.w-100.text-start.d-flex.align-items-center.justify-content-between.gap-2{type: "button", "data-bs-toggle": "collapse", "data-bs-target": "##{collapse_id}", "aria-expanded": "false", "aria-controls": collapse_id}
    %span
      %i.bi.bi-bell.me-1
      Goals Health nudge
      %small.text-muted.d-block for #{manager.person&.display_name}
    %i.bi.bi-chevron-down
