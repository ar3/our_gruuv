- content_for :title, "Goals Health Dashboard"
- page_help_id = "goalsHealthPageHelp"

- content_for :header do
  - object_lens_trailing = capture do
    = render "shared/page_help/header_info_button",
             collapse_id: page_help_id,
             tooltip: "See who needs Goal Confidence attention. Click for a full breakdown."
  = render "shared/object_lens_header/switchers",
           organization: @organization,
           current_object: :goals,
           current_lens: :health,
           trailing: object_lens_trailing

.mb-4
  = content_for :go_back_link

.collapse.mb-4{id: page_help_id}
  = render "organizations/goals_health/page_help"

- content_for :go_back_link do
  = nav_hierarchy_with_previous(organization: @organization, crumbs: [{ label: "Goals Health Dashboard", url: nil }])

.row.justify-content-center.mb-4
  .col-lg-12
    .card.border-0.shadow-sm
      .card-body
        .row.align-items-center
          .col-md-9
            = render "shared/goals_health_spotlight_compact", stats: @spotlight_stats, variant: :full
          .col-md-3
            - if @spotlight_stats[:concerning_count].to_i.positive?
              .alert.alert-danger.small.mb-0
                %i.bi.bi-exclamation-triangle.me-2
                %strong= "#{@spotlight_stats[:concerning_pct]}% need attention"
      .card-footer.bg-light
        .row.align-items-start
          .col-md-5
            %small.text-muted
              %i.bi.bi-funnel.me-1
              Who to show: #{goals_health_filter_label(@current_manager_filter)}
          .col-md-7
            .small.text-muted.text-md-end
              - goals_health_definition_lines.each do |line|
                %div.mb-1= line

.row.justify-content-center.mb-4
  .col-lg-12
    .card.border-0.shadow-sm
      .card-body
        = form_with url: organization_goals_health_path(@organization), method: :get, local: true, id: "goals-health-filter-form" do |f|
          .row.align-items-end
            .col-md-10
              %label.form-label.fw-bold.fs-5.mb-2 Who to show
              = select_tag :manager_id, options_for_select(@available_manager_filter_options, @current_manager_filter), class: "form-select form-select-lg", id: "goals-health-manager-select", required: true
              %small.form-text.text-muted Choose scope: everyone, your reports, or a specific manager's direct reports
            .col-md-2
              = f.submit "Go", class: "btn btn-primary btn-lg w-100"
          - if params[:page].present?
            = hidden_field_tag :page, params[:page]

.row.justify-content-center.mb-3
  .col-lg-12
    - nudge_captures = health_nudge_toolbar_captures(manager_id: @current_manager_filter)
    = render "organizations/health/dashboard_toolbar",
      organization: @organization,
      current: :goals_health,
      manager_id: @current_manager_filter,
      other_actions: goals_health_other_actions(@organization, manager_id: @current_manager_filter),
      aside_html: nudge_captures[:aside_html],
      below_html: nudge_captures[:below_html]

.row.justify-content-center.mb-2
  .col-lg-12
    .d-flex.justify-content-between.align-items-center
      %small.text-muted= raw pagy_info(@pagy)

.row.justify-content-center
  .col-lg-12
    - if @employee_rows.any?
      .table-responsive
        %table.table.table-hover.table-layout-fixed
          %colgroup
            %col{style: "width: 18%"}
            %col{style: "width: 82%"}
          %thead
            %tr
              %th Employee
              %th.visually-hidden Details
          %tbody
            - @employee_rows.each do |row|
              %tr
                %td
                  = link_to row[:person].display_name, my_growth_goals_organization_company_teammate_path(@organization, row[:teammate]), class: "text-decoration-none fw-bold"
                  %br
                  - if row[:manager_teammate]
                    %small.text-muted
                      = link_to row[:manager].display_name, organization_goals_health_path(@organization, manager_id: "CompanyTeammate_#{row[:manager_teammate].id}"), class: "text-muted"
                  - else
                    %small.text-muted —
                %td
                  .row.g-2.align-items-start
                    .col-3
                      .text-center.py-1
                        %i.bi.fs-3{class: goals_health_status_icon_class(row[:status])}
                        %div.fw-semibold.small.mt-1= goals_health_status_copy(row[:status])
                    .col-6
                      - EngagementHealth::STATUSES.each do |eh_status|
                        - counts = row[:status_lines][eh_status]
                        .small.mb-1{class: goals_health_status_line_text_class(eh_status)}
                          %strong= goals_health_status_line_label(eh_status)
                          %span.text-muted
                            Active: #{counts[:active]}
                            |
                            Completed: #{counts[:completed]}
                            - if eh_status == EngagementHealth::NEEDS_ATTENTION
                              |
                              Drafts: #{counts[:draft]}
                    .col-3
                      .small= goals_health_attachment_html(row)
      .d-flex.justify-content-center.mt-4
        - if @pagy.pages > 1
          = raw pagy_nav(@pagy)
    - else
      .alert.alert-info
        %h6.mb-2
          %i.bi.bi-info-circle.me-2
          No one in this view
        %p.mb-0
          Change the filter above or there are no active employees in the selected scope.
