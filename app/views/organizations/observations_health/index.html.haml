- content_for :title, "Observations Health Dashboard"
- page_help_id = "observationsHealthPageHelp"

- content_for :header do
  .d-flex.flex-wrap.align-items-center.gap-2
    %h1.mb-0.d-flex.align-items-center.gap-2
      %i.bi.bi-eye
      Observations Health Dashboard
      = render "shared/page_help/header_info_button",
               collapse_id: page_help_id,
               tooltip: "See who is giving and receiving feedback and whether OGO patterns look healthy. Click for a full breakdown."

.mb-4
  = content_for :go_back_link

.collapse.mb-4{id: page_help_id}
  = render "organizations/observations_health/page_help"

- content_for :go_back_link do
  = nav_hierarchy_with_previous(organization: @organization, crumbs: [{ label: "Observations Health Dashboard", url: nil }])

.row.justify-content-center.mb-4
  .col-lg-12
    .card.border-0.shadow-sm
      .card-body
        .row
          .col-md-8
            .row.text-center
              .col-3
                .h3.text-primary= @spotlight_stats[:total_employees]
                %small.text-muted Total Active Employees
              .col-3
                .h3.text-success= @spotlight_stats[:healthy_count]
                %small.text-muted Healthy
              .col-3
                .h3.text-warning= @spotlight_stats[:warning_count]
                %small.text-muted Warning
              .col-3
                .h3.text-danger= @spotlight_stats[:needs_attention_count]
                %small.text-muted Needs Attention
          .col-md-4
            - if @spotlight_stats[:needs_attention_count] > 0
              .alert.alert-danger.small.mb-0
                %i.bi.bi-exclamation-triangle.me-2
                %strong= "#{@spotlight_stats[:concerning_pct]}% need attention"
      .card-footer.bg-light
        .row.align-items-start
          .col-md-5
            %small.text-muted
              %i.bi.bi-funnel.me-1
              Who to show: #{observations_health_filter_label(@current_manager_filter)}
          .col-md-7
            .small.text-muted.text-md-end
              - observations_health_definition_lines.each do |line|
                %div.mb-1= line

.row.justify-content-center.mb-4
  .col-lg-12
    .card.border-0.shadow-sm
      .card-body
        = form_with url: organization_observations_health_path(@organization), method: :get, local: true, id: "observations-health-filter-form" do |f|
          .row.align-items-end
            .col-md-10
              %label.form-label.fw-bold.fs-5.mb-2 Who to show
              = select_tag :manager_id, options_for_select(@available_manager_filter_options, @current_manager_filter), class: "form-select form-select-lg", id: "observations-health-manager-select", required: true
              %small.form-text.text-muted Choose scope: everyone, your reports, or a specific manager's direct reports
            .col-md-2
              = f.submit "Go", class: "btn btn-primary btn-lg w-100"
          - if params[:page].present?
            = hidden_field_tag :page, params[:page]

.row.justify-content-center.mb-3
  .col-lg-12
    - nudge_captures = health_nudge_toolbar_captures(manager_id: @current_manager_filter)
    = render "organizations/health/dashboard_toolbar",
      organization: @organization,
      current: :observations_health,
      manager_id: @current_manager_filter,
      other_actions: observations_health_other_actions(@organization, manager_id: @current_manager_filter),
      aside_html: nudge_captures[:aside_html],
      below_html: nudge_captures[:below_html]

.row.justify-content-center.mb-2
  .col-lg-12
    %small.text-muted= raw pagy_info(@pagy)

.row.justify-content-center
  .col-lg-12
    - if @employee_rows.any?
      .table-responsive
        %table.table.table-hover.table-layout-fixed
          %colgroup
            %col{style: "width: 22%"}
            %col{style: "width: 19%"}
            %col{style: "width: 19%"}
            %col{style: "width: 20%"}
            %col{style: "width: 20%"}
          %thead
            %tr
              %th Employee
              %th Given
              %th Received
              %th Kudos mix
              %th Rating intensity
          %tbody
            - @employee_rows.each do |row|
              %tr
                %td
                  = link_to row[:person].display_name, ogos_organization_company_teammate_path(@organization, teammate_route_param(row[:teammate])), class: "text-decoration-none fw-bold"
                  %br
                  - if row[:manager_teammate]
                    %small.text-muted
                      = link_to row[:manager].display_name, organization_observations_health_path(@organization, manager_id: "CompanyTeammate_#{row[:manager_teammate].id}"), class: "text-muted"
                  - else
                    %small.text-muted —
                  - if row[:refreshed_at]
                    %br
                    %small.text-muted
                      Computed #{time_ago_in_words(row[:refreshed_at])} ago
                      = button_to organization_observations_health_refresh_path(@organization, teammate_id: row[:teammate].id), method: :post, class: "btn btn-link btn-sm p-0 text-muted", title: "Queue Gruuv Health and mix refresh", form: { class: "d-inline" } do
                        %i.bi.bi-arrow-clockwise
                %td
                  %div{observations_health_cell_attrs(observations_health_status_alert_class(row[:given]["status"]), "Given", observations_health_status_popover_content("Given"))}
                    %strong= observations_health_status_copy(row[:given]["status"])
                    %div.small.text-muted.mt-1= observations_health_status_caption(row[:given])
                %td
                  %div{observations_health_cell_attrs(observations_health_status_alert_class(row[:received]["status"]), "Received", observations_health_status_popover_content("Received"))}
                    %strong= observations_health_status_copy(row[:received]["status"])
                    %div.small.text-muted.mt-1= observations_health_status_caption(row[:received])
                %td
                  %div{observations_health_cell_attrs(observations_health_band_alert_class(row[:kudos_mix]["band"]), "Kudos mix", observations_health_kudos_mix_popover_content(row))}
                    %strong= row[:kudos_mix]["display_ratio"]
                    %span.ms-2
                      Kudos: #{row[:kudos_mix]["kudos_count"]}
                      |
                      Constructive: #{row[:kudos_mix]["constructive_count"]}
                %td
                  %div{observations_health_cell_attrs(observations_health_band_alert_class(row[:rating_intensity]["band"]), "Rating intensity", observations_health_rating_intensity_popover_content(row))}
                    %strong= row[:rating_intensity]["display_ratio"]
                    %span.ms-2
                      Less extreme: #{row[:rating_intensity]["less_extreme_count"]}
                      |
                      Most extreme: #{row[:rating_intensity]["most_extreme_count"]}
      .d-flex.justify-content-center.mt-4
        - if @pagy.pages > 1
          = raw pagy_nav(@pagy)
    - else
      .alert.alert-info
        %h6.mb-2
          %i.bi.bi-info-circle.me-2
          No one in this view
        %p.mb-0
          Change the filter above or there are no active employees in the selected scope.
