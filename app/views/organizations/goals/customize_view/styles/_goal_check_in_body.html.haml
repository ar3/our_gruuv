- if show_note_win_cta_for_viewer && policy(Observation).create?
  .mt-1
    - quick_note_params = { privacy_level: 'observed_and_managers', return_url: request.fullpath, return_text: 'Goals', goal_id: goal.id, observee_ids: goal.observee_teammate_ids_for_observation }
    = link_to new_quick_note_organization_observations_path(@organization, quick_note_params), class: 'btn btn-outline-primary w-100', target: '_blank', rel: 'noopener noreferrer' do
      %i.bi.bi-sticky.me-2
      Add a note/win/challenge about this goal
- elsif show_note_win_cta_for_viewer
  .d-flex.align-items-center.gap-2.mt-1
    .flex-grow-1
      %button.btn.btn-outline-secondary.w-100{type: "button", disabled: true}
        %i.bi.bi-sticky.me-2
        Add a note/win/challenge about this goal
    %i.bi.bi-exclamation-triangle.text-warning{"data-bs-toggle" => "tooltip", "data-bs-title" => "You don't have permission to add a note/win/challenge about this goal.", tabindex: "0", role: "img", "aria-label" => "Permission notice"}
- elsif can_check_in
  - can_update_goal = policy(goal).update?
  - layout_classes = ["goal-check-in-inline-layout", "goal-check-in-inline-layout--with-update", "goal-check-in-form"].join(" ")
  .check-in-inline.mt-1.p-1.bg-light.rounded
    = form_with url: check_in_organization_goal_path(@organization, goal), method: :post, local: true, html: { class: layout_classes } do |f|
      = hidden_field_tag :return_url, request.fullpath
      .goal-check-in-inline-layout__main.d-flex.flex-column.gap-1
        .goal-check-in-inline-layout__sentence.d-flex.align-items-center.gap-2
          %span.small.text-nowrap By
          - if can_update_goal
            = date_field_tag :most_likely_target_date, goal.most_likely_target_date, class: 'form-control form-control-sm goal-check-in-inline-layout__date'
          - else
            %span.small= goal.most_likely_target_date.present? ? goal.most_likely_target_date.strftime('%b %d, %Y') : '—'
          %span.small.text-nowrap —
          = select_tag :confidence_percentage, options_for_select(confidence_percentage_options, selected_confidence_percentage_option(goal, current_week_check_in)), { include_blank: 'Select...', class: 'form-select form-select-sm goal-check-in-inline-layout__confidence-select' }
        = text_field_tag :confidence_reason, current_week_check_in&.confidence_reason, class: 'form-control form-control-sm goal-check-in-inline-layout__reason', placeholder: confidence_reason_placeholder
      %button.btn.btn-primary.btn-lg.goal-check-in-inline-layout__update-btn{type: "submit", "aria-label" => update_confidence_label}
        %i.bi.bi-check-lg{"aria-hidden": "true"}
        %span Update
        %span confidence
- else
  .check-in-inline.mt-1.p-1.bg-light.rounded.opacity-75
    .goal-check-in-inline-layout.goal-check-in-inline-layout--with-update
      .goal-check-in-inline-layout__main.d-flex.flex-column.gap-1
        .goal-check-in-inline-layout__sentence.d-flex.align-items-center.gap-2
          %span.small.text-nowrap By
          %span.small= goal.most_likely_target_date.present? ? goal.most_likely_target_date.strftime('%b %d, %Y') : '—'
          %span.small.text-nowrap —
          = select_tag "goal_check_in_disabled_#{goal.id}", options_for_select(confidence_percentage_options, selected_confidence_percentage_option(goal, current_week_check_in)), { include_blank: 'Select...', class: 'form-select form-select-sm goal-check-in-inline-layout__confidence-select', disabled: true }
        = text_field_tag "goal_check_in_reason_disabled_#{goal.id}", current_week_check_in&.confidence_reason, class: 'form-control form-control-sm goal-check-in-inline-layout__reason', placeholder: confidence_reason_placeholder, disabled: true
      .goal-check-in-inline-layout__update-wrap
        %span.btn.btn-primary.btn-lg.goal-check-in-inline-layout__update-btn.disabled{"aria-label" => update_confidence_label}
          %i.bi.bi-check-lg{"aria-hidden": "true"}
          %span Update
          %span confidence
        %i.bi.bi-exclamation-triangle.text-warning{"data-bs-toggle" => "tooltip", "data-bs-title" => goal_no_check_in_access_tooltip(goal), tabindex: "0", role: "img", "aria-label" => "Permission notice"}
