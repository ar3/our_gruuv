- hierarchy = @confidence_hierarchy
- rows = @confidence_hierarchy_rows || []
- can_check_in_goals = @can_check_in_goals || []
- current_week_check_ins = @current_week_check_ins_by_goal || {}
- roots = hierarchy&.root_goals || []

:css
  .confidence-hierarchy-row { display: grid; grid-template-columns: minmax(0, 1fr) 7.5rem 5.5rem 2.5rem; gap: 0.5rem; align-items: center; padding: 0.35rem 0.25rem; border-bottom: 1px solid #f1f3f5; }
  .confidence-hierarchy-row__goal { display: flex; align-items: center; gap: 0.4rem; min-width: 0; }
  .confidence-hierarchy-row__title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .confidence-hierarchy-row__owner { flex: 0 0 auto; line-height: 0; }
  .confidence-hierarchy-row__owner img,
  .confidence-hierarchy-row__owner .rounded-circle { width: 20px !important; height: 20px !important; }
  .confidence-hierarchy-row__twisty { width: 1.25rem; flex: 0 0 auto; color: #6c757d; visibility: hidden; line-height: 1; padding: 0; border: 0; background: transparent; }
  .confidence-hierarchy-row__twisty.is-branch { visibility: visible; }
  .confidence-hierarchy-tree { display: inline-flex; align-items: center; justify-content: center; width: 1.5rem; height: 1.5rem; border: 1px solid; border-radius: 0.25rem; font-size: 0.75rem; line-height: 1; }
  .confidence-hierarchy-header { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; color: #6c757d; }
  .confidence-hierarchy-details > summary { list-style: none; cursor: pointer; }
  .confidence-hierarchy-details > summary::-webkit-details-marker { display: none; }
  .confidence-hierarchy-track .badge { margin-left: 0 !important; }

- if roots.empty? && rows.empty?
  %p.text-muted.mb-0 No goals to show in this hierarchy.
- else
  .confidence-hierarchy{data: { controller: "confirm-leave confidence-hierarchy", confirm_leave_single_active_form_value: true, action: "input->confirm-leave#markDirty change->confirm-leave#markDirty" }}
    .confidence-hierarchy-row.confidence-hierarchy-header
      %div Goal
      %div.text-end{title: "On Track / Off Track / Stale"} Track
      %div.text-end{title: "This goal's own confidence (not a rollup)"} Conf
      %div.text-center{title: "How this confidence compares with the tree beneath it"} Tree
    - roots.each do |root|
      = render "organizations/goals/customize_view/styles/confidence_hierarchy_node",
        hierarchy: hierarchy,
        goal: root,
        depth: 0,
        section_root: true,
        can_check_in_goals: can_check_in_goals,
        current_week_check_ins: current_week_check_ins
