- content_for :title, "Goals"

- content_for :go_back_link do
  - if params[:return_url].present? && params[:return_text].present?
    = nav_return_back(url: params[:return_url], text: params[:return_text])
  - else
    - breadcrumbs = []
    - filter_crumb = goals_filter_breadcrumb_crumb
    - breadcrumbs << filter_crumb if filter_crumb.present?
    - breadcrumbs << { label: "Goals", url: nil }
    = nav_hierarchy_with_previous(organization: @organization, crumbs: breadcrumbs)

- content_for :header do
  - special_owner_ids = %w[everyone_in_company created_by_me my_relevant_goals all_my_teams my_department my_employees my_employees_hierarchy]
  - grouped_owner_options = available_goal_owners_grouped
  - selected_value = if @customized_owner_view
    - 'customized_view'
  - elsif @current_filters[:owner_id].to_s.in?(special_owner_ids)
    - @current_filters[:owner_id]
  - else
    - primary_filter_select_value
  - current_filter_label = if selected_value == 'customized_view'
    - 'Customized view'
  - else
    - grouped_owner_options.flat_map { |_group, options| options }.find { |_label, value| value == selected_value }&.first || 'Select owner'
  .d-flex.flex-column.gap-2
    .d-flex.flex-column.flex-md-row.align-items-start.align-items-md-center.justify-content-between.gap-2
      - object_lens_trailing = capture do
        - if policy(Goal).create?
          = link_to select_create_organization_goals_path(@organization),
                    class: "btn btn-primary",
                    title: "Add new Goal",
                    "aria-label" => "Add new Goal",
                    data: { "bs-toggle" => "tooltip", "bs-placement" => "top" } do
            %i.bi.bi-plus
        - else
          %span.btn.btn-primary.disabled{style: "opacity: 0.6; cursor: not-allowed;", title: "You need to be a teammate to create goals", "aria-label" => "Add new Goal"}
            %i.bi.bi-plus
          %i.bi.bi-exclamation-triangle.text-warning.ms-1{"data-bs-toggle" => "tooltip", "data-bs-title" => "You need to be a teammate to create goals"}
      = render "shared/object_lens_header/switchers",
               organization: @organization,
               current_object: :goals,
               current_lens: :list,
               trailing: object_lens_trailing
    .d-flex.align-items-center.gap-2
      = form_with url: organization_goals_path(@organization), method: :get, local: true, id: "goals-header-owner-switcher-form", class: "mb-0" do |_f|
        %label.visually-hidden{for: "goals-header-owner-select"} Goals primary filter
        .dropdown.d-inline-flex.align-items-center
          %button.btn.btn-link.dropdown-toggle.p-0.ps-1.text-body.border-0.align-items-center.gap-2.d-inline-flex.fs-1.fw-medium.text-decoration-none{type: "button", "data-bs-toggle": "dropdown", "aria-expanded": "false", "aria-label" => "Switch goals primary filter"}
            %span
              for #{current_filter_label}
          %ul.dropdown-menu.py-1{style: "max-height: 70vh; overflow-y: auto;"}
            - if @customized_owner_view
              %li
                %h6.dropdown-header.mb-0.mt-1 Current
              %li
                %span.dropdown-item.text-muted.d-flex.align-items-center.gap-2{"aria-disabled" => "true"}
                  %span.flex-grow-1.text-truncate{title: "Customized view"} Customized view
                  %i.bi.bi-check-circle.text-success.flex-shrink-0
            - grouped_owner_options.each do |group_label, group_options|
              %li
                %h6.dropdown-header.mb-0.mt-1= group_label
              - group_options.each do |label, value|
                %li
                  - if value == selected_value
                    .dropdown-item.text-muted.d-flex.align-items-center.gap-2
                      %span.flex-grow-1.text-truncate{title: label}= label
                      %i.bi.bi-check-circle.text-success.flex-shrink-0
                  - else
                    = link_to goals_index_path_for_owner_filter(value), class: "dropdown-item d-flex align-items-center gap-2" do
                      %span.text-truncate{title: label}= label
        / Fallback control for non-JS clients and accessibility tooling.
        = render 'goal_owner_select',
          grouped_options: grouped_owner_options,
          selected_value: (selected_value == 'customized_view' ? nil : selected_value),
          name: 'owner_id',
          id: 'goals-header-owner-select',
          select_class: 'visually-hidden',
          required: true,
          html_options: { onchange: 'this.form.submit();' }
        / Preserve other filter parameters
        - if @customized_owner_view && @owner_keys.present?
          - @owner_keys.each do |owner_key|
            = hidden_field_tag 'owner_keys[]', owner_key
        - if @current_filters[:timeframe].present?
          = hidden_field_tag :timeframe, @current_filters[:timeframe]
        - if @current_filters[:goal_type].present?
          - Array(@current_filters[:goal_type]).each do |gt|
            = hidden_field_tag "goal_type[]", gt
        - if @current_filters[:status].present?
          - Array(@current_filters[:status]).each do |s|
            = hidden_field_tag "status[]", s
        - if @current_filters[:sort].present?
          = hidden_field_tag :sort, @current_filters[:sort]
        - if @current_filters[:direction].present?
          = hidden_field_tag :direction, @current_filters[:direction]
        - if @current_filters[:view].present?
          = hidden_field_tag :view, @current_filters[:view]
        - if @current_filters[:spotlight].present?
          = hidden_field_tag :spotlight, @current_filters[:spotlight]
        - if @current_filters[:prompt_id].present?
          = hidden_field_tag :prompt_id, @current_filters[:prompt_id]
        - if params[:return_url].present?
          = hidden_field_tag :return_url, params[:return_url]
        - if params[:return_text].present?
          = hidden_field_tag :return_text, params[:return_text]

- content_for :header_action do
  - customize_params = params.except(:controller, :action, :page).permit!.to_h
  - bulk_edit_owner = primary_filter_select_value
  - bulk_edit_owner = nil unless bulk_edit_owner.to_s.match?(/\A(CompanyTeammate|Team|Department|Company|Organization)_\d+\z/)
  .d-flex.flex-column.align-items-end.gap-1
    = link_to customize_view_organization_goals_path(@organization, customize_params), class: "btn btn-outline-secondary" do
      %i.bi.bi-sliders.me-2
      Customize View
    - if policy(Goal).bulk_edit?
      = link_to organization_goals_bulk_edit_path(@organization, owner_id: bulk_edit_owner), class: "small text-muted text-decoration-none" do
        %i.bi.bi-table.me-1
        Bulk Edit Goals

- if @my_department_missing
  .row.justify-content-center.mb-3
    .col-lg-12
      .alert.alert-warning.mb-0
        %p.mb-2
          %i.bi.bi-exclamation-triangle.me-2
          Those without a department, this view defaults to all company goals. If you believe you are seeing this in error, reach out to
          - managers = Array(@employment_managers_for_department_warning)
          - if managers.any?
            - managers.each_with_index do |person, index|
              - if index.positive?
                = index == managers.size - 1 ? ' or ' : ', '
              = link_to person[:name], person[:path], class: "alert-link"
            = '.'
          - else
            someone who can manage employment.
        %p.mb-0.small
          Showing goals visible to everyone at the company.

/ Spotlight Section (always shown)
.row.justify-content-center.mb-4
  .col-lg-12
    .card.border-0.shadow-sm
      .card-body
        - if @goals_empty_filter_fallback.present?
          = render 'organizations/goals/empty_filter_fallback', fallback: @goals_empty_filter_fallback
        - else
          - case @current_spotlight
          - when 'goals_overview'
            = render partial: 'organizations/goals/customize_view/spotlights/goals_overview'
          - when 'top_priority'
            = render partial: 'organizations/goals/customize_view/spotlights/top_priority'
          - when 'recently_added'
            = render partial: 'organizations/goals/customize_view/spotlights/recently_added'
          - when 'overdue'
            = render partial: 'organizations/goals/customize_view/spotlights/overdue'
          - else
            = render partial: 'organizations/goals/customize_view/spotlights/default'
      .card-footer.bg-light
        - footer_query = request.query_parameters
        - filter_pills = goal_index_filter_pills(@organization, footer_query)
        .row.align-items-start
          .col-md-6
            %div.mb-2
              %small.text-muted
                %i.bi.bi-funnel.me-1
                Filters:
              - if filter_pills.any?
                - filter_pills.each do |pill|
                  %span.badge.rounded-pill.text-bg-secondary.me-1.mb-1= pill.label
              - else
                %span.badge.rounded-pill.text-bg-light.border.text-muted.me-1.mb-1 All
            = render "organizations/goals/status_quick_filter", filters: @current_filters, base: :index
          .col-md-6.text-end
            = render "organizations/goals/spotlight_footer_link_dropdown",
              label: "View",
              icon: "table",
              current_label: goal_index_view_style_label(@view_style),
              current_value: @view_style,
              groups: goal_index_view_style_groups.map { |header, styles| [header, styles.map { |s| [goal_index_view_style_label(s), s] }] },
              path_for: ->(value) { goal_index_path_with_footer_params(@organization, filters: footer_query, view: value) }
            = render "organizations/goals/spotlight_footer_link_dropdown",
              label: "Sort",
              icon: "sort-down",
              current_label: goal_index_sort_label(@current_filters[:sort] || "most_likely_target_date"),
              current_value: @current_filters[:sort] || "most_likely_target_date",
              options: GoalsHelper::GOAL_INDEX_SORT_OPTIONS,
              path_for: ->(value) { goal_index_path_with_footer_params(@organization, filters: footer_query, sort: value) }
            = render "organizations/goals/spotlight_footer_link_dropdown",
              label: "Direction",
              icon: "arrow-down-up",
              current_label: goal_index_direction_label(@current_filters[:direction] || "asc"),
              current_value: @current_filters[:direction] || "asc",
              options: GoalsHelper::GOAL_INDEX_DIRECTION_OPTIONS,
              path_for: ->(value) { goal_index_path_with_footer_params(@organization, filters: footer_query, direction: value) }
            = render "organizations/goals/spotlight_footer_link_dropdown",
              label: "Spotlight",
              icon: "eye",
              current_label: goal_index_spotlight_label(@current_spotlight),
              current_value: @current_spotlight.presence || "goals_overview",
              options: GoalsHelper::GOAL_INDEX_SPOTLIGHT_OPTIONS,
              path_for: ->(value) { goal_index_path_with_footer_params(@organization, filters: footer_query, spotlight: value) }

/ Performance warning for visualizations
- if @show_performance_warning
  .row.justify-content-center.mb-3
    .col-lg-12
      .alert.alert-warning.d-flex.align-items-center
        %i.bi.bi-exclamation-triangle.me-2
        %div
          %strong Performance Warning:
          This visualization may be slow with #{@goal_count} goals. Consider using filters to reduce the number of goals.

.row.justify-content-center
  .col-lg-12
    - if @goals.any?
      - case @view_style
      - when 'list'
        = render partial: 'organizations/goals/customize_view/styles/list'
      - when 'table'
        = render partial: 'organizations/goals/customize_view/styles/table'
      - when 'cards'
        = render partial: 'organizations/goals/customize_view/styles/cards'
      - when 'network'
        = render partial: 'organizations/goals/customize_view/styles/network'
      - when 'tree'
        = render partial: 'organizations/goals/customize_view/styles/tree'
      - when 'nested'
        = render partial: 'organizations/goals/customize_view/styles/nested'
      - when 'timeline'
        = render partial: 'organizations/goals/customize_view/styles/timeline'
      - when 'hierarchical-indented'
        = render partial: 'organizations/goals/customize_view/styles/hierarchical_indented'
      - when 'hierarchical-collapsible'
        = render partial: 'organizations/goals/customize_view/styles/hierarchical_collapsible'
      - when 'hierarchical-collapsible-hidden-checks'
        = render partial: 'organizations/goals/customize_view/styles/hierarchical_collapsible_hidden_checks'
      - when *Goals::HighchartsVizData::CHART_KINDS
        = render partial: 'organizations/goals/customize_view/styles/highcharts', locals: { chart_kind: @view_style }
      - else
        / Default to hierarchical-collapsible view
        = render partial: 'organizations/goals/customize_view/styles/hierarchical_collapsible'
    - else
      .alert.alert-info
        - if @goals_empty_filter_fallback.present?
          = render 'organizations/goals/empty_filter_fallback', fallback: @goals_empty_filter_fallback
        - else
          %h6.mb-2
            %i.bi.bi-info-circle.me-2
            - if @current_filters[:owner_type].blank? && @current_filters[:owner_id].blank?
              Please select an owner to view goals
            - else
              No goals match your current filters. Try adjusting your filters.


