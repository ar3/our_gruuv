- content_for :title, "Customize View"

- content_for :header do
  Customize Goals View
- content_for :return_url do
  = @return_url || organization_goals_path(@organization)
- content_for :return_text do
  = @return_text || 'Back to Goals'

= form_with url: update_view_organization_goals_path(@organization), method: :patch, local: true do |form|
  / Preserve non-structural owner (teammate / special filters) when no company/dept/team boxes are checked
  - if @selected_structural_owner_keys.blank? && @current_filters[:owner_type].present? && @current_filters[:owner_id].present?
    - preserved_owner = @current_filters[:owner_type] == 'Organization' ? "Company_#{@current_filters[:owner_id]}" : "#{@current_filters[:owner_type]}_#{@current_filters[:owner_id]}"
    = hidden_field_tag :owner_id, preserved_owner
  - elsif @selected_structural_owner_keys.blank? && params[:owner_id].present? && !params[:owner_id].to_s.include?('_') && params[:owner_type].blank?
    = hidden_field_tag :owner_id, params[:owner_id]
  
  .row
    .col-md-4
      .mb-4
        %h2 Select What Goals You See
    
    .col-md-8
      / Filters Section
      .card.mb-4
        .card-body
          %label.form-label.fw-bold Select What Goals You See

          .mb-3
            %label.form-label Company, department, and team
            %p.form-text.mb-2
              Choose one or more. Selecting multiple shows as "Customized view" on the Goals index.
            - (@structural_owner_option_groups || []).each do |group_label, options|
              %div.mb-2
                %div.fw-semibold.small.text-muted.mb-1= group_label
                - options.each do |label, value|
                  .form-check
                    = check_box_tag 'owner_keys[]', value, @selected_structural_owner_keys.include?(value), class: 'form-check-input', id: "owner_key_#{value}"
                    = label_tag "owner_key_#{value}", label, class: 'form-check-label'
            %p.form-text.mb-0
              To filter by a teammate, open their
              - if current_company_teammate
                = link_to 'internal page', internal_organization_company_teammate_path(@organization, current_company_teammate)
                and go to
                = link_to 'Grow by Goals', my_growth_goals_organization_company_teammate_path(@organization, current_company_teammate)
                \. (Pick a different teammate from People / Employees first if needed.)
              - else
                internal page → Grow by Goals.
          
          .mb-3
            %label.form-label Timeframe
            .form-check
              = radio_button_tag 'timeframe', 'all', (@current_filters[:timeframe].blank? || @current_filters[:timeframe] == 'all'), class: 'form-check-input', id: 'timeframe_all'
              = label_tag 'timeframe_all', 'All', class: 'form-check-label'
            .form-check
              = radio_button_tag 'timeframe', 'now', @current_filters[:timeframe] == 'now', class: 'form-check-input', id: 'timeframe_now'
              = label_tag 'timeframe_now', 'Now', class: 'form-check-label'
            .form-check
              = radio_button_tag 'timeframe', 'next', @current_filters[:timeframe] == 'next', class: 'form-check-input', id: 'timeframe_next'
              = label_tag 'timeframe_next', 'Next', class: 'form-check-label'
            .form-check
              = radio_button_tag 'timeframe', 'later', @current_filters[:timeframe] == 'later', class: 'form-check-input', id: 'timeframe_later'
              = label_tag 'timeframe_later', 'Later', class: 'form-check-label'
          
          .mb-3
            %label.form-label Goal Type
            .form-check
              = check_box_tag 'goal_type[]', 'inspirational_objective', @current_filters[:goal_type]&.include?('inspirational_objective'), class: 'form-check-input', id: 'goal_type_objective'
              = label_tag 'goal_type_objective', 'Inspirational Objective', class: 'form-check-label'
            .form-check
              = check_box_tag 'goal_type[]', 'qualitative_key_result', @current_filters[:goal_type]&.include?('qualitative_key_result'), class: 'form-check-input', id: 'goal_type_qualitative'
              = label_tag 'goal_type_qualitative', 'Qualitative Key Result', class: 'form-check-label'
            .form-check
              = check_box_tag 'goal_type[]', 'quantitative_key_result', @current_filters[:goal_type]&.include?('quantitative_key_result'), class: 'form-check-input', id: 'goal_type_quantitative'
              = label_tag 'goal_type_quantitative', 'Quantitative Key Result', class: 'form-check-label'
            .form-check
              = check_box_tag 'goal_type[]', 'stepping_stone_activity', @current_filters[:goal_type]&.include?('stepping_stone_activity'), class: 'form-check-input', id: 'goal_type_stepping'
              = label_tag 'goal_type_stepping', 'Stepping Stone Activity', class: 'form-check-label'
          
          .mb-3
            %label.form-label Status
            .form-check
              = check_box_tag 'status[]', 'draft', (@current_filters[:status].blank? || @current_filters[:status].include?('draft')), class: 'form-check-input', id: 'status_draft'
              = label_tag 'status_draft', 'Draft', class: 'form-check-label'
            .form-check
              = check_box_tag 'status[]', 'active', (@current_filters[:status].blank? || @current_filters[:status].include?('active')), class: 'form-check-input', id: 'status_active'
              = label_tag 'status_active', 'Active', class: 'form-check-label'
            .form-check
              = check_box_tag 'status[]', 'completed', @current_filters[:status]&.include?('completed'), class: 'form-check-input', id: 'status_completed'
              = label_tag 'status_completed', 'Completed', class: 'form-check-label'
            .form-check
              = check_box_tag 'status[]', 'archived', @current_filters[:status]&.include?('archived'), class: 'form-check-input', id: 'status_archived'
              = label_tag 'status_archived', 'Archived', class: 'form-check-label'
  
  .row
    .col-md-4
      .mb-4
        %h2 Select What Order You See Them In
    
    .col-md-8
      / Sort Section
      .card.mb-4
        .card-body
          %label.form-label.fw-bold Select What Order You See Them In
          .mb-3
            %label.form-label Sort By
            - sort_options = [['Smart Sort', 'smart_sort'], ['Most Likely Date', 'most_likely_target_date'], ['Earliest Date', 'earliest_target_date'], ['Latest Date', 'latest_target_date'], ['Created Date', 'created_at'], ['Title (A-Z)', 'title']]
            = select_tag 'sort', options_for_select(sort_options, @current_sort || 'most_likely_target_date'), class: 'form-select', id: 'sort_select'
          .mb-3
            %label.form-label Direction
            - direction_options = [['Ascending', 'asc'], ['Descending', 'desc']]
            = select_tag 'direction', options_for_select(direction_options, @current_filters[:direction] || 'asc'), class: 'form-select', id: 'direction_select'
  
  .row
    .col-md-4
      .mb-4
        %h2 Select How They Appear
    
    .col-md-8
      / View Style Section
      .card.mb-4
        .card-body
          %label.form-label.fw-bold Select How They Appear
          .form-check
            = radio_button_tag 'view', 'table', @current_view == 'table', class: 'form-check-input', id: 'view_table'
            = label_tag 'view_table', class: 'form-check-label' do
              %i.bi.bi-table.me-2
              Table View
          .form-check
            = radio_button_tag 'view', 'cards', @current_view == 'cards', class: 'form-check-input', id: 'view_cards'
            = label_tag 'view_cards', class: 'form-check-label' do
              %i.bi.bi-grid.me-2
              Card View
          .form-check
            = radio_button_tag 'view', 'list', @current_view == 'list', class: 'form-check-input', id: 'view_list'
            = label_tag 'view_list', class: 'form-check-label' do
              %i.bi.bi-list.me-2
              List View
          .form-check
            = radio_button_tag 'view', 'network', @current_view == 'network', class: 'form-check-input', id: 'view_network'
            = label_tag 'view_network', class: 'form-check-label' do
              %i.bi.bi-diagram-3.me-2
              Network View
          .form-check
            = radio_button_tag 'view', 'tree', @current_view == 'tree', class: 'form-check-input', id: 'view_tree'
            = label_tag 'view_tree', class: 'form-check-label' do
              %i.bi.bi-diagram-2.me-2
              Tree View
          .form-check
            = radio_button_tag 'view', 'nested', @current_view == 'nested', class: 'form-check-input', id: 'view_nested'
            = label_tag 'view_nested', class: 'form-check-label' do
              %i.bi.bi-boxes.me-2
              Nested View
          .form-check
            = radio_button_tag 'view', 'timeline', @current_view == 'timeline', class: 'form-check-input', id: 'view_timeline'
            = label_tag 'view_timeline', class: 'form-check-label' do
              %i.bi.bi-calendar-event.me-2
              Timeline View
          .form-check
            = radio_button_tag 'view', 'hierarchical-indented', @current_view == 'hierarchical-indented', class: 'form-check-input', id: 'view_hierarchical_indented'
            = label_tag 'view_hierarchical_indented', class: 'form-check-label' do
              %i.bi.bi-list-nested.me-2
              Hierarchical Indented
          .form-check
            = radio_button_tag 'view', 'hierarchical-collapsible', @current_view == 'hierarchical-collapsible', class: 'form-check-input', id: 'view_hierarchical_collapsible'
            = label_tag 'view_hierarchical_collapsible', class: 'form-check-label' do
              %i.bi.bi-chevron-bar-expand.me-2
              = hierarchical_collapsible_with_confidence_checks_label
          .form-check
            = radio_button_tag 'view', 'hierarchical-collapsible-hidden-checks', @current_view == 'hierarchical-collapsible-hidden-checks', class: 'form-check-input', id: 'view_hierarchical_collapsible_hidden_checks'
            = label_tag 'view_hierarchical_collapsible_hidden_checks', class: 'form-check-label' do
              %i.bi.bi-chevron-bar-contract.me-2
              = hierarchical_collapsible_hidden_checks_label
          .form-check
            = radio_button_tag 'view', 'confidence_hierarchy', @current_view == 'confidence_hierarchy', class: 'form-check-input', id: 'view_confidence_hierarchy'
            = label_tag 'view_confidence_hierarchy', class: 'form-check-label' do
              %i.bi.bi-bar-chart-steps.me-2
              Confidence hierarchy

          %hr.my-3
          %p.small.text-muted.mb-2
            Highcharts Prize lab (soft status + multi-parent duplicates marked with ⧉)

          .form-check
            = radio_button_tag 'view', 'hc-networkgraph', @current_view == 'hc-networkgraph', class: 'form-check-input', id: 'view_hc_networkgraph'
            = label_tag 'view_hc_networkgraph', class: 'form-check-label' do
              %i.bi.bi-share.me-2
              HC Network graph
          .form-check
            = radio_button_tag 'view', 'hc-treegraph', @current_view == 'hc-treegraph', class: 'form-check-input', id: 'view_hc_treegraph'
            = label_tag 'view_hc_treegraph', class: 'form-check-label' do
              %i.bi.bi-diagram-3.me-2
              HC Treegraph
          .form-check
            = radio_button_tag 'view', 'hc-treegraph-boxes', @current_view == 'hc-treegraph-boxes', class: 'form-check-input', id: 'view_hc_treegraph_boxes'
            = label_tag 'view_hc_treegraph_boxes', class: 'form-check-label' do
              %i.bi.bi-grid-3x3-gap.me-2
              HC Treegraph (boxes)
          .form-check
            = radio_button_tag 'view', 'hc-sankey-horizontal', @current_view == 'hc-sankey-horizontal', class: 'form-check-input', id: 'view_hc_sankey_horizontal'
            = label_tag 'view_hc_sankey_horizontal', class: 'form-check-label' do
              %i.bi.bi-subtract.me-2
              HC Sankey (horizontal)
          .form-check
            = radio_button_tag 'view', 'hc-sankey-vertical', @current_view == 'hc-sankey-vertical', class: 'form-check-input', id: 'view_hc_sankey_vertical'
            = label_tag 'view_hc_sankey_vertical', class: 'form-check-label' do
              %i.bi.bi-bar-chart-steps.me-2
              HC Sankey (vertical)
          .form-check
            = radio_button_tag 'view', 'hc-organization-vertical', @current_view == 'hc-organization-vertical', class: 'form-check-input', id: 'view_hc_organization_vertical'
            = label_tag 'view_hc_organization_vertical', class: 'form-check-label' do
              %i.bi.bi-diagram-2.me-2
              HC Org chart (vertical)
          .form-check
            = radio_button_tag 'view', 'hc-organization-horizontal', @current_view == 'hc-organization-horizontal', class: 'form-check-input', id: 'view_hc_organization_horizontal'
            = label_tag 'view_hc_organization_horizontal', class: 'form-check-label' do
              %i.bi.bi-layout-sidebar.me-2
              HC Org chart (horizontal)
  
  .row
    .col-md-4
      .mb-4
        %h2 Select the Spotlight for Them
    
    .col-md-8
      / Spotlight Section
      .card.mb-4
        .card-body
          %label.form-label.fw-bold Select the Spotlight for Them
          .form-check
            = radio_button_tag 'spotlight', 'goals_overview', (@current_spotlight.blank? || @current_spotlight == 'goals_overview'), class: 'form-check-input', id: 'spotlight_goals_overview'
            = label_tag 'spotlight_goals_overview', 'Goals Overview', class: 'form-check-label'
          .form-check
            = radio_button_tag 'spotlight', 'confidence_overview', @current_spotlight == 'confidence_overview', class: 'form-check-input', id: 'spotlight_confidence_overview'
            = label_tag 'spotlight_confidence_overview', 'Confidence overview', class: 'form-check-label'
          .form-check
            = radio_button_tag 'spotlight', 'none', @current_spotlight == 'none', class: 'form-check-input', id: 'spotlight_none'
            = label_tag 'spotlight_none', 'No Spotlight', class: 'form-check-label'
          .form-check
            = radio_button_tag 'spotlight', 'top_priority', @current_spotlight == 'top_priority', class: 'form-check-input', id: 'spotlight_top_priority'
            = label_tag 'spotlight_top_priority', 'Top Priority', class: 'form-check-label'
          .form-check
            = radio_button_tag 'spotlight', 'recently_added', @current_spotlight == 'recently_added', class: 'form-check-input', id: 'spotlight_recently_added'
            = label_tag 'spotlight_recently_added', 'Recently Added', class: 'form-check-label'
          .form-check
            = radio_button_tag 'spotlight', 'overdue', @current_spotlight == 'overdue', class: 'form-check-input', id: 'spotlight_overdue'
            = label_tag 'spotlight_overdue', 'Overdue', class: 'form-check-label'
  
  .row
    .col-12
      / Form Actions
      .d-flex.gap-2.mt-4.mb-4
        = form.submit 'Apply View', class: 'btn btn-primary'
        = link_to 'Cancel', @return_url || organization_goals_path(@organization), class: 'btn btn-outline-secondary'


