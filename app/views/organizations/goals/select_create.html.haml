- content_for :title, "Add New Goals"

- content_for :header do
  Add New Goals

.container-fluid.py-4
  %p.text-muted.mb-4
    Choose who the goal(s) will belong to, then whether you are creating one goal or several at once.
    Your choice pre-selects the owner on the next page — you can still change it there.

  .row.g-4
    - @create_scopes.each do |scope|
      .col-md-6
        .card.h-100
          .card-body.d-flex.flex-column
            .d-flex.align-items-start.gap-3.mb-3
              %i.bi.display-6.text-primary{class: scope[:icon]}
              %div
                %h3.mb-1= scope[:label]
                %p.text-muted.mb-0= scope[:description]
                - if scope[:owner_label].present?
                  %p.small.mb-0.mt-2
                    %span.text-muted Default owner:
                    %strong= scope[:owner_label]
                - if scope[:hint].present?
                  %p.small.text-muted.mb-0.mt-2
                    %i.bi.bi-info-circle.me-1
                    = scope[:hint]

            .mt-auto.d-flex.flex-wrap.gap-2
              - single_params = scope[:owner_id].present? ? { owner_id: scope[:owner_id] } : {}
              - bulk_params = scope[:owner_id].present? ? { owner_id: scope[:owner_id] } : {}
              = link_to new_organization_goal_path(@organization, single_params), class: "btn btn-primary" do
                %i.bi.bi-plus-lg.me-1
                Single goal
              = link_to bulk_new_organization_goals_path(@organization, bulk_params), class: "btn btn-outline-primary" do
                %i.bi.bi-list-ul.me-1
                Bulk goals
              - if scope[:key] == :team && scope[:owner_id].blank?
                = link_to my_teams_organization_path(@organization), class: "btn btn-outline-secondary" do
                  %i.bi.bi-people.me-1
                  My Teams
