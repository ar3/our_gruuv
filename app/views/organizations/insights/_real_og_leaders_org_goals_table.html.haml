.border-bottom.py-2.mb-3.small.text-muted
  In this timeframe (#{@insights_chart_period_label}): #{number_with_delimiter(@real_og_leaders_org_goals.size)}
  team/department/company #{'owner'.pluralize(@real_og_leaders_org_goals.size)} with at least one confidence check, connected goal, or completion on shared goals.

.table-responsive
  %table.table.table-hover.align-middle
    %thead
      %tr
        %th.text-end{style: "width: 3rem;"} #
        %th Owner
        %th.text-center
          %span{"data-bs-toggle" => "tooltip", "data-bs-title" => "Confidence checks on team, department, or company goals in this timeframe"}
            Confidence checks
        %th.text-center
          %span{"data-bs-toggle" => "tooltip", "data-bs-title" => "Shared goals connected to a prompt, assignment, ability, aspiration, a personal goal, or another team/department/company goal"}
            Connected
        %th.text-center
          %span{"data-bs-toggle" => "tooltip", "data-bs-title" => "Team, department, or company goals completed in this timeframe"}
            Completed
        %th.text-center
          %span{"data-bs-toggle" => "tooltip", "data-bs-title" => "Star when this owner has confidence checks, a connected goal, and a completion in the timeframe"}
            All three
    %tbody
      - if @real_og_leaders_org_goals.empty?
        %tr
          %td.text-muted{colspan: 6} No qualifying shared goal activity in this timeframe.
      - @real_og_leaders_org_goals.each_with_index do |entry, index|
        %tr
          %td.text-end.text-muted= index + 1
          %td
            - case entry.owner_type
            - when "Department"
              = link_to entry.display_name, organization_department_path(@organization, entry.owner), class: "text-decoration-none"
            - when "Team"
              = link_to entry.display_name, organization_team_path(@organization, entry.owner), class: "text-decoration-none"
            - when "Organization"
              - if entry.owner_id == @organization.id
                %span.fw-medium= entry.display_name
              - else
                = link_to entry.display_name, organization_path(entry.owner), class: "text-decoration-none"
            - else
              = entry.display_name
            %br
            %small.text-muted= entry.owner_kind_label
          %td.text-center
            - if entry.has_confidence_check
              %span.text-success{"data-bs-toggle" => "tooltip", "data-bs-title" => "#{entry.confidence_check_count} confidence #{'check'.pluralize(entry.confidence_check_count)}", tabindex: "0", role: "img", "aria-label" => "#{entry.confidence_check_count} confidence checks"}
                %i.bi.bi-check-circle-fill.fs-5
            - else
              %span.text-muted.opacity-25{"aria-hidden" => "true"}
                %i.bi.bi-circle.fs-5
          %td.text-center
            - if entry.has_connection
              %span.text-primary{"data-bs-toggle" => "tooltip", "data-bs-title" => "#{entry.connection_count} connected #{'goal'.pluralize(entry.connection_count)}", tabindex: "0", role: "img", "aria-label" => "#{entry.connection_count} connected goals"}
                %i.bi.bi-check-circle-fill.fs-5
            - else
              %span.text-muted.opacity-25{"aria-hidden" => "true"}
                %i.bi.bi-circle.fs-5
          %td.text-center
            - if entry.has_completion
              %span.text-info{"data-bs-toggle" => "tooltip", "data-bs-title" => "#{entry.completion_count} completed #{'goal'.pluralize(entry.completion_count)}", tabindex: "0", role: "img", "aria-label" => "#{entry.completion_count} completed goals"}
                %i.bi.bi-check-circle-fill.fs-5
            - else
              %span.text-muted.opacity-25{"aria-hidden" => "true"}
                %i.bi.bi-circle.fs-5
          %td.text-center
            - if entry.has_all_three
              %span.text-warning{"data-bs-toggle" => "tooltip", "data-bs-title" => "Has confidence checks, connected goals, and completions in this timeframe", tabindex: "0", role: "img", "aria-label" => "All three"}
                %i.bi.bi-star-fill.fs-5
            - else
              %span.text-muted.opacity-25{"aria-hidden" => "true"}
                %i.bi.bi-star.fs-5
