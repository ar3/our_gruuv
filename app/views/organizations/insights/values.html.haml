- page_help_id = "valuesInsightsPageHelp"
- content_for :title, "Insights: Values"

- content_for :go_back_link do
  = nav_hierarchy_with_previous(organization: @organization, crumbs: [{ label: "Aspirational Values", url: organization_aspirations_path(@organization) }, { label: "Insights: Values", url: nil }])

- content_for :header do
  .d-flex.align-items-center.flex-wrap.gap-2
    %h1.mb-0.d-flex.align-items-center.gap-2
      %i.bi.bi-heart.me-1
      Insights: Values
      = render "shared/page_help/header_info_button",
               collapse_id: page_help_id,
               tooltip: "Year-round view of which values are lived in OGOs. Click for details."

.collapse.mb-4{id: page_help_id}
  = render "organizations/insights/values_page_help"

= render 'timeframe_selector',
  timeframe: @timeframe,
  path_for: ->(**opts) { organization_insights_values_path(@organization, values_insights_timeframe_link_opts(opts)) },
  show_custom: true,
  custom_from: @insights_custom_from,
  custom_to: @insights_custom_to,
  form_hidden_fields: (@clarity_display == 'names' ? { display: 'names' } : {}),
  wrapper_class: 'mb-4'

%p.text-muted.mb-4
  Living values and champions use
  %strong= @chart_title_period
  \. Clarity uses each person's latest finalized values check-in (not filtered by timeframe).

.row.mb-4
  .col-12
    .card.border-0.shadow-sm
      .card-header.bg-primary.text-white
        %h5.mb-0
          %i.bi.bi-bar-chart.me-2
          Which values are we living? — #{@chart_title_period}
      .card-body
        - if @living_ranked.empty?
          %p.text-muted.mb-0 No unarchived aspirational values yet.
        - elsif @living_ranked.all? { |s| s.total_ogo_count.zero? }
          %p.text-muted.mb-0 No published OGOs rated against values in this timeframe.
        - else
          .table-responsive
            %table.table.table-sm.align-middle.mb-0
              %thead
                %tr
                  %th Value
                  %th.text-end Total OGOs
                  %th.text-end Public
                  %th.text-end Private
              %tbody
                - @living_ranked.each do |section|
                  %tr
                    %td
                      = link_to section.aspiration.name, "#value-#{section.aspiration.id}", class: "text-decoration-none"
                      - if section.aspiration.department.present?
                        %span.badge.text-bg-light.ms-1= section.aspiration.department.name
                    %td.text-end.fw-semibold= section.total_ogo_count
                    %td.text-end= section.public_ogo_count
                    %td.text-end= section.private_ogo_count

%h2.h4.mb-3.mt-5
  %i.bi.bi-trophy.me-2
  Values champions
%p.text-muted.mb-4
  Top 10 observees and observers per value (public OGOs only). Sorted by OGO count, then kudos points.
  Private OGOs count in totals above but do not place someone on these boards.

- @living_ranked.each do |section|
  .card.border-0.shadow-sm.mb-4{id: "value-#{section.aspiration.id}"}
    .card-header.bg-secondary.text-white
      %h5.mb-0
        = section.aspiration.name
        - if section.aspiration.department.present?
          %span.badge.text-bg-light.text-dark.ms-2= section.aspiration.department.name
        %span.badge.text-bg-dark.ms-2
          = pluralize(section.total_ogo_count, 'OGO')
    .card-body
      .row.g-4
        .col-lg-6
          %h6.mb-3 Observed for this value
          = render 'organizations/insights/values_champions_table', rows: section.top_observees, empty_label: 'No public observees yet.'
        .col-lg-6
          %h6.mb-3 Observers who wrote about this value
          = render 'organizations/insights/values_champions_table', rows: section.top_observers, empty_label: 'No public observers yet.'

%h2.h4.mb-3.mt-5#values-clarity
  %i.bi.bi-diagram-3.me-2
  Values check-in clarity
%p.text-muted.mb-3
  How often employee, manager, and final ratings agree on the latest finalized values check-in.
  Dots mode always redacts. Names mode shows identities you can see: everyone if you have manage employment,
  otherwise yourself and people in your managerial hierarchy.

.d-flex.flex-wrap.align-items-center.gap-2.mb-3
  %span.text-muted Show
  .btn-group{role: "group", "aria-label": "Marker style"}
    = link_to "Dots",
      organization_insights_values_path(@organization, values_insights_path_options(timeframe: @timeframe, custom_from: @insights_custom_from, custom_to: @insights_custom_to, display: 'dots')),
      class: "btn btn-sm #{@clarity_display == 'dots' ? 'btn-primary' : 'btn-outline-primary'}"
    = link_to "Names",
      organization_insights_values_path(@organization, values_insights_path_options(timeframe: @timeframe, custom_from: @insights_custom_from, custom_to: @insights_custom_to, display: 'names')),
      class: "btn btn-sm #{@clarity_display == 'names' ? 'btn-primary' : 'btn-outline-primary'}"

= render "organizations/insights/values_clarity_grid",
  query: @clarity_query,
  display: @clarity_display,
  organization: @organization,
  viewer_teammate: current_company_teammate,
  can_manage_employment: @can_manage_employment
