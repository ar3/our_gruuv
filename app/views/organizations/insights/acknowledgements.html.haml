- content_for :title, "Insights: Acknowledgements"
- page_help_id = "acknowledgementsInsightsPageHelp"
- chart_title_period = @chart_title_period
- counts = @acknowledgement_counts || {}
- status_filter_for_query = (@acknowledgements_status_filter if @acknowledgements_status_filter.present? && @acknowledgements_status_filter != "all")
- filter_query = { teammate_filter: @acknowledgements_filter, status_filter: status_filter_for_query }.compact
- if @timeframe == :custom
  - filter_query = filter_query.merge(from: @insights_custom_from, to: @insights_custom_to).compact
- acknowledgements_path_for = ->(**opts) { organization_insights_acknowledgements_path(@organization, **filter_query.merge(opts).compact) }
- timeframe_btn_class = ->(key) { "btn #{@timeframe == key ? 'btn-primary' : 'btn-outline-primary'}" }
- status_btn_class = ->(key) { "btn #{@acknowledgements_status_filter == key ? 'btn-primary' : 'btn-outline-primary'}" }

- content_for :header do
  .d-flex.align-items-center.gap-2.flex-wrap
    %h1.mb-0
      %i.bi.bi-hand-thumbs-up.me-2
      Insights: Acknowledgements
    = render "shared/page_help/header_info_button",
             collapse_id: page_help_id,
             tooltip: "See acknowledged and unacknowledged finalized check-ins. Click for details."

.collapse.mb-4{id: page_help_id}
  .alert.alert-light.border
    %h3.fw-semibold.mb-2 Goal of this page
    %p.mb-3
      Review how employees acknowledged finalized check-in ratings — or still have not — in the selected timeframe.

    %h3.fw-semibold.mb-2 Context
    = render "shared/maap/definition"
    = render "shared/check_ins/three_step_clarity_flow", organization: @organization, teammate: current_company_teammate

    %h3.fw-semibold.mb-2 Specifics of this page
    %ul.mb-0
      %li Defaults to your own acknowledgements. Who to show is always visible; without Employment Management it only lists Me. Employment Management unlocks all employees, by manager, or an individual.
      %li Status filter narrows the table to acknowledged, unacknowledged, or all rows. The pie chart always reflects everyone in the current Who/timeframe scope.
      %li Timeframe filters by when the check-in was reviewed together (finalized).
      %li Broader Who filters in the URL are ignored unless you have Employment Management — you only ever see acknowledgements you are allowed to see.

- if @acknowledgements_notes_access_denied_message.present?
  .alert.alert-warning.alert-dismissible.fade.show{role: "alert"}
    %i.bi.bi-info-circle.me-2
    = @acknowledgements_notes_access_denied_message
    %button.btn-close{type: "button", "data-bs-dismiss": "alert", "aria-label": "Close"}

.mb-4
  .row.g-3.align-items-end
    .col-md-4
      %label.form-label.small.mb-1.d-block Timeframe
      .btn-group.flex-wrap{role: "group", "aria-label" => "Timeframe"}
        = link_to "Last 90 days", acknowledgements_path_for.(timeframe: "90_days"), class: timeframe_btn_class.call(:'90_days')
        = link_to "Last Year", acknowledgements_path_for.(timeframe: "year"), class: timeframe_btn_class.call(:year)
        = link_to "All-Time", acknowledgements_path_for.(timeframe: "all_time"), class: timeframe_btn_class.call(:all_time)
        = link_to "Custom", acknowledgements_path_for.(**{ timeframe: "custom", from: @insights_custom_from, to: @insights_custom_to }.compact), class: timeframe_btn_class.call(:custom)
    .col-md-4
      = form_tag organization_insights_acknowledgements_path(@organization), method: :get do
        = hidden_field_tag :timeframe, @timeframe
        - if @timeframe == :custom
          = hidden_field_tag :from, @insights_custom_from
          = hidden_field_tag :to, @insights_custom_to
        - if status_filter_for_query.present?
          = hidden_field_tag :status_filter, status_filter_for_query
        = label_tag :teammate_filter, "Who to show", class: "form-label small mb-1 d-block"
        - if @can_filter_acknowledgements
          = select_tag :teammate_filter,
                       grouped_options_for_select(@acknowledgements_filter_grouped_options, @acknowledgements_filter),
                       class: "form-select",
                       onchange: "this.form.submit()"
        - else
          = select_tag :teammate_filter,
                       options_for_select([["Me", "just_me"]], "just_me"),
                       class: "form-select",
                       onchange: "this.form.submit()"
    .col-md-4
      %label.form-label.small.mb-1.d-block Status
      .btn-group.flex-wrap{role: "group", "aria-label" => "Acknowledgement status"}
        = link_to "All", acknowledgements_path_for.(status_filter: nil, timeframe: @timeframe), class: status_btn_class.call("all")
        = link_to "Acknowledged", acknowledgements_path_for.(status_filter: "acknowledged", timeframe: @timeframe), class: status_btn_class.call("acknowledged")
        = link_to "Unacknowledged", acknowledgements_path_for.(status_filter: "unacknowledged", timeframe: @timeframe), class: status_btn_class.call("unacknowledged")
        = link_to "Skipped Ack", acknowledgements_path_for.(status_filter: "skipped", timeframe: @timeframe), class: status_btn_class.call("skipped")
  - if @timeframe == :custom
    = form_tag acknowledgements_path_for.(), method: :get, class: "row g-2 align-items-end mt-2" do
      = hidden_field_tag :timeframe, "custom"
      - filter_query.each do |name, value|
        - next if value.blank?
        = hidden_field_tag name, value
      .col-sm-auto
        = label_tag :from, "From", class: "form-label small mb-0 d-block"
        = date_field_tag :from, @insights_custom_from, class: "form-control form-control-sm", required: true
      .col-sm-auto
        = label_tag :to, "To", class: "form-label small mb-0 d-block"
        = date_field_tag :to, @insights_custom_to, class: "form-control form-control-sm", required: true
      .col-sm-auto
        = submit_tag "Apply range", class: "btn btn-sm btn-primary"
  - unless @can_filter_acknowledgements
    - viewer_names = @employment_managers_casual_names_for_acknowledgements
    = render "shared/context_callout", margin_class: "mb-0 mt-3" do
      .d-flex.align-items-start.gap-2
        %i.bi.bi-info-circle.flex-shrink-0.mt-1{"aria-hidden" => "true"}
        %p.mb-0
          - if viewer_names.any?
            Only #{viewer_names.to_sentence} can view other people's acknowledgements.
          - else
            Only people with Employment Management can view other people's acknowledgements.

.container-fluid
  .row.mb-4
    .col-12
      .d-flex.flex-wrap.gap-3.align-items-center
        .text-muted
          %strong= @acknowledgement_total
          finalized check-in#{'s' if @acknowledgement_total != 1} in this period
          - if @acknowledgements_status_filter != "all" && @acknowledgement_filtered_total != @acknowledgement_total
            %span.text-muted
              (showing #{@acknowledgement_filtered_total} in table)
        %span.badge.text-bg-success
          Acknowledged: #{counts[:acknowledged].to_i}
        %span.badge.text-bg-warning
          Unacknowledged: #{counts[:unacknowledged].to_i}
        %span.badge.text-bg-secondary
          Skipped Ack: #{counts[:skipped].to_i}

  .row.mb-4
    .col-lg-6
      .card.border-0.shadow-sm
        .card-header.bg-info.text-white
          %h4.mb-0
            %i.bi.bi-pie-chart.me-2
            Acknowledgement status (#{chart_title_period})
        .card-body
          - if @acknowledgement_total.to_i.positive?
            #acknowledgements-status-pie-chart{style: "height: 380px;"}
          - else
            %p.text-muted.mb-0 No finalized check-ins in this period for the selected people.

  .row.mb-4
    .col-12
      .card.border-0.shadow-sm
        .card-header.bg-secondary.text-white
          %h4.mb-0
            %i.bi.bi-table.me-2
            Acknowledgements
        .card-body
          - if @acknowledgement_rows.any?
            .table-responsive
              %table.table.table-hover.align-middle
                %thead
                  %tr
                    %th Teammate
                    %th Manager
                    %th Type
                    %th Item
                    %th Reviewed Together
                    %th Status
                    %th Acknowledged
                    %th Notes
                %tbody
                  - @acknowledgement_rows.each do |row|
                    %tr
                      %td= row.teammate_name
                      %td= row.manager_name
                      %td
                        %span.badge.bg-secondary= row.type_label
                      %td
                        - if row.item_path.present?
                          = link_to row.item_name, row.item_path
                        - else
                          = row.item_name
                      %td
                        - if row.finalized_at.present?
                          = format_date_in_user_timezone(row.finalized_at, format: "%b %d, %Y")
                        - else
                          %span.text-muted —
                      %td
                        - badge_class = { acknowledged: "text-bg-success", skipped: "text-bg-secondary" }.fetch(row.status, "text-bg-warning")
                        %span.badge{class: badge_class}= row.status_label
                      %td
                        - if row.acknowledged_at.present?
                          = format_date_in_user_timezone(row.acknowledged_at, format: "%b %d, %Y")
                        - else
                          %span.text-muted —
                      %td
                        - if row.notes.present?
                          = simple_format(row.notes, class: "mb-0 small")
                        - else
                          %span.text-muted —
          - else
            - if @acknowledgement_total.to_i.positive? && @acknowledgements_status_filter != "all"
              %p.text-muted.mb-0 No check-ins match the selected status filter.
            - else
              %p.text-muted.mb-0 No finalized check-ins in this period for the selected people.

- if @acknowledgement_total.to_i.positive?
  :javascript
    (function() {
      var pieData = #{@acknowledgements_pie_chart_data.to_json};
      var chartTitle = #{chart_title_period.to_json};
      function initPie() {
        if (typeof Highcharts === 'undefined') return;
        var el = document.getElementById('acknowledgements-status-pie-chart');
        if (!el) return;
        Highcharts.chart('acknowledgements-status-pie-chart', {
          chart: { type: 'pie' },
          title: { text: 'Acknowledgement status (' + chartTitle + ')' },
          accessibility: { enabled: false },
          tooltip: { pointFormat: '<b>{point.y}</b> ({point.percentage:.1f}%)' },
          plotOptions: {
            pie: {
              allowPointSelect: true,
              cursor: 'pointer',
              dataLabels: { enabled: true, format: '{point.name}: {point.y}' }
            }
          },
          series: [{ name: 'Check-ins', colorByPoint: true, data: pieData }],
          colors: ['#198754', '#ffc107', '#dc3545']
        });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPie);
      } else {
        initPie();
      }
    })();
