- content_for :title, "Insights: Who is doing what"

- content_for :header do
  .d-flex.align-items-center
    %h1.mb-0.me-2
      %i.bi.bi-bar-chart-line.me-2
      Insights: Who is doing what

.container-fluid
  / Pie: active teammates with vs without page visit
  .row.mb-4
    .col-12
      .card.border-0.shadow-sm
        .card-header.bg-primary.text-white
          %h4.mb-0
            %i.bi.bi-pie-chart.me-2
            Active teammates (has page visit vs has not)
        .card-body
          .row
            .col-md-6
              #who-is-doing-what-pie-chart{style: "height: 400px;"}

  .row.mb-4
    .col-12
      .card.border-0.shadow-sm
        .card-header.bg-warning.text-dark
          %h4.mb-0
            %i.bi.bi-bar-chart-steps.me-2
            Digest configuration coverage
        .card-body
          #who-is-doing-what-weekly-digest-day-chart{style: "height: 220px;"}
          #who-is-doing-what-weekly-digest-type-chart{style: "height: 220px;"}
          #who-is-doing-what-daily-digest-type-chart{style: "height: 220px;"}
          #who-is-doing-what-digest-medium-chart{style: "height: 220px;"}

  .row.mb-4
    .col-12
      .card.border-0.shadow-sm
        .card-header.bg-primary.text-white
          %h4.mb-0
            %i.bi.bi-house-door.me-2
            Start page (home) preference
        .card-body
          %p.text-muted.small.mb-3
            Where active employed teammates land when they log in or click the org Gruuv in the header.
            “Never set (OG Academy)” means they have not chosen a start page; the product default is OG Academy.
          #who-is-doing-what-start-page-chart{style: "height: 220px;"}

  %hr.my-5

  / Search + Ask OG activity
  .row.mb-4
    .col-12
      .card.border-0.shadow-sm
        .card-header.bg-dark.text-white
          %h4.mb-0
            %i.bi.bi-stars.me-2
            Search & Ask OG activity
        .card-body
          - if @show_ask_og_spend
            %p.mb-3
              %strong Ask OG spend (last 7 days):
              = number_to_currency(@ask_og_week_cost_micros.to_f / 1_000_000.0)
              %span.text-muted.small.ms-2
                Kill watch: over $10/week or avg turns &gt; 10 with no confirms → caps/billable within 2 weeks.

          .row.g-4.mb-4
            .col-lg-6
              #who-is-doing-what-search-ask-og-volume-chart{style: "height: 320px;"}
            .col-lg-6
              #who-is-doing-what-search-ask-og-people-chart{style: "height: 320px;"}

          .row.g-4
            .col-lg-6
              %h5.mb-3
                %i.bi.bi-search.me-2
                Recent searches (org-wide)
              - if @recent_search_logs.present?
                .table-responsive
                  %table.table.table-sm
                    %thead
                      %tr
                        %th When
                        - if @show_search_ask_og_who
                          %th Who
                        %th Query
                        %th.text-end Hits
                    %tbody
                      - @recent_search_logs.each do |log|
                        %tr
                          %td= format_date_in_user_timezone(log.created_at, format: "%b %-d %-l:%M%P")
                          - if @show_search_ask_og_who
                            %td= log.company_teammate.person&.display_name
                          %td= log.query
                          %td.text-end= log.results_count
              - else
                %p.text-muted.mb-0 No searches logged yet.

            .col-lg-6
              %h5.mb-3
                %i.bi.bi-chat-dots.me-2
                Recent Ask OG sessions (org-wide)
              - if @recent_ask_og_sessions.present?
                .table-responsive
                  %table.table.table-sm
                    %thead
                      %tr
                        %th When
                        - if @show_search_ask_og_who
                          %th Who
                        %th Question
                        %th.text-end User msgs
                        %th.text-end Turns
                        %th.text-end Confirms
                        %th Status
                    %tbody
                      - @recent_ask_og_sessions.each do |session|
                        %tr
                          %td= format_date_in_user_timezone(session[:created_at], format: "%b %-d %-l:%M%P")
                          - if @show_search_ask_og_who
                            %td= session[:teammate_name]
                          %td= truncate(session[:query], length: 60)
                          %td.text-end= session[:user_messages]
                          %td.text-end= session[:turn_count]
                          %td.text-end= session[:confirms_count]
                          %td= session[:status]
              - else
                %p.text-muted.mb-0 No Ask OG sessions yet.

  %hr.my-5

  / Top 10 pages by visit count
  .row.mb-4
    .col-12
      .card.border-0.shadow-sm
        .card-header.bg-success.text-white
          %h4.mb-0
            %i.bi.bi-list-ol.me-2
            Top 10 pages by visit count
        .card-body
          - if @top_pages.present?
            %table.table.table-sm
              %thead
                %tr
                  %th Page
                  %th.text-end Visit count
              %tbody
                - @top_pages.each do |page|
                  %tr
                    %td
                      = page[:page_title].presence || page[:url]
                    %td.text-end= number_with_delimiter(page[:visit_count])
          - else
            %p.text-muted.mb-0 No page visits in this organization yet.

  %hr.my-5

  / Histogram: teammates (department #id) vs total page visits
  .row.mb-4
    .col-12
      .card.border-0.shadow-sm
        .card-header.bg-info.text-white
          %h4.mb-0
            %i.bi.bi-bar-chart.me-2
            Page visits by teammate (department and id, top 30)
        .card-body
          - if @teammate_visit_counts.present?
            #who-is-doing-what-histogram-chart{style: "height: 600px;"}
          - else
            %p.text-muted.mb-0 No active teammates to display.

  %hr.my-5

  / Period stats: unique page visits and unique users
  .row.mb-4
    .col-12
      .card.border-0.shadow-sm
        .card-header.bg-secondary.text-white
          %h4.mb-0
            %i.bi.bi-calendar-range.me-2
            Unique page visits and users by period
        .card-body
          .row
            - if @period_stats.present?
              .col-md-4
                .card.bg-light.mb-2
                  .card-body
                    %h5.card-title Past 7 days
                    %p.card-text
                      = number_with_delimiter(@period_stats[:week][:unique_page_visits])
                      unique page visits from
                      = number_with_delimiter(@period_stats[:week][:unique_users])
                      unique users
              .col-md-4
                .card.bg-light.mb-2
                  .card-body
                    %h5.card-title Past 30 days
                    %p.card-text
                      = number_with_delimiter(@period_stats[:month][:unique_page_visits])
                      unique page visits from
                      = number_with_delimiter(@period_stats[:month][:unique_users])
                      unique users
              .col-md-4
                .card.bg-light.mb-2
                  .card-body
                    %h5.card-title Past 90 days
                    %p.card-text
                      = number_with_delimiter(@period_stats[:'90_days'][:unique_page_visits])
                      unique page visits from
                      = number_with_delimiter(@period_stats[:'90_days'][:unique_users])
                      unique users
            - else
              %p.text-muted.mb-0 No period stats available.

:javascript
  (function() {
    var pieData = #{who_is_doing_what_pie_chart_data.to_json};
    var histCategories = #{who_is_doing_what_histogram_categories.to_json};
    var histData = #{who_is_doing_what_histogram_data.to_json};
    var weeklyDigestDaySeries = #{who_is_doing_what_weekly_digest_day_series.to_json};
    var weeklyDigestTypeSeries = #{who_is_doing_what_weekly_digest_type_series.to_json};
    var dailyDigestTypeSeries = #{who_is_doing_what_daily_digest_type_series.to_json};
    var digestMediumSeries = #{who_is_doing_what_digest_medium_series.to_json};
    var startPageSeries = #{who_is_doing_what_start_page_series.to_json};
    var searchAskOgVolume = #{(@search_ask_og_weekly_charts&.dig(:volume) || { categories: [], series: [] }).to_json};
    var searchAskOgPeople = #{(@search_ask_og_weekly_charts&.dig(:people) || { categories: [], series: [] }).to_json};

    function initializePieChart() {
      if (typeof Highcharts === 'undefined') return;
      var el = document.getElementById('who-is-doing-what-pie-chart');
      if (!el) return;
      Highcharts.chart('who-is-doing-what-pie-chart', {
        chart: { type: 'pie' },
        title: { text: 'Active teammates: has page visit vs has not' },
        accessibility: { enabled: false },
        plotOptions: {
          pie: {
            allowPointSelect: true,
            cursor: 'pointer',
            dataLabels: {
              enabled: true,
              format: '<b>{point.name}</b>: {point.y} ({point.percentage:.1f}%)'
            }
          }
        },
        series: [{
          name: 'Teammates',
          colorByPoint: true,
          data: pieData
        }]
      });
    }

    function initializeHistogramChart() {
      if (typeof Highcharts === 'undefined') return;
      var el = document.getElementById('who-is-doing-what-histogram-chart');
      if (!el || histCategories.length === 0) return;
      Highcharts.chart('who-is-doing-what-histogram-chart', {
        chart: { type: 'bar' },
        title: { text: 'Page visits by teammate (department and id)' },
        accessibility: { enabled: false },
        xAxis: {
          categories: histCategories,
          title: { text: 'Teammate (department #id)' }
        },
        yAxis: {
          min: 0,
          title: { text: 'Total page visits' }
        },
        plotOptions: {
          bar: {
            dataLabels: { enabled: true }
          }
        },
        series: [{
          name: 'Page visits',
          data: histData,
          color: '#0dcaf0'
        }]
      });
    }

    function initializeDigestCoverageCharts() {
      if (typeof Highcharts === 'undefined') return;

      function digestStackedBarXAxis(categories) {
        return { categories: categories, reversedStacks: false };
      }

      var digestStackedBarYAxis = {
        min: 0,
        title: { text: 'Active teammate count' },
        stackLabels: { enabled: true },
        reversedStacks: false
      };

      if (document.getElementById('who-is-doing-what-weekly-digest-day-chart')) {
        Highcharts.chart('who-is-doing-what-weekly-digest-day-chart', {
          chart: { type: 'bar' },
          title: { text: 'Weekly digest day of week' },
          xAxis: digestStackedBarXAxis(['Weekly digest day']),
          yAxis: digestStackedBarYAxis,
          plotOptions: { series: { stacking: 'normal' } },
          accessibility: { enabled: false },
          series: weeklyDigestDaySeries
        });
      }

      if (document.getElementById('who-is-doing-what-weekly-digest-type-chart')) {
        Highcharts.chart('who-is-doing-what-weekly-digest-type-chart', {
          chart: { type: 'bar' },
          title: { text: '1:1 guide vs About Me' },
          xAxis: digestStackedBarXAxis(['Weekly digest content']),
          yAxis: digestStackedBarYAxis,
          plotOptions: { series: { stacking: 'normal' } },
          accessibility: { enabled: false },
          series: weeklyDigestTypeSeries
        });
      }

      if (document.getElementById('who-is-doing-what-daily-digest-type-chart')) {
        Highcharts.chart('who-is-doing-what-daily-digest-type-chart', {
          chart: { type: 'bar' },
          title: { text: 'Interesting Things vs GSD' },
          xAxis: digestStackedBarXAxis(['Daily digest content']),
          yAxis: digestStackedBarYAxis,
          plotOptions: { series: { stacking: 'normal' } },
          accessibility: { enabled: false },
          series: dailyDigestTypeSeries
        });
      }

      if (document.getElementById('who-is-doing-what-digest-medium-chart')) {
        Highcharts.chart('who-is-doing-what-digest-medium-chart', {
          chart: { type: 'bar' },
          title: { text: 'Digest mediums (Slack / SMS / Email)' },
          xAxis: digestStackedBarXAxis(['Medium combination']),
          yAxis: digestStackedBarYAxis,
          plotOptions: { series: { stacking: 'normal' } },
          accessibility: { enabled: false },
          series: digestMediumSeries
        });
      }
    }

    function initializeStartPageChart() {
      if (typeof Highcharts === 'undefined') return;
      var el = document.getElementById('who-is-doing-what-start-page-chart');
      if (!el || !startPageSeries || startPageSeries.length === 0) return;

      Highcharts.chart('who-is-doing-what-start-page-chart', {
        chart: { type: 'bar' },
        title: { text: 'Start page preference' },
        xAxis: { categories: ['Start page'], reversedStacks: false },
        yAxis: {
          min: 0,
          title: { text: 'Active teammate count' },
          stackLabels: { enabled: true },
          reversedStacks: false
        },
        plotOptions: { series: { stacking: 'normal' } },
        accessibility: { enabled: false },
        series: startPageSeries
      });
    }

    function initializeSearchAskOgCharts() {
      if (typeof Highcharts === 'undefined') return;

      var volumeEl = document.getElementById('who-is-doing-what-search-ask-og-volume-chart');
      if (volumeEl && searchAskOgVolume.categories && searchAskOgVolume.categories.length > 0) {
        Highcharts.chart('who-is-doing-what-search-ask-og-volume-chart', {
          chart: { type: 'column' },
          title: { text: 'Searches & Ask OG messages by week' },
          accessibility: { enabled: false },
          xAxis: {
            categories: searchAskOgVolume.categories,
            title: { text: 'Week of' }
          },
          yAxis: {
            min: 0,
            title: { text: 'Count' },
            stackLabels: { enabled: true }
          },
          plotOptions: {
            column: {
              stacking: 'normal',
              dataLabels: { enabled: false }
            }
          },
          series: searchAskOgVolume.series
        });
      }

      var peopleEl = document.getElementById('who-is-doing-what-search-ask-og-people-chart');
      if (peopleEl && searchAskOgPeople.categories && searchAskOgPeople.categories.length > 0) {
        Highcharts.chart('who-is-doing-what-search-ask-og-people-chart', {
          chart: { type: 'column' },
          title: { text: 'People who searched or asked OG by week' },
          accessibility: { enabled: false },
          xAxis: {
            categories: searchAskOgPeople.categories,
            title: { text: 'Week of' }
          },
          yAxis: {
            min: 0,
            allowDecimals: false,
            title: { text: 'Unique people' }
          },
          plotOptions: {
            column: {
              dataLabels: { enabled: true }
            }
          },
          series: searchAskOgPeople.series
        });
      }
    }

    function initializeCharts() {
      initializePieChart();
      initializeHistogramChart();
      initializeDigestCoverageCharts();
      initializeStartPageChart();
      initializeSearchAskOgCharts();
    }

    var attempts = 0;
    function waitForHighcharts() {
      if (typeof Highcharts !== 'undefined') {
        initializeCharts();
      } else if (attempts < 100) {
        attempts++;
        setTimeout(waitForHighcharts, 100);
      } else {
        var script = document.createElement('script');
        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/highcharts/11.3.0/highcharts.js';
        script.onload = initializeCharts;
        document.head.appendChild(script);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', waitForHighcharts);
    } else {
      waitForHighcharts();
    }
    window.addEventListener('load', function() {
      if (typeof Highcharts !== 'undefined') initializeCharts();
    });
  })();
