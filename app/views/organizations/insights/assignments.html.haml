- content_for :title, "Insights: Assignments"

- content_for :go_back_link do
  = nav_hierarchy_with_previous(organization: @organization, crumbs: [{ label: "Assignments", url: organization_assignments_path(@organization) }, { label: "Insights: Assignments", url: nil }])

- content_for :header do
  = render "shared/object_lens_header/switchers",
           organization: @organization,
           current_object: :assignments,
           current_lens: :insights

/ Outcomes distribution chart
.row.mb-4
  .col-lg-12
    .card.border-0.shadow-sm
      .card-header.bg-primary.text-white
        %h5.mb-0
          %i.bi.bi-pie-chart.me-2
          Distribution of outcomes per assignment
      .card-body
        #outcomes-distribution-chart{style: "height: 320px;"}

/ Positions distribution (Requirement vs Suggested)
.row.mb-4
  .col-lg-12
    .card.border-0.shadow-sm
      .card-header.bg-secondary.text-white
        %h5.mb-0
          %i.bi.bi-bar-chart-steps.me-2
          Assignments by number of positions (Requirement vs Suggested)
      .card-body
        #positions-distribution-chart{style: "height: 320px;"}

%hr.my-5
%h5.text-muted.mb-3 Below are time-based analytics
= render 'timeframe_selector',
  timeframe: @timeframe,
  path_for: ->(**opts) { organization_insights_assignments_path(@organization, **opts) },
  show_custom: true,
  custom_from: @insights_custom_from,
  custom_to: @insights_custom_to,
  wrapper_class: 'mb-4'

/ Assignments with updates (by week)
.row.mb-4
  .col-lg-12
    .card.border-0.shadow-sm
      .card-header.bg-info.text-white
        %h5.mb-0
          %i.bi.bi-pencil-square.me-2
          Assignments with updates (by week) — #{@chart_title_period}
      .card-body
        #assignments-updated-chart{style: "height: 320px;"}

/ Finalized check-ins by rating (by week)
.row.mb-4
  .col-lg-12
    .card.border-0.shadow-sm
      .card-header.bg-success.text-white
        %h5.mb-0
          %i.bi.bi-check2-square.me-2
          Finalized check-ins by rating (by week) — #{@chart_title_period}
      .card-body
        #finalized-check-ins-chart{style: "height: 320px;"}

/ Assignment ratings in published observations (by week)
.row.mb-4
  .col-lg-12
    .card.border-0.shadow-sm
      .card-header.bg-warning.text-dark
        %h5.mb-0
          %i.bi.bi-star.me-2
          Assignment ratings in published observations (by week) — #{@chart_title_period}
      .card-body
        #observation-ratings-chart{style: "height: 320px;"}

%hr.my-5
%h5.mb-2 Experience survey usage
%p.text-muted.mb-4
  Snapshot cards and charts below are
  %strong all-time
  (not filtered by the timeframe selector). First vs re-submit trend uses the timeframe above.
  Counts include only submitted responses with at least one of Understandable, Possible, Relevant, or Personal alignment filled.

.row.g-3.mb-4
  .col-12.col-md-4
    .card.h-100.shadow-sm
      .card-body
        .text-muted Active teammates
        .display-6= @survey_insights.active_teammate_count
  .col-12.col-md-4
    .card.h-100.shadow-sm.border-success
      .card-body
        .text-muted Ever submitted (all-time)
        .display-6.text-success= @survey_insights.ever_submitted_teammate_count
  .col-12.col-md-4
    .card.h-100.shadow-sm.border-secondary
      .card-body
        .text-muted Never submitted (all-time)
        .display-6.text-secondary= @survey_insights.never_submitted_teammate_count

.row.g-3.mb-4
  .col-12.col-md-4
    .card.h-100.shadow-sm
      .card-body
        .text-muted Submitted responses (all-time)
        .display-6= @survey_insights.comment_stats.submitted_response_count
  .col-12.col-md-4
    .card.h-100.shadow-sm
      .card-body
        .text-muted Responses with a comment
        .display-6= @survey_insights.comment_stats.with_comment_count
  .col-12.col-md-4
    .card.h-100.shadow-sm
      .card-body
        .text-muted Comment rate
        .display-6
          = number_to_percentage(@survey_insights.comment_stats.comment_rate, precision: 1)

.row.mb-4
  .col-lg-12
    .card.border-0.shadow-sm
      .card-header.bg-dark.text-white
        %h5.mb-0
          %i.bi.bi-ui-checks.me-2
          Field take rates among active teammates (all-time)
      .card-body
        %p.text-muted.small.mb-3
          How many active teammates have ever filled each field on a submitted response.
        #survey-field-take-rates-chart{style: "height: 320px;"}

.row.mb-4
  .col-lg-12
    .card.border-0.shadow-sm
      .card-header.bg-dark.text-white
        %h5.mb-0
          %i.bi.bi-heart.me-2
          Personal alignment mix (all-time)
      .card-body
        %p.text-muted.small.mb-3
          Among submitted responses that include personal alignment.
        #survey-personal-alignment-mix-chart{style: "height: 320px;"}

.row.mb-4
  .col-lg-12
    .card.border-0.shadow-sm
      .card-header.bg-dark.text-white
        %h5.mb-0
          %i.bi.bi-diagram-3.me-2
          Survey-eligible assignment universe (all-time)
      .card-body
        %p.text-muted.small.mb-3
          Active and/or required means held via an active tenure or required on a currently held position.
        #survey-assignment-eligibility-chart{style: "height: 320px;"}

.row.mb-4
  .col-lg-12
    .card.border-0.shadow-sm
      .card-header.bg-dark.text-white
        %h5.mb-0
          %i.bi.bi-collection.me-2
          Coverage of survey-eligible assignments (all-time)
      .card-body
        #survey-assignment-coverage-chart{style: "height: 320px;"}

.row.mb-4
  .col-lg-12
    .card.border-0.shadow-sm
      .card-header.bg-dark.text-white
        %h5.mb-0
          %i.bi.bi-people.me-2
          Public aggregate readiness (all-time)
      .card-body
        %p.text-muted.small.mb-3
          Same public-aggregate rule as assignment pages: more than #{AssignmentSurveys::AssignmentAnalytics::PUBLIC_THRESHOLD} distinct respondents.
        #survey-public-aggregate-chart{style: "height: 320px;"}

.row.mb-4
  .col-lg-12
    .card.border-0.shadow-sm
      .card-header.bg-info.text-white
        %h5.mb-0
          %i.bi.bi-arrow-repeat.me-2
          Experience survey submits (by week) — #{@chart_title_period}
      .card-body
        %p.text-muted.small.mb-3
          First submit = first submitted response for that teammate × assignment. Later ones count as re-submits.
        #survey-submits-by-week-chart{style: "height: 320px;"}

:javascript
  (function() {
    var outcomesData = #{@outcomes_distribution_chart_data.to_json};
    var positionsData = #{@positions_distribution_chart_data.to_json};
    var updatedData = #{@assignments_updated_chart_data.to_json};
    var checkInsData = #{@finalized_check_ins_chart_data.to_json};
    var obsRatingsData = #{@observation_ratings_chart_data.to_json};
    var fieldTakeRatesData = #{@survey_insights.field_take_rates_chart_data.to_json};
    var alignmentMixData = #{@survey_insights.personal_alignment_mix_chart_data.to_json};
    var eligibilityData = #{@survey_insights.assignment_eligibility_chart_data.to_json};
    var coverageData = #{@survey_insights.assignment_coverage_chart_data.to_json};
    var publicAggregateData = #{@survey_insights.public_aggregate_chart_data.to_json};
    var submitsByWeekData = #{@survey_insights.submits_by_week_chart_data.to_json};

    // Same as UI: Working to meet (warning), Meeting (primary), Exceeding (success)
    var finalizedCheckInColors = ['#fd7e14', '#1e40af', '#166534'];

    // Same as observation rating buttons: Exceptional (success), Strong (primary), Misaligned (warning), Concerning (danger)
    var observationRatingColors = ['#166534', '#1e40af', '#fd7e14', '#dc3545'];

    var surveySubmitColors = ['#1e40af', '#fd7e14'];

    function chart(elId, title, categories, series, stacked, seriesColors, xTitle, yTitle) {
      if (typeof Highcharts === 'undefined') return;
      var el = document.getElementById(elId);
      if (!el) return;
      var resolvedXTitle = xTitle || (stacked ? 'Week of' : (elId === 'positions-distribution-chart' ? 'Number of positions' : 'Number of outcomes'));
      var resolvedYTitle = yTitle || (stacked ? 'Count' : 'Number of assignments');
      var s = series;
      if (seriesColors && seriesColors.length) {
        s = series.map(function(ser, i) {
          var out = { name: ser.name, data: ser.data };
          if (seriesColors[i]) out.color = seriesColors[i];
          return out;
        });
      }
      Highcharts.chart(elId, {
        chart: { type: 'column' },
        title: { text: title },
        accessibility: { enabled: false },
        xAxis: { categories: categories, title: { text: resolvedXTitle } },
        yAxis: { min: 0, title: { text: resolvedYTitle }, stackLabels: { enabled: !!stacked } },
        plotOptions: { column: { stacking: stacked ? 'normal' : null, dataLabels: { enabled: false } } },
        series: s
      });
    }

    function initCharts() {
      if (typeof Highcharts === 'undefined') return;
      chart('outcomes-distribution-chart', 'Outcomes per assignment', outcomesData.categories, outcomesData.series, false);
      chart('positions-distribution-chart', 'Requirement vs Suggested', positionsData.categories, positionsData.series, true);
      chart('assignments-updated-chart', 'Assignments with updates', updatedData.categories, updatedData.series, false);
      chart('finalized-check-ins-chart', 'Finalized check-ins by rating', checkInsData.categories, checkInsData.series, true, finalizedCheckInColors);
      chart('observation-ratings-chart', 'Assignment ratings in published observations', obsRatingsData.categories, obsRatingsData.series, true, observationRatingColors);
      chart('survey-field-take-rates-chart', 'Field take rates', fieldTakeRatesData.categories, fieldTakeRatesData.series, false, null, 'Field', 'Active teammates');
      chart('survey-personal-alignment-mix-chart', 'Personal alignment mix', alignmentMixData.categories, alignmentMixData.series, false, null, 'Alignment', 'Submitted responses');
      chart('survey-assignment-eligibility-chart', 'Survey-eligible universe', eligibilityData.categories, eligibilityData.series, false, null, null, 'Assignments');
      chart('survey-assignment-coverage-chart', 'Coverage of eligible assignments', coverageData.categories, coverageData.series, false, null, null, 'Assignments');
      chart('survey-public-aggregate-chart', 'Public aggregate readiness', publicAggregateData.categories, publicAggregateData.series, false, null, null, 'Assignments');
      chart('survey-submits-by-week-chart', 'Experience survey submits', submitsByWeekData.categories, submitsByWeekData.series, true, surveySubmitColors, 'Week of', 'Submits');
    }

    var attempts = 0;
    function waitForHighcharts() {
      if (typeof Highcharts !== 'undefined') {
        initCharts();
      } else if (attempts < 100) {
        attempts++;
        setTimeout(waitForHighcharts, 100);
      } else {
        var script = document.createElement('script');
        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/highcharts/11.3.0/highcharts.js';
        script.onload = initCharts;
        document.head.appendChild(script);
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', waitForHighcharts);
    } else {
      waitForHighcharts();
    }
    window.addEventListener('load', function() {
      if (typeof Highcharts !== 'undefined') initCharts();
    });
  })();
