- audit_page_label = "View Audit"
- content_for :title, teammate_context_page_title(@selected_teammate, audit_page_label)

- content_for :header do
  .d-flex.align-items-center.flex-wrap.gap-2
    %h1.mb-0.d-flex.align-items-center.flex-wrap.gap-2
      = render "shared/teammate_context/title_dropdown",
               organization: @organization,
               selected_teammate: @selected_teammate,
               viewable_teammate_groups: @viewable_teammate_groups,
               path_for_teammate: ->(tm) { audit_organization_employee_path(@organization, tm) },
               switch_aria_label: "Switch teammate for audit history"
      %span= " - #{audit_page_label}"

- content_for :header_action do
  = render 'people/view_switcher'

- content_for :go_back_link do
  = nav_hierarchy_with_previous(organization: @organization, crumbs: [{ label: clarity_hub_label, url: hub_organization_company_teammate_check_ins_path(@organization, @teammate) }, { label: "Acknowledge Check-ins", url: acknowledge_organization_company_teammate_check_ins_path(@organization, @teammate) }, { label: audit_page_label, url: nil }])

.alert.alert-light.border.mb-4
  %p.mb-2
    This page is the MAAP change history for #{@person.display_name}. Acknowledgement of finalized check-in ratings happens on the acknowledgement page.
  = link_to "Go to check-in acknowledgement",
            acknowledge_organization_company_teammate_check_ins_path(@organization, @teammate),
            class: "btn btn-primary"

-# MAAP Change History Section
.row
  .col-12
    .card
      .card-header
        %h5.mb-0
          %i.bi.bi-file-earmark-text.me-2
          MAAP Change History
        %small.text-muted MAAP snapshots for #{@person.display_name} in #{@organization.display_name}

      .card-body
        - if @maap_snapshots.any?
          .table-responsive
            %table.table.table-hover
              %thead
                %tr
                  %th Date
                  %th Created By
                  %th Reason
                  %th Status
                  %th Details
              %tbody
                - @maap_snapshots.each_with_index do |snapshot, index|
                  - previous_snapshot = @maap_snapshots[index + 1]
                  = render partial: 'organizations/employees/audit/snapshot_row', locals: { snapshot: snapshot, person: @person, organization: @organization, previous_snapshot: previous_snapshot }
        - else
          .text-center.py-5
            %i.bi.bi-clock-history.text-muted{style: "font-size: 3rem;"}
            %h5.text-muted.mt-3 No MAAP Changes Found
            %p.text-muted No MAAP snapshots have been created for #{@person.display_name} in #{@organization.display_name}.
