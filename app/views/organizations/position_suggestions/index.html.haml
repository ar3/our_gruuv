- content_for :title, "Position Suggestions"
- page_help_id = "positionSuggestionsHelp"
- closed_count = @closed_rounds_count.to_i
- closed_link_text = "View #{pluralize(closed_count, "closed suggestion round")}"

- content_for :go_back_link do
  = nav_hierarchy_with_previous(organization: @organization, crumbs: [{ label: "Positions", url: organization_positions_path(@organization) }, { label: "Position Suggestions", url: nil }])

- content_for :header do
  .d-flex.flex-wrap.align-items-center.gap-2
    %h1.mb-0.d-flex.align-items-center.gap-2
      Position Suggestions
      = render "shared/page_help/header_info_button",
               collapse_id: page_help_id,
               tooltip: "Give MAAP feedback on positions without edit access. Click for details."
    %span.badge.text-bg-warning
      %i.bi.bi-flask.me-1
      Beta

.collapse.mb-4{id: page_help_id}
  = render "organizations/position_suggestions/page_help"

%p.text-muted.small.mb-2
  - if @relevant_department_labels.present?
    Relevant departments:
    = @relevant_department_labels.to_sentence
  - else
    Relevant departments: none yet (based on active employment for you and your direct reports).
%p.mb-4
  = link_to closed_link_text, closed_organization_position_suggestions_path(@organization)

%section.mb-5
  %h2.h4.mb-3 Open suggestion rounds
  %p.text-muted.small.mb-3
    Rounds that are currently open. Relevant means positions in the departments listed above.

  .ps-3.ps-md-4
    %h3.h5.mb-2 I'm actively suggesting
    - if @actively_suggesting.any?
      %ul.list-group.mb-4
        - @actively_suggesting.each do |suggestion|
          = render "organizations/position_suggestions/open_round_row",
                   organization: @organization,
                   suggestion: suggestion,
                   participation: @participation_by_suggestion_id[suggestion.id],
                   mode: :active
    - else
      %p.text-muted.mb-4 No open rounds in your active suggesting queue.

    %h3.h5.mb-2 Relevant to me
    - if @relevant_open_rounds.any?
      %ul.list-group.mb-4
        - @relevant_open_rounds.each do |suggestion|
          = render "organizations/position_suggestions/open_round_row",
                   organization: @organization,
                   suggestion: suggestion,
                   participation: @participation_by_suggestion_id[suggestion.id],
                   mode: :relevant
    - else
      %p.text-muted.mb-4 No other open rounds in your relevant departments.

    - if @other_open_rounds.any?
      = render layout: "organizations/position_suggestions/collapsible_list",
               locals: { collapse_id: "otherOpenRounds", count: @other_open_rounds.size, item_label: "other open rounds" } do
        %ul.list-group.mb-0
          - @other_open_rounds.each do |suggestion|
            = render "organizations/position_suggestions/open_round_row",
                     organization: @organization,
                     suggestion: suggestion,
                     participation: @participation_by_suggestion_id[suggestion.id],
                     mode: :other

%section.mb-5
  %h2.h4.mb-3 Open a new suggestion round?
  %p.text-muted.small.mb-3
    Positions without an open round. Starting here opens a new round and adds you as a participant.

  .ps-3.ps-md-4
    %h3.h5.mb-2 Positions relevant to me
    - if @relevant_start_positions.any?
      %ul.list-group.mb-4
        - @relevant_start_positions.each do |position|
          = render "organizations/position_suggestions/start_position_row",
                   organization: @organization,
                   position: position,
                   primary: true
    - else
      %p.text-muted.mb-4 No relevant positions available to start.

    - if @other_start_positions.any?
      = render layout: "organizations/position_suggestions/collapsible_list",
               locals: { collapse_id: "otherStartPositions", count: @other_start_positions.size, item_label: "other positions" } do
        %ul.list-group.mb-0
          - @other_start_positions.each do |position|
            = render "organizations/position_suggestions/start_position_row",
                     organization: @organization,
                     position: position,
                     primary: false
