- content_for :title, "Create proposal · #{@proposal.proposed_title}"
- page_help_id = "maapSeatCreateShowPageHelp"

- content_for :header do
  .d-flex.flex-wrap.align-items-center.gap-2
    %h1.mb-0.d-flex.align-items-center.flex-wrap.gap-2
      %span Seat create proposal
      = render "shared/page_help/header_info_button",
               collapse_id: page_help_id,
               tooltip: "Propose a new Seat. Click for how create proposals work."
      - if policy(@proposal).edit?
        = link_to edit_organization_maap_seat_create_path(@organization, @proposal),
                  class: "btn btn-primary",
                  title: "Edit draft",
                  "aria-label" => "Edit draft",
                  data: { "bs-toggle" => "tooltip", "bs-placement" => "top" } do
          %i.bi.bi-pencil

- content_for :go_back_link do
  = nav_hierarchy_with_previous(organization: @organization, crumbs: [{ label: "Seats", url: organization_seats_path(@organization) }, { label: "Proposed Seat creates", url: organization_maap_seat_creates_path(@organization) }, { label: "Proposal", url: nil }])

.collapse.mb-4{id: page_help_id}
  = render "organizations/maap_seat_creates/page_help"

.row.justify-content-center
  .col-lg-8
    .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.mb-3
      %div
        %span.badge.me-2{class: proposal_status_badge_class(@proposal.status)}= @proposal.status
        %span.text-muted
          Proposed by #{@proposal.proposer.person.display_name}
          - if @proposal.create_key.present?
            · create_key #{@proposal.create_key}
      .d-flex.flex-wrap.gap-2
        = link_to markdown_organization_maap_seat_create_path(@organization, @proposal), class: "btn btn-outline-secondary btn-sm" do
          %i.bi.bi-download.me-1
          Download .md
        - if policy(@proposal).edit?
          = link_to "Edit draft", edit_organization_maap_seat_create_path(@organization, @proposal), class: "btn btn-outline-primary btn-sm"
        - if policy(@proposal).submit?
          - seat_submit_reason = seat_submit_disabled_reason(@proposal)
          - if seat_submit_reason.present?
            %button.btn.btn-primary.btn-sm{type: "button", disabled: true, "aria-label" => "Submit"} Submit
            %span.text-warning{"data-bs-toggle" => "tooltip", "data-bs-placement" => "top", "data-bs-title" => seat_submit_reason, tabindex: "0", role: "img", "aria-label" => "Submit blocked"}
              %i.bi.bi-exclamation-triangle
          - else
            = button_to "Submit", submit_organization_maap_seat_create_path(@organization, @proposal), method: :post, class: "btn btn-primary btn-sm"
        - if policy(@proposal).destroy?
          = button_to "Delete", organization_maap_seat_create_path(@organization, @proposal), method: :delete, class: "btn btn-outline-danger btn-sm", data: { turbo_confirm: "Delete this proposal?" }

    .card.mb-4
      .card-header
        %h5.mb-0 Proposed content
      .card-body
        %h6.text-muted Primary title
        - primary_title_name = Title.find_by(id: @payload.title_id)&.external_title || @payload.pending_title_name
        %p
          = primary_title_name.presence || @payload.title_id || "Pending"
          - if @payload.title_proposal_id.present?
            %span.badge.text-bg-light.ms-1 via Title proposal ##{@payload.title_proposal_id}
        %h6.text-muted Additional titles
        - additional_names = Array(@payload.additional_title_ids).filter_map { |id| Title.find_by(id: id)&.external_title }
        %p= additional_names.any? ? additional_names.join(", ") : "None"
        %h6.text-muted Needed by
        %p= @payload.seat_needed_by
        %h6.text-muted Job classification
        %p= @payload.job_classification
        %h6.text-muted Team
        - team_name = @payload.team_id.present? ? (Team.find_by(id: @payload.team_id)&.display_name || @payload.team_id) : @payload.pending_team_name
        %p
          = team_name.presence || "None"
          - if @payload.team_proposal_id.present?
            %span.badge.text-bg-light.ms-1 via Team proposal ##{@payload.team_proposal_id}
        %h6.text-muted Reports to seat
        %p= @payload.reports_to_seat_id.present? ? (Seat.find_by(id: @payload.reports_to_seat_id)&.display_name || @payload.reports_to_seat_id) : "None"
        %h6.text-muted Direct reports
        .markdown-content.mb-3= simple_format(@payload.reports.to_s.presence || "None")
        %h6.text-muted Why needed
        .markdown-content.mb-3= simple_format(@payload.why_needed.to_s.presence || "None")
        %h6.text-muted Why now
        .markdown-content.mb-3= simple_format(@payload.why_now.to_s.presence || "None")
        %h6.text-muted Costs / risks
        .markdown-content.mb-3= simple_format(@payload.costs_risks.to_s.presence || "None")

    - linked = seat_linked_proposal_links_in_approval_order(@proposal)
    - if linked.any?
      .card.mb-4
        .card-header
          %h5.mb-0 Linked proposals
        .card-body
          %p.text-muted.small.mb-2
            Suggested approval order (dependencies first):
            %strong Title → Team → Ability → Assignment → Position → Seat.
          %p.text-muted.small
            Seat Apply waits on Title and Team. Apply Title first, then edit this Seat to associate it before submitting. Position benefits from Title and Assignments already existing; Assignments benefit from Abilities.
          %ol.list-group.list-group-numbered.list-group-flush
            - linked.each do |link|
              - child = link.child_proposal
              - child_path = maap_proposal_show_path(@organization, child)
              %li.list-group-item.d-flex.justify-content-between.align-items-start.gap-2
                %div.ms-2.me-auto
                  %span.badge.text-bg-secondary.me-1= link.role
                  - child_label = child.proposed_title.presence || "#{child.proposable_type} ##{child.id}"
                  - if child_path.present?
                    = link_to child_label, child_path, class: "fw-semibold"
                  - else
                    %strong= child_label
                  .small.text-muted
                    = child.kind
                    · ##{child.id}
                %span.badge{class: proposal_status_badge_class(child.status)}= child.status

    - if @proposal.applied? || @proposal.rejected?
      - decision_verb = @proposal.applied? ? "accepted" : "rejected"
      - decision_alert_class = @proposal.applied? ? "alert-success" : "alert-danger"
      - decider_name = @proposal.decided_by&.person&.display_name || "Someone"
      .alert{class: "#{decision_alert_class} mb-4", role: "region", "aria-labelledby": "seat-create-proposal-decision"}
        %h5.alert-heading.mb-2{ id: "seat-create-proposal-decision" }
          %i.bi{class: "#{@proposal.applied? ? 'bi-check-circle' : 'bi-x-circle'} me-2"}
          Proposal #{decision_verb}
        %p.mb-2
          #{decider_name} #{decision_verb} this create proposal
          - if @proposal.decided_at.present?
            on #{l(@proposal.decided_at, format: :long)}
          - if @proposal.applied? && @proposal.proposable
            %span
              · created
              = link_to @proposal.proposable.display_name, organization_seat_path(@organization, @proposal.proposable)
        - if @proposal.decision_note.present?
          %p.mb-2
            %strong Note:
            = @proposal.decision_note
        - else
          %p.mb-2.text-muted No note was left with this decision.
    - else
      - decision_disabled_reason = maap_proposal_decision_disabled_reason(@proposal)
      .card.mb-4{ role: "region", "aria-labelledby": "seat-create-proposal-review" }
        .card-header
          %h5.mb-0{ id: "seat-create-proposal-review" } Review
        .card-body
          - if decision_disabled_reason.blank?
            = form_with url: apply_organization_maap_seat_create_path(@organization, @proposal), method: :post, local: true do
              %p.text-muted.small
                Applying creates a new Seat in draft status.
              .mb-3
                = label_tag :decision_note, "Note (optional)", class: "form-label"
                = text_area_tag :decision_note, nil, class: "form-control", rows: 2
              .d-flex.flex-wrap.gap-2
                = submit_tag "Apply proposal", class: "btn btn-success"
            = form_with url: reject_organization_maap_seat_create_path(@organization, @proposal), method: :post, local: true, class: "mt-3" do
              .mb-3
                = label_tag :decision_note, "Rejection note (optional)", class: "form-label"
                = text_area_tag :decision_note, nil, class: "form-control", rows: 2
              = submit_tag "Reject proposal", class: "btn btn-outline-danger", data: { turbo_confirm: "Reject this proposal?" }
          - else
            .d-flex.flex-wrap.align-items-center.gap-2
              %button.btn.btn-success{type: "button", disabled: true, "aria-label" => "Apply proposal"} Apply proposal
              %span.text-warning{"data-bs-toggle" => "tooltip", "data-bs-placement" => "top", "data-bs-title" => decision_disabled_reason, tabindex: "0", role: "img", "aria-label" => "Permission notice"}
                %i.bi.bi-exclamation-triangle
              %button.btn.btn-outline-danger{type: "button", disabled: true, "aria-label" => "Reject proposal"} Reject proposal
              %span.text-warning{"data-bs-toggle" => "tooltip", "data-bs-placement" => "top", "data-bs-title" => decision_disabled_reason, tabindex: "0", role: "img", "aria-label" => "Permission notice"}
                %i.bi.bi-exclamation-triangle
