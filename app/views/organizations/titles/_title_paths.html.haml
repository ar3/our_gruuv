-# Locals optional; falls back to instance vars from titles#show
- inbound_paths = local_assigns.fetch(:inbound_title_paths, @inbound_title_paths)
- outbound_paths = local_assigns.fetch(:outbound_title_paths, @outbound_title_paths)
- neighborhood = local_assigns.fetch(:title_path_neighborhood, @title_path_neighborhood)
- title = local_assigns.fetch(:title, @title)
- organization = local_assigns.fetch(:organization, @organization)

.card.mb-4{role: "region", "aria-labelledby": "title-paths-heading"}
  .card-header.d-flex.justify-content-between.align-items-center.gap-2.flex-wrap
    %h5.mb-0{id: "title-paths-heading"}
      %i.bi.bi-signpost-split.me-2
      Title paths
      - if title.end_cap?
        %span.badge.text-bg-secondary.ms-2 End-cap
    - if policy(title).manage_paths?
      = link_to manage_paths_organization_title_path(organization, title), class: "btn btn-outline-primary btn-sm" do
        %i.bi.bi-pencil.me-1
        Manage paths
  .card-body
    %p.text-muted.small.mb-3
      Likely title moves into and out of
      %strong= title.external_title
      \. Within-title level steps are automatic; these paths cover leaving this title’s exit level for another title’s landing level.

    .row.g-3.align-items-start.mb-3
      .col-md-5
        %h6.fw-semibold.mb-2 Before this title
        - if inbound_paths.blank?
          %p.text-muted.small.mb-0 No paths before this title.
        - else
          %ul.list-unstyled.mb-0
            - inbound_paths.each do |path|
              %li.mb-2
                .d-flex.align-items-center.justify-content-end.gap-2
                  .text-end.min-w-0
                    = link_to path.from_title.title_including_level, organization_title_path(organization, path.from_title), class: "text-decoration-none fw-semibold"
                    %span.badge.text-bg-light.border.ms-1= path.path_type_label
                  = render "organizations/positions/compare_link",
                    organization: organization,
                    left_position: path.from_title.exit_position,
                    right_position: title.entry_position

      .col-md-2.text-center
        %h6.fw-semibold.mb-2 This title
        %p.mb-0.fw-semibold= title.title_including_level

      .col-md-5
        %h6.fw-semibold.mb-2 After this title
        - if title.end_cap?
          %p.text-muted.small.mb-0 End-cap — no after paths.
        - elsif outbound_paths.blank?
          %p.text-muted.small.mb-0 No paths after this title yet.
        - else
          %ul.list-unstyled.mb-0
            - outbound_paths.each do |path|
              %li.mb-2
                .d-flex.align-items-center.gap-2
                  = render "organizations/positions/compare_link",
                    organization: organization,
                    left_position: title.exit_position,
                    right_position: path.to_title.entry_position
                  .min-w-0
                    = link_to path.to_title.title_including_level, organization_title_path(organization, path.to_title), class: "text-decoration-none fw-semibold"
                    %span.badge.text-bg-light.border.ms-1= path.path_type_label

    = render "organizations/titles/title_path_neighborhood_graph",
      neighborhood: neighborhood,
      organization: organization,
      title: title
