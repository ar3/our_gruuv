-# Locals: score (Titles::ExpectationAlignmentScore::Result), organization, title
- score = local_assigns.fetch(:score)
- organization = local_assigns.fetch(:organization)
- title = local_assigns.fetch(:title)
- show_card = score.show_card?
- calculated = score.calculated?
- can_see_score = score.can_see_score?
- can_refresh = score.can_refresh?
- score_band = can_see_score && score.score.present? ? Titles::ExpectationAlignmentScore.band_for_score(score.score) : nil
- callout_align = score_band ? Titles::ExpectationAlignmentScore.callout_text_align(score.score) : "start"
- score_pct = score.score.present? ? score.score.to_f.clamp(0, 100) : nil

- if show_card
  .card.mt-4.mb-4{ id: "title-expectation-alignment-score", role: "region", "aria-labelledby": "title-expectation-alignment-score-heading" }
    .card-header.d-flex.justify-content-between.align-items-center.gap-2.flex-wrap
      %h5.mb-0{ id: "title-expectation-alignment-score-heading" }
        %i.bi.bi-diagram-3.me-2
        Title Expectation Alignment Score
      - if can_refresh
        = button_to refresh_expectation_alignment_score_organization_title_path(organization, title),
          method: :post,
          class: "btn btn-outline-secondary btn-sm",
          form: { class: "d-inline" } do
          %i.bi.bi-arrow-clockwise.me-1
          Refresh
    .card-body
      %p.text-muted.small.mb-3
        Path clarity is 25% (end-cap or any after path). L1, L2, and L3 each contribute 25% from
        that position’s Expectation Alignment Score. Missing unarchived levels score 0 for that quarter.
        Refresh recalculates each position under this title, then this title score. Recalculated daily
        and when you queue a refresh.

      - if !calculated
        %p.mb-0.text-muted
          Not calculated yet. Use Refresh to queue the first calculation.
      - elsif can_see_score && score.score.present? && score_band
        .expectation-alignment-gauge.mb-4
          .expectation-alignment-gauge-callout.mb-1{ class: "text-#{callout_align}" }
            %i.bi{ class: [score_band[:icon], "assignment-survey-quality-icon", "assignment-survey-quality-#{score_band[:key]}"], "aria-hidden": "true" }
            %span.fw-semibold.ms-1{ class: "assignment-survey-quality-#{score_band[:key]}" }= score_band[:label]
            %span.ms-2
              %span.fs-4.fw-semibold= score.score.round
              %span.text-muted / 100
          .expectation-alignment-gauge-marker-row{ "aria-hidden": "true" }
            .expectation-alignment-gauge-marker{ style: "left: #{score_pct}%;" }
              %i.bi.bi-caret-down-fill
          .expectation-alignment-gauge-track{ role: "img", "aria-label": "Title Expectation Alignment Score #{score.score.round} out of 100, #{score_band[:label]}" }
            - Titles::ExpectationAlignmentScore::SCORE_BANDS.each do |band|
              - width = band[:max_exclusive] ? band[:max_exclusive] - band[:min] : 100 - band[:min]
              %span.expectation-alignment-gauge-segment{ class: "expectation-alignment-gauge-segment-#{band[:key]}", style: "width: #{width}%;", title: "#{band[:label]} (#{band[:min]}#{band[:max_exclusive] ? "–#{band[:max_exclusive]}" : "+"})" }
          .expectation-alignment-gauge-ticks.d-flex.justify-content-between.small.text-muted.mt-1
            - [0, 25, 50, 75, 100].each do |tick|
              %span= tick
          %p.expectation-alignment-gauge-blurb.small.mb-2.mt-3
            = title_expectation_alignment_score_blurb(score_band, title)
          - if score.calculated_at.present?
            %p.small.text-muted.mb-0
              Calculated
              = format_date_in_user_timezone(score.calculated_at, format: "%b %d, %Y %l:%M %p")

        %h6.fw-semibold.mb-2 Components
        .table-responsive
          %table.table.table-sm.mb-0
            %thead
              %tr
                %th Component
                %th Detail
                %th.text-end Points
            %tbody
              - score.cells.each do |cell|
                %tr{ class: ("table-secondary text-muted" if cell.contribution < cell.weight_points) }
                  %td= cell.label
                  %td
                    - if cell.key == "path_clarity"
                      - if cell.path_clarity_reason == "end_cap"
                        End-cap title
                      - elsif cell.path_clarity_reason == "has_outbound"
                        Has after path(s)
                      - else
                        Needs end-cap or after path
                        = link_to "Manage paths", manage_paths_organization_title_path(organization, title), class: "ms-1"
                    - elsif cell.position_id.present?
                      = link_to cell.position_name, organization_position_path(organization, cell.position_id), class: "text-decoration-none"
                      %span.text-muted.ms-1
                        Position EAS
                        = cell.position_eas.round
                        \/ 100
                    - else
                      Missing L#{cell.minor} position
                  %td.text-end
                    = cell.contribution.round(1)
                    %span.text-muted
                      \/
                      = cell.weight_points.round(1)
      - else
        %p.mb-0.text-muted
          Not calculated yet. Use Refresh to queue the first calculation.
