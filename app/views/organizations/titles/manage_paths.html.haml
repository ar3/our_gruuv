- content_for :title, "Manage title paths for #{@title.external_title}"
- content_for :header, "Manage title paths for #{@title.external_title}"
- content_for :return_url, @return_url
- content_for :return_text, @return_text

.card
  .card-header
    %h5.mb-0
      %i.bi.bi-signpost-split.me-2
      Title Paths
    %p.mb-0.text-muted
      Set whether each title is inbound, outbound, or not associated—and choose a path type for associated titles.
      End-cap titles (e.g. CEO) have no outbound paths. Within-title level progression is automatic.

  .card-body
    = form_with url: update_paths_organization_title_path(@organization, @title), method: :patch, local: true,
      data: { controller: "title-paths-form" } do |form|
      .form-check.mb-4
        = check_box_tag :end_cap, "1", @title.end_cap?, class: "form-check-input", id: "title_end_cap",
          data: { action: "change->title-paths-form#toggleEndCap", title_paths_form_target: "endCap" }
        %label.form-check-label{for: "title_end_cap"}
          %strong End-cap title
          %span.text-muted — no further titles beyond this one (clears outbound paths on save)

      = render "organizations/titles/title_path_form_sections",
        form: form,
        associated_titles: @associated_titles,
        available_titles: @available_titles,
        existing_paths_by_title_id: @existing_paths_by_title_id,
        subject_name: @title.external_title,
        end_cap: @title.end_cap?

      .mt-4.d-flex.justify-content-between
        = link_to "Cancel", @return_url, class: "btn btn-secondary"
        = form.submit "Save Title Paths", class: "btn btn-primary"
