- content_for :title, "Edit proposal · #{@title.external_title}"

- content_for :header do
  %h1.mb-0 Edit draft proposal

- content_for :go_back_link do
  = nav_hierarchy_with_previous(organization: @organization, crumbs: [{ label: "Positions", url: organization_positions_path(@organization) }, { label: @title.external_title, url: organization_title_path(@organization, @title) }, { label: "Proposal", url: organization_title_maap_proposal_path(@organization, @title, @proposal) }, { label: "Edit", url: nil }])

.row.justify-content-center
  .col-lg-8
    = form_with model: @proposal, url: organization_title_maap_proposal_path(@organization, @title, @proposal), method: :patch, local: true, scope: :maap_proposal do |f|
      .mb-3
        = f.label :external_title, "External title", class: "form-label"
        = f.text_field :external_title, value: @payload.external_title, class: "form-control", required: true
      .mb-3
        = f.label :position_major_level_id, "Position major level", class: "form-label"
        = f.collection_select :position_major_level_id, @position_major_levels, :id, :display_name, { selected: @payload.position_major_level_id }, { class: "form-select", required: true }
      .mb-3
        = f.label :department_id, "Department", class: "form-label"
        = f.collection_select :department_id, @departments, :id, :name, { include_blank: "Company-wide / none", selected: @payload.department_id }, { class: "form-select" }
      .mb-3
        = f.label :position_summary, "Position summary", class: "form-label"
        = f.text_area :position_summary, value: @payload.position_summary, class: "form-control", rows: 4
      .mb-3
        = f.label :alternative_titles, "Alternative titles", class: "form-label"
        = f.text_area :alternative_titles, value: @payload.alternative_titles, class: "form-control", rows: 2

      .d-flex.flex-wrap.gap-2.mt-4
        = f.submit "Save draft", class: "btn btn-primary"
        = link_to "Cancel", organization_title_maap_proposal_path(@organization, @title, @proposal), class: "btn btn-outline-secondary"
