- rating = local_assigns[:observation_rating]
- rating_words = rating.decorate.rating_to_words
- if local_assigns[:include_aspiration_name]
  - rateable = rating.rateable
  - org = local_assigns[:organization] || @organization || rating.observation&.company
  - name_html = if org && rateable
    - link_to(content_tag(:strong, rateable.name), internal_rateable_path(org, rateable), class: "text-decoration-none")
  - else
    - content_tag(:strong, rateable&.name)
  An #{content_tag(:strong, rating_words)} exemplification of #{name_html}
- else
  An #{content_tag(:strong, rating_words)} exemplification
