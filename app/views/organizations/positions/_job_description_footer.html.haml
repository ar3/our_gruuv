-# Job Description Footer/Boilerplate Section
-# Usage: = render 'job_description_footer', organization:, title:, seat:, teammate:, public_view:, signature_name:, signature_signed_at:
- organization = local_assigns[:organization] || local_assigns[:company]
- title = local_assigns[:title]
- seat = local_assigns[:seat]
- teammate = local_assigns[:teammate]
- public_view = local_assigns.fetch(:public_view, false)
- signature_name = local_assigns[:signature_name].presence
- signature_signed_at = local_assigns[:signature_signed_at]
- hr = JobDescriptionHrText.for(organization: organization, title: title, seat: seat)
- cascade = hr.source_cascade
- collapse_id = "jd-hr-source-#{[organization.id, title&.id, seat&.id, teammate&.id].compact.join('-')}"

.mt-5.jd-hr-footer
  .jd-hr-provenance.small.text-muted.mb-3
    %a.d-inline-flex.align-items-center.gap-1.text-muted.text-decoration-none{href: "##{collapse_id}", "data-bs-toggle" => "collapse", role: "button", "aria-expanded" => "false", "aria-controls" => collapse_id}
      %i.bi.bi-info-circle
      %span Current source for #{JobDescriptionHrText::GROUP_NAME}
      %span.not-collapsed
        %i.bi.bi-chevron-up{"aria-hidden" => "true"}
      %span.collapsed
        %i.bi.bi-chevron-down{"aria-hidden" => "true"}
    .collapse{id: collapse_id}
      %p.mb-2.mt-2
        These fields use the first available source (most specific wins):
      %ul.mb-0.ps-3
        - cascade.each do |node|
          %li.mb-1
            = render "organizations/positions/job_description_hr_source_node",
                     node: node,
                     organization: organization,
                     title: title,
                     seat: seat,
                     teammate: teammate,
                     public_view: public_view

  %p.text-muted
    %em= hr.disclaimer

  %p.text-muted
    %strong Work environment:
    = hr.work_environment

  %p.text-muted
    %strong Physical requirements:
    = hr.physical_requirements

  %p.text-muted
    %strong Travel:
    = hr.travel

  %hr.my-4

  %p.text-muted
    %em Employee signature below indicates the employee's understanding of the requirements, essential functions and duties of the position.

  .row.mt-4.jd-signature-block
    .col-md-6
      %p.text-muted.mb-1
        %strong Employee Signature:
      .jd-signature-line
        - if signature_name.present?
          %span.jd-signature-ink= signature_name
        - else
          %span.jd-signature-blank _____________________________
    .col-md-6
      %p.text-muted.mb-1
        %strong Date:
      .jd-signature-line
        - if signature_signed_at.present?
          %span.jd-signature-ink= format_time_in_user_timezone(signature_signed_at, format: "%B %-d, %Y")
        - else
          %span.jd-signature-blank _____________________________
