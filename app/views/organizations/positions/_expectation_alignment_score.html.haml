-# Locals: score (Positions::ExpectationAlignmentScore::Result), organization, position
- score = local_assigns.fetch(:score)
- organization = local_assigns.fetch(:organization)
- position = local_assigns.fetch(:position)
- show_card = score.show_card?
- calculated = score.calculated?
- can_see_score = score.can_see_score?
- can_refresh = score.can_refresh?
- score_band = can_see_score && score.score.present? ? Positions::ExpectationAlignmentScore.band_for_score(score.score) : nil
- callout_align = score_band ? Positions::ExpectationAlignmentScore.callout_text_align(score.score) : "start"
- score_pct = score.score.present? ? score.score.to_f.clamp(0, 100) : nil

- if show_card
  .card.mt-4.mb-4{ role: "region", "aria-labelledby": "position-expectation-alignment-score" }
    .card-header.d-flex.justify-content-between.align-items-center.gap-2.flex-wrap
      %h5.mb-0{ id: "position-expectation-alignment-score" }
        %i.bi.bi-diagram-3.me-2
        Position Expectation Alignment Score
      - if can_refresh
        = button_to refresh_expectation_alignment_score_organization_position_path(organization, position),
          method: :post,
          class: "btn btn-outline-secondary btn-sm",
          form: { class: "d-inline" } do
          %i.bi.bi-arrow-clockwise.me-1
          Refresh
    .card-body
      %p.text-muted.small.mb-3
        Structural completeness of this position's required assignments—each must have outcomes,
        then scores 0% / 50% / 100% for 0 / 1 / 2+ ability milestones on that assignment.
        Suggested assignments and direct position abilities are not counted. Recalculated daily and
        when you queue a refresh.

      - if !calculated
        %p.mb-0.text-muted
          Not calculated yet. Use Refresh to queue the first calculation.
      - elsif can_see_score && score.score.present? && score_band
        .expectation-alignment-gauge.mb-4
          .expectation-alignment-gauge-callout.mb-1{ class: "text-#{callout_align}" }
            %i.bi{ class: [score_band[:icon], "assignment-survey-quality-icon", "assignment-survey-quality-#{score_band[:key]}"], "aria-hidden": "true" }
            %span.fw-semibold.ms-1{ class: "assignment-survey-quality-#{score_band[:key]}" }= score_band[:label]
            %span.ms-2
              %span.fs-4.fw-semibold= score.score.round
              %span.text-muted / 100
          .expectation-alignment-gauge-marker-row{ "aria-hidden": "true" }
            .expectation-alignment-gauge-marker{ style: "left: #{score_pct}%;" }
              %i.bi.bi-caret-down-fill
          .expectation-alignment-gauge-track{ role: "img", "aria-label": "Position Expectation Alignment Score #{score.score.round} out of 100, #{score_band[:label]}" }
            - Positions::ExpectationAlignmentScore::SCORE_BANDS.each do |band|
              - width = band[:max_exclusive] ? band[:max_exclusive] - band[:min] : 100 - band[:min]
              %span.expectation-alignment-gauge-segment{ class: "expectation-alignment-gauge-segment-#{band[:key]}", style: "width: #{width}%;", title: "#{band[:label]} (#{band[:min]}#{band[:max_exclusive] ? "–#{band[:max_exclusive]}" : "+"})" }
          .expectation-alignment-gauge-ticks.d-flex.justify-content-between.small.text-muted.mt-1
            - [0, 25, 50, 75, 100].each do |tick|
              %span= tick
          %p.expectation-alignment-gauge-blurb.small.mb-2.mt-3
            = position_expectation_alignment_score_blurb(score_band, position)
          - if score.calculated_at.present?
            %p.small.text-muted.mb-0
              Calculated
              = format_date_in_user_timezone(score.calculated_at, format: "%b %d, %Y %l:%M %p")

        %h6.fw-semibold.mb-2 Required assignments
        - if score.cells.empty?
          %p.mb-0.text-muted
            No required assignments on this position—score is 0.
        - else
          .table-responsive
            %table.table.table-sm.mb-0
              %thead
                %tr
                  %th Assignment
                  %th.text-end Outcomes
                  %th.text-end Abilities
                  %th.text-end Completeness
                  %th.text-end Points
              %tbody
                - score.cells.each do |cell|
                  %tr{ class: ("table-secondary text-muted" if cell.completeness_pct < 100) }
                    %td
                      - if cell.assignment_id.present?
                        = link_to cell.assignment_title, organization_assignment_path(organization, cell.assignment_id), class: "text-decoration-none"
                      - else
                        = cell.assignment_title
                      - if cell.blocker == "missing_outcomes"
                        %div.small No outcomes — 0 points for this assignment
                      - elsif cell.blocker == "missing_abilities"
                        %div.small Needs ability milestones
                      - elsif cell.blocker == "partial_abilities"
                        %div.small Needs one more ability milestone
                    %td.text-end= cell.outcomes_count
                    %td.text-end= cell.abilities_count
                    %td.text-end
                      = "#{cell.completeness_pct}%"
                    %td.text-end
                      = cell.contribution.round(1)
                      %span.text-muted
                        \/
                        = cell.weight_points.round(1)
      - else
        %p.mb-0.text-muted
          Not calculated yet. Use Refresh to queue the first calculation.
