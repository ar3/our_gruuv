- content_for :title, "OG Academy"
- org_name = current_organization&.name || "Organization"
- progress = @academy_progress
- casual = current_company_teammate.person.casual_name
- page_help_id = "ogAcademyPageHelp"

- content_for :header do
  .d-flex.flex-wrap.align-items-center.gap-2
    %h1.mb-0.d-flex.align-items-center.flex-wrap.gap-2
      %span.fs-1.fw-medium OG Academy
      = render "shared/page_help/header_info_button",
               collapse_id: page_help_id,
               tooltip: "Learn OG by doing — Quick Start, practice milestones, home base. Click for details."
    %span.badge.text-bg-warning
      %i.bi.bi-flask.me-1
      Beta
  %p.lead.text-muted.mb-0
    Learn OurGruuv by doing... quick start now... working towards deeper mastery over time.

.collapse.mb-4{id: page_help_id}
  = render "organizations/og_academy/page_help"

= render "shared/context_callout", margin_class: "mb-4" do
  Welcome to OG Academy; where you begin your journey towards continuous clarity and unfading growth.
  Use the
  %strong Quick Start
  section to get to the most common actions... taking actions will add steps on your way to earning your OG Academy Milestones (OG Mastery is a practice Ability)... eventually as you get more comfortable, you'll be able to set a preferred home/starting page that suits your specific needs.

-# ——— 1. Quick Start ———
= render "shared/section_header",
         title: "Quick Start",
         icon: "bi-lightning-charge",
         description: "Most common actions — names open One Thing",
         include_top_header_margin: false

%section.mb-5{role: "region", "aria-labelledby": "og-academy-quick-start"}
  %span.visually-hidden#og-academy-quick-start Quick Start

  .d-grid.gap-3
    - @quick_start_people.each do |tm|
      - person = tm.person
      - is_self = tm.id == current_company_teammate.id
      - one_thing_path = organization_company_teammate_one_on_one_link_path(current_organization, tm)
      - observe_path = ogos_organization_company_teammate_path(current_organization, tm)
      - goals_path = my_growth_goals_organization_company_teammate_path(current_organization, tm)
      - check_in_path = up_next_organization_company_teammate_check_ins_path(current_organization, tm)
      - row_data = (@quick_start_row_data_by_teammate_id || {})[tm.id]
      - clarity_records = (@quick_start_clarity_eh_by_teammate_id || {})[tm.id]
      - goals_eh_records = (@quick_start_goals_eh_by_teammate_id || {})[tm.id]
      - action_breakdown = EngagementHealth::ClarityActionMetrics.for_records(clarity_records)
      - names = teammate_and_manager_short_names(tm, current_organization)
      - action_popover_html = check_ins_health_action_popover_html(records: clarity_records, employee_name: names[:employee], manager_name: names[:manager])
      - ogos_received_count = row_data&.ogos_received_30d_count.to_i
      - healthy_goals_count = og_academy_healthy_goals_count(goals_eh_records)
      - clarity_caption = action_breakdown.present? && action_breakdown.total_slots.to_i.positive? ? "#{action_breakdown.ok_percentage.round(1)}% clear" : "No clarity data yet"
      .card.border-0.shadow-sm
        .card-body
          .row.g-3.align-items-center
            .col-12.col-lg-3
              = link_to one_thing_path, class: "d-flex align-items-center gap-3 text-decoration-none" do
                = teammate_profile_image(tm, size: 48)
                %div.min-w-0
                  .fs-4.fw-semibold.text-body
                    = person.casual_name
                    - if is_self
                      %span.badge.text-bg-secondary.ms-1 you
                  .small.text-muted= one_thing_label_for(tm, viewer: current_company_teammate)
            .col-12.col-lg-9
              .row.g-3
                .col-12.col-md-4
                  = link_to observe_path, class: "text-decoration-none h-100 d-block" do
                    .card.h-100.hover-lift.border-secondary{style: "cursor: pointer;"}
                      .card-body.p-4.d-flex.justify-content-between.align-items-start.gap-3
                        .flex-grow-1.min-w-0
                          %h4.fw-bold.mb-2 Observe
                          %p.text-muted.mb-0.small= og_academy_ogos_received_caption(ogos_received_count)
                        %i.bi.bi-eye.display-4.text-primary.flex-shrink-0
                .col-12.col-md-4
                  = link_to goals_path, class: "text-decoration-none h-100 d-block" do
                    .card.h-100.hover-lift.border-secondary{style: "cursor: pointer;"}
                      .card-body.p-4.d-flex.justify-content-between.align-items-start.gap-3
                        .flex-grow-1.min-w-0
                          %h4.fw-bold.mb-2 Goals
                          %p.text-muted.mb-0.small= og_academy_healthy_goals_caption(healthy_goals_count)
                        %i.bi.bi-bullseye.display-4.text-success.flex-shrink-0
                .col-12.col-md-4
                  = link_to check_in_path, class: "text-decoration-none h-100 d-block" do
                    .card.h-100.hover-lift.border-primary{style: "cursor: pointer;"}
                      .card-body.p-4.d-flex.justify-content-between.align-items-start.gap-3
                        .flex-grow-1.min-w-0
                          %h4.fw-bold.mb-2 Check-in
                          - if action_popover_html.present?
                            %p.text-muted.mb-0.small{role: "button", tabindex: 0, style: "cursor: help;", data: { bs_toggle: "popover", bs_trigger: "hover focus", bs_placement: "top", bs_html: "true", bs_content: action_popover_html }}= clarity_caption
                          - else
                            %p.text-muted.mb-0.small= clarity_caption
                        %i.bi.bi-chat-square-text.display-4.text-info.flex-shrink-0

-# ——— 2. Practice milestones ———
= render "shared/section_header",
         title: "OG Mastery milestones",
         icon: "bi-award",
         description: "Practice Ability — earliest unfinished milestone is open"

%section.mb-5{role: "region", "aria-labelledby": "og-academy-milestones"}
  %span.visually-hidden#og-academy-milestones OG Mastery milestones
  .alert.alert-light.border.mb-4
    %p.mb-1
      %strong Practice track — OG Mastery is not a company Ability on your MAAP.
    %p.mb-0.small.text-muted
      Cards use Ability milestone language so you learn the ceremony. Real job milestones are still awarded by managers on real abilities.

  - core_levels = progress.levels.select { |l| l.level < OgAcademy::ProgressService::ADVANCED_FROM_LEVEL }
  - advanced_levels = progress.levels.select { |l| l.level >= OgAcademy::ProgressService::ADVANCED_FROM_LEVEL }

  - core_levels.each do |lvl|
    = render "organizations/og_academy/level_card", level: lvl, progress: progress, casual: casual

  - if advanced_levels.any?
    - if progress.collapsed_advanced?
      .mt-3
        %button.btn.btn-outline-secondary{type: "button", data: { bs_toggle: "collapse", bs_target: "#og-academy-advanced-levels" }, aria: { expanded: "false", controls: "og-academy-advanced-levels" }}
          Manager & admin levels (M3+)
        .collapse#og-academy-advanced-levels.mt-3
          .alert.alert-secondary.small
            These levels are for people with direct reports (M3) or employment/admin responsibility (M4+). You can explore the criteria anytime; they are not required for every teammate.
          - advanced_levels.each do |lvl|
            = render "organizations/og_academy/level_card", level: lvl, progress: progress, casual: casual
    - else
      - advanced_levels.each do |lvl|
        = render "organizations/og_academy/level_card", level: lvl, progress: progress, casual: casual

-# ——— 3. Home page ———
= render "shared/section_header",
         title: "Choose your home base",
         icon: "bi-house-door",
         description: "Set where you land when you open this org's Gruuv"

%section.mb-5{role: "region", "aria-labelledby": "og-academy-home"}
  %span.visually-hidden#og-academy-home Choose your home base
  %p.text-muted.mb-3
    When you're ready for a customized day-to-day home, pick one below. Advanced users often choose
    %strong Start Here.
    You can always return to OG Academy from your profile menu.

  - home_options = og_academy_home_options(current_organization, current_company_teammate, casual)
  - current_start = start_page_preference(current_organization, current_person)
  - allowed = start_page_options_for_select(current_organization, current_company_teammate).map(&:last)

  -# Growth row first as a grouped band
  - growth_values = %w[my_growth_experiences my_growth_abilities my_growth_goals]
  - growth_options = home_options.select { |value, *_| growth_values.include?(value) }
  - other_options = home_options.reject { |value, *_| growth_values.include?(value) }

  - if growth_options.any?
    %h3.h6.text-muted.mb-2 My Growth
    .row.g-3.mb-4
      - growth_options.each do |value, label, icon, blurb|
        - next unless allowed.include?(value)
        .col-12.col-md-4
          = render "organizations/og_academy/home_option_card",
                   value: value, label: label, icon: icon, blurb: blurb, current_start: current_start

  %h3.h6.text-muted.mb-2 Everyday homes
  .row.g-3
    - other_options.each do |value, label, icon, blurb|
      - next unless allowed.include?(value) || value == "og_academy"
      .col-12.col-md-6.col-lg-4
        = render "organizations/og_academy/home_option_card",
                 value: value, label: label, icon: icon, blurb: blurb, current_start: current_start
