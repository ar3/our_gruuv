- content_for :title, "OG Academy"
- casual = current_company_teammate.person.casual_name
- page_help_id = "ogAcademyPageHelp"

- content_for :header do
  .d-flex.flex-wrap.align-items-center.gap-2
    %h1.mb-0.d-flex.align-items-center.flex-wrap.gap-2
      %span.fs-1.fw-medium OG Academy
      = render "shared/page_help/header_info_button",
               collapse_id: page_help_id,
               tooltip: "Learn OG by doing — Quick Start, practice milestones, home base. Click for details."
  %p.lead.text-muted.mb-0
    Learn OurGruuv by doing... quick start now... working towards deeper mastery over time.

.collapse.mb-4{id: page_help_id}
  = render "organizations/og_academy/page_help"

= render "shared/context_callout", margin_class: "mb-4" do
  Welcome to OG Academy; where you begin your journey towards continuous clarity and unfading growth.
  Use the
  %strong Quick Start
  section to get to the most common actions... taking actions will add steps on your way to earning your OG Academy Milestones (OG Mastery is a practice Ability)... eventually as you get more comfortable, you'll be able to set a preferred home/starting page that suits your specific needs.

-# ——— 1. Quick Start ———
= render "shared/section_header",
         title: "Quick Start",
         icon: "bi-lightning-charge",
         description: "Most common actions — names open One Thing",
         include_top_header_margin: false

%section.mb-5{role: "region", "aria-labelledby": "og-academy-quick-start"}
  %span.visually-hidden#og-academy-quick-start Quick Start
  = turbo_frame_tag "og_academy_quick_start",
                    src: organization_og_academy_quick_start_path(current_organization),
                    loading: :lazy,
                    target: "_top",
                    data: { controller: "reload-turbo-frame" } do
    = render "organizations/og_academy/lazy_frame_placeholder", label: "Loading Quick Start…"

-# ——— 2. Practice milestones ———
= render "shared/section_header",
         title: "OG Mastery milestones",
         icon: "bi-award",
         description: "Practice Ability — earliest unfinished milestone is open"

%section.mb-5{role: "region", "aria-labelledby": "og-academy-milestones"}
  %span.visually-hidden#og-academy-milestones OG Mastery milestones
  = turbo_frame_tag "og_academy_milestones",
                    src: organization_og_academy_milestones_path(current_organization),
                    loading: :lazy,
                    target: "_top",
                    data: { controller: "reload-turbo-frame" } do
    = render "organizations/og_academy/lazy_frame_placeholder", label: "Loading OG Mastery milestones…"

-# ——— 3. Home page ———
= render "shared/section_header",
         title: "Choose your home base",
         icon: "bi-house-door",
         description: "Set where you land when you open this org's Gruuv"

%section.mb-5{role: "region", "aria-labelledby": "og-academy-home"}
  %span.visually-hidden#og-academy-home Choose your home base
  %p.text-muted.mb-3
    When you're ready for a customized day-to-day home, pick one below. Advanced users often choose
    %strong Start Here.
    You can always return to OG Academy from your profile menu.

  - home_options = og_academy_home_options(current_organization, current_company_teammate, casual)
  - current_start = start_page_preference(current_organization, current_person)
  - allowed = start_page_options_for_select(current_organization, current_company_teammate).map(&:last)

  -# Growth row first as a grouped band
  - growth_values = %w[my_growth_experiences my_growth_abilities my_growth_goals]
  - growth_options = home_options.select { |value, *_| growth_values.include?(value) }
  - other_options = home_options.reject { |value, *_| growth_values.include?(value) }

  - if growth_options.any?
    %h3.h6.text-muted.mb-2 My Growth
    .row.g-3.mb-4
      - growth_options.each do |value, label, icon, blurb|
        - next unless allowed.include?(value)
        .col-12.col-md-4
          = render "organizations/og_academy/home_option_card",
                   value: value, label: label, icon: icon, blurb: blurb, current_start: current_start

  %h3.h6.text-muted.mb-2 Everyday homes
  .row.g-3
    - other_options.each do |value, label, icon, blurb|
      - next unless allowed.include?(value) || value == "og_academy"
      .col-12.col-md-6.col-lg-4
        = render "organizations/og_academy/home_option_card",
                 value: value, label: label, icon: icon, blurb: blurb, current_start: current_start
