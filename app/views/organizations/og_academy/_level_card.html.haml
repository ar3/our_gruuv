- level = local_assigns.fetch(:level)
- progress = local_assigns.fetch(:progress)
- casual = local_assigns.fetch(:casual)
- open = og_academy_level_open?(level, progress)
- visible = progress.visible_for?(level)
- collapse_id = "og-academy-level-#{level.level}"
- heading = og_academy_milestone_heading(level)
- earned = level.complete?

.card.mb-3.og-academy-certificate-card{class: (earned ? "border-success" : (open ? "border-primary" : ""))}
  .card-header.bg-white{id: "#{collapse_id}-header"}
    %button.btn.btn-link.text-decoration-none.text-body.w-100.p-0{type: "button", data: { bs_toggle: "collapse", bs_target: "##{collapse_id}" }, aria: { expanded: open.to_s, controls: collapse_id }}
      .og-academy-level-header.d-flex.flex-nowrap.align-items-start.justify-content-between.gap-3.text-start
        .og-academy-level-header__main
          .d-flex.align-items-center.gap-2.flex-wrap
            %span.fw-semibold= heading
            - if earned
              %span.badge.text-bg-success Milestone Certified
            - elsif open
              %span.badge.text-bg-warning.text-dark In progress
            - unless visible
              %span.badge.text-bg-light.border not your track yet
          %p.small.text-muted.mb-0.mt-1.og-academy-level-header__caption= og_academy_milestone_trust_caption(level, casual, earned: earned)
        %span.small.text-muted.text-nowrap.og-academy-level-header__count.pt-1
          = "#{level.done_count}/#{level.total_count} sealed"
          %i.bi.bi-chevron-down.ms-1

  .collapse{id: collapse_id, class: (open ? "show" : nil), "aria-labelledby": "#{collapse_id}-header"}
    .card-body.border-top
      = render "organizations/og_academy/certificate",
               level: level,
               casual: casual,
               earned: earned
      = render "shared/context_callout", margin_class: "mb-0 mt-3" do
        = og_academy_milestone_examples_caption
