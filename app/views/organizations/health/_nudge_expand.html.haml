-# locals: label, collapse_id, nudge_path, manager, skip_level, recipients_manager, recipients_manager_and_skip,
-#         message, last_nudge, manager_id, health_object:, editable:, body:, suggested_body:, og_consulted_body:,
-#         consultation:, consult_path:, consult_status_path:
- can_send_manager = health_nudge_can_send?(recipients_manager)
- can_send_manager_and_skip = skip_level.present? && health_nudge_can_send?(recipients_manager_and_skip)
- manager_disabled_reason = health_nudge_send_disabled_reason(recipients_manager, viewer: current_company_teammate)
- skip_disabled_reason = health_nudge_send_disabled_reason(recipients_manager_and_skip, viewer: current_company_teammate, skip_required: true, skip_level: skip_level)
- manager_only_label = health_nudge_manager_only_button_label(manager)
- manager_and_skip_label = health_nudge_manager_and_skip_button_label(manager, skip_level)
- editable = local_assigns.fetch(:editable, false)
- body = local_assigns[:body]
- suggested_body = local_assigns[:suggested_body]
- og_consulted_body = local_assigns[:og_consulted_body]
- consultation = local_assigns[:consultation]
- consult_path = local_assigns[:consult_path]
- consult_status_path = local_assigns[:consult_status_path]
- inflight = consultation&.in_flight?
- draft_text = body.presence || message.preview_plain
- nudge_open = local_assigns.fetch(:nudge_open, false)

.collapse{id: collapse_id, class: ("show" if nudge_open)}
  .health-dashboard-nudge-panel
    - if editable
      %div{"data-controller" => "protect-flow-nudge-draft"}
        .mb-3
          %label.form-label.fw-semibold.small.text-muted.mb-1 Message
          = text_area_tag :body_preview,
                          draft_text,
                          class: "form-control font-monospace small",
                          rows: 12,
                          maxlength: HealthNudges::SuggestedBody::MAX_CHARS,
                          data: { protect_flow_nudge_draft_target: "textarea", action: "input->protect-flow-nudge-draft#syncHidden" }
          %p.small.text-muted.mb-2
            Plain text for the main Slack message. A large
            %strong Open Overall Health
            button is added automatically. Person details stay in the thread.
          .d-flex.flex-wrap.align-items-center.gap-2.mb-2
            - if consult_path.present?
              %span.small.text-muted Want help with the content to send:
              = form_with url: consult_path, method: :post, local: true, data: { turbo: false }, html: { class: "d-inline" } do
                = hidden_field_tag :manager_id, manager_id
                - if params[:week_start].present?
                  = hidden_field_tag :week_start, params[:week_start]
                = hidden_field_tag :intent, "restore_suggested"
                %button.btn.btn-sm.btn-outline-secondary{type: "submit"}
                  Made changes you want to undo? Restore suggested
              - if og_consulted_body.present?
                = form_with url: consult_path, method: :post, local: true, data: { turbo: false }, html: { class: "d-inline" } do
                  = hidden_field_tag :manager_id, manager_id
                  - if params[:week_start].present?
                    = hidden_field_tag :week_start, params[:week_start]
                  = hidden_field_tag :intent, "restore_consultation"
                  %button.btn.btn-sm.btn-outline-secondary{type: "submit"}
                    Made changes you want to undo? Restore consultation
                = form_with url: consult_path, method: :post, local: true, data: { turbo: false }, html: { class: "d-inline" } do
                  = hidden_field_tag :manager_id, manager_id
                  - if params[:week_start].present?
                    = hidden_field_tag :week_start, params[:week_start]
                  %button.btn.btn-link.btn-sm.text-muted.text-decoration-underline.p-0{type: "submit", disabled: inflight}
                    %i.bi.bi-stars.me-1
                    = inflight ? "Consult OG running…" : "Consult OG again"
              - else
                = form_with url: consult_path, method: :post, local: true, data: { turbo: false }, html: { class: "d-inline" } do
                  = hidden_field_tag :manager_id, manager_id
                  - if params[:week_start].present?
                    = hidden_field_tag :week_start, params[:week_start]
                  %button.btn.btn-sm.btn-outline-primary{type: "submit", disabled: inflight}
                    %i.bi.bi-stars.me-1
                    = inflight ? "Consult OG running…" : "Consult OG"
          - if inflight && consult_status_path.present?
            = render "shared/og_consultations/status_banner",
                     status_url: "#{consult_status_path}?manager_id=#{ERB::Util.url_encode(manager_id)}",
                     label: "Overall Health Consult OG",
                     initial_status: consultation.status
          - elsif consultation&.status == "failed"
            %p.small.text-danger.mb-0
              %i.bi.bi-stars.me-1
              Consult OG failed: #{consultation.error_message.presence || "unknown error"}

        .mb-3
          = form_with url: nudge_path, method: :post, local: true, data: { turbo: false }, html: { class: "mb-0" } do
            = hidden_field_tag :manager_id, manager_id
            - if params[:week_start].present?
              = hidden_field_tag :week_start, params[:week_start]
            = hidden_field_tag :body, draft_text, data: { protect_flow_nudge_draft_target: "hiddenBody" }
            .btn-group.flex-wrap{role: "group", "aria-label" => "Send #{label} nudge"}
              %button.btn.btn-primary{type: "submit", name: "recipient_scope", value: "manager", disabled: !can_send_manager, title: manager_disabled_reason}
                %i.bi.bi-send.me-1
                = manager_only_label
              %button.btn.btn-outline-secondary{type: "submit", name: "recipient_scope", value: "manager_and_skip", disabled: !can_send_manager_and_skip, title: skip_disabled_reason}
                %i.bi.bi-send.me-1
                = manager_and_skip_label
          - if skip_level.blank?
            %p.small.text-muted.mb-0.mt-2 Unavailable — this manager has no manager on file for the second send option.
    - else
      .mb-3
        %label.form-label.fw-semibold.small.text-muted.mb-1 Message preview
        .border.rounded.bg-light.p-3.small{style: "white-space: pre-wrap;"}= message.preview_plain

      .mb-3
        = form_with url: nudge_path, method: :post, local: true, data: { turbo: false }, html: { class: "mb-0" } do
          = hidden_field_tag :manager_id, manager_id
          - if params[:week_start].present?
            = hidden_field_tag :week_start, params[:week_start]
          .btn-group.flex-wrap{role: "group", "aria-label" => "Send #{label} nudge"}
            %button.btn.btn-primary{type: "submit", name: "recipient_scope", value: "manager", disabled: !can_send_manager, title: manager_disabled_reason}
              %i.bi.bi-send.me-1
              = manager_only_label
            %button.btn.btn-outline-secondary{type: "submit", name: "recipient_scope", value: "manager_and_skip", disabled: !can_send_manager_and_skip, title: skip_disabled_reason}
              %i.bi.bi-send.me-1
              = manager_and_skip_label
        - if skip_level.blank?
          %p.small.text-muted.mb-0.mt-2 Unavailable — this manager has no manager on file for the second send option.

    %div
      %label.form-label.fw-semibold.small.text-muted.mb-1 History
      - if last_nudge.present?
        %p.small.mb-0
          Last nudge
          - if last_nudge.slack_url.present?
            = link_to "sent", last_nudge.slack_url, target: "_blank", rel: "noopener"
          - else
            sent
          #{time_ago_in_words(last_nudge.created_at)} ago
          by #{last_nudge.nudger_company_teammate&.person&.casual_name || "someone"}.
          - recipient_ids = Array(last_nudge.metadata&.dig("recipient_company_teammate_ids"))
          - if recipient_ids.any?
            - prior_recipients = CompanyTeammate.where(id: recipient_ids).includes(:person)
            %span.text-muted
              To #{prior_recipients.filter_map { |tm| tm.person&.display_name }.to_sentence}.
          - source = last_nudge.metadata&.dig("body_source")
          - if source.present?
            %span.text-muted
              · source: #{source.tr('_', ' ')}
      - else
        %p.small.text-muted.mb-0 No #{label} nudge has been sent for this manager yet.
