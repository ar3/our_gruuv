-# locals: label, collapse_id, nudge_path, manager, skip_level, recipients_manager, recipients_manager_and_skip,
-#         message, last_nudge, manager_id
- can_send_manager = health_nudge_can_send?(recipients_manager)
- can_send_manager_and_skip = skip_level.present? && health_nudge_can_send?(recipients_manager_and_skip)
- manager_disabled_reason = health_nudge_send_disabled_reason(recipients_manager, viewer: current_company_teammate)
- skip_disabled_reason = health_nudge_send_disabled_reason(recipients_manager_and_skip, viewer: current_company_teammate, skip_required: true, skip_level: skip_level)
- manager_only_label = health_nudge_manager_only_button_label(manager)
- manager_and_skip_label = health_nudge_manager_and_skip_button_label(manager, skip_level)

.collapse{id: collapse_id}
  .health-dashboard-nudge-panel
    .mb-3
      %label.form-label.fw-semibold.small.text-muted.mb-1 Message preview
      .border.rounded.bg-light.p-3.small{style: "white-space: pre-wrap;"}= message.preview_plain

    .mb-3
      = form_with url: nudge_path, method: :post, local: true, data: { turbo: false }, html: { class: "mb-0" } do
        = hidden_field_tag :manager_id, manager_id
        - if params[:week_start].present?
          = hidden_field_tag :week_start, params[:week_start]
        .btn-group.flex-wrap{role: "group", "aria-label" => "Send #{label} nudge"}
          %button.btn.btn-primary{type: "submit", name: "recipient_scope", value: "manager", disabled: !can_send_manager, title: manager_disabled_reason}
            %i.bi.bi-send.me-1
            = manager_only_label
          %button.btn.btn-outline-secondary{type: "submit", name: "recipient_scope", value: "manager_and_skip", disabled: !can_send_manager_and_skip, title: skip_disabled_reason}
            %i.bi.bi-send.me-1
            = manager_and_skip_label
      - if skip_level.blank?
        %p.small.text-muted.mb-0.mt-2 Unavailable — this manager has no manager on file for the second send option.

    %div
      %label.form-label.fw-semibold.small.text-muted.mb-1 History
      - if last_nudge.present?
        %p.small.mb-0
          Last nudge
          - if last_nudge.slack_url.present?
            = link_to "sent", last_nudge.slack_url, target: "_blank", rel: "noopener"
          - else
            sent
          #{time_ago_in_words(last_nudge.created_at)} ago
          by #{last_nudge.nudger_company_teammate&.person&.casual_name || "someone"}.
          - recipient_ids = Array(last_nudge.metadata&.dig("recipient_company_teammate_ids"))
          - if recipient_ids.any?
            - prior_recipients = CompanyTeammate.where(id: recipient_ids).includes(:person)
            %span.text-muted
              To #{prior_recipients.filter_map { |tm| tm.person&.display_name }.to_sentence}.
      - else
        %p.small.text-muted.mb-0 No #{label} nudge has been sent for this manager yet.
